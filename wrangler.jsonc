{
	// Cloudflare Workers static-assets deploy for the built Astro site.
	// Build: npm run build  ·  Deploy: npx wrangler deploy
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "creators",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	// Attaches the domain on deploy (the zone is on this Cloudflare account).
	"routes": [{ "pattern": "creators.select", "custom_domain": true }],
	"observability": { "enabled": true },
	// Branch builds run `wrangler preview`, which needs this block (it can stay empty).
	"previews": {}
}
