---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/syne';
import '../styles/tokens.css';
import '../styles/sections.css';
import '../styles/widgets.css';
import SiteNav from '../components/SiteNav.astro';
import GuidesIndex from '../components/GuidesIndex.astro';
import TabBar from '../components/TabBar.astro';
import Seal3D from '../components/Seal3D.astro';
import lockup from '../assets/logo-lockup.svg';
import { SITE_NAME, SITE_DESCRIPTION, REPO_URL } from '../site.mjs';
import { getCollection } from 'astro:content';
import { topicIcons } from '../data/topic-icons';
import { SECTION_LABELS } from '../lib/share';

// Six guides people ask about most, shown as covers under the search.
const docs = await getCollection('docs');
const chat = 'M4 5h16v11H8l-4 4zM8 9h8M8 12h5';
const picks = [
	['algorithms/how-recommenders-work', topicIcons.algorithms],
	['deals/pricing', topicIcons.earn],
	['deals/negotiation', chat],
	['paywall/compare', topicIcons.paywall],
	['money/set-aside', topicIcons.money],
	['protect/hacked', topicIcons.protect],
]
	.map(([id, icon]) => ({ e: docs.find((d) => d.id === id), icon }))
	.flatMap(({ e, icon }) => (e ? [{ e, icon }] : []))
	.map(({ e, icon }) => {
		const section = e.id.split('/')[0];
		return { icon, href: `/${e.id}/`, section, label: SECTION_LABELS[section] ?? section, title: e.data.title, text: e.data.description ?? '' };
	});
const guideCount = docs.filter((e) => e.id.includes('/') && !e.id.endsWith('/index') && !e.id.startsWith('about/')).length;

// Structured data so search engines show the site name, logo and search box.
const homeJsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': 'https://creators.select/#site',
			name: SITE_NAME,
			url: 'https://creators.select/',
			description: SITE_DESCRIPTION,
			publisher: { '@id': 'https://creators.select/#org' },
			potentialAction: {
				'@type': 'SearchAction',
				target: 'https://creators.select/guides/?q={query}',
				'query-input': 'required name=query',
			},
		},
		{
			'@type': 'Organization',
			'@id': 'https://creators.select/#org',
			name: SITE_NAME,
			url: 'https://creators.select/',
			logo: 'https://creators.select/apple-touch-icon.png',
			sameAs: ['https://www.instagram.com/selectcreators/', REPO_URL],
		},
	],
};

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{SITE_NAME}: the creator playbook, minus the gurus</title>
		<meta name="description" content={SITE_DESCRIPTION} />
		<meta name="theme-color" content="#050505" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:title" content={SITE_NAME} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://creators.select/" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:image" content="https://creators.select/og/home.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content="https://creators.select/og/home.png" />
		<link rel="canonical" href="https://creators.select/" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<div class="bg" aria-hidden="true"></div>

		<header class="site-header">
			<SiteNav>
				<a slot="search" class="search-pill" href="/guides/?focus=1">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4"></path></svg>
					<span>Search guides</span>
				</a>
			</SiteNav>
		</header>

		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">Free, by creators, for creators</p>
					<h1>The creator playbook,<br /><span>minus the gurus.</span></h1>
					<p class="lead">
						How the algorithm really picks what gets seen, what a brand deal should pay, and how to run the business side.
						Every claim sourced, every affiliate link labeled, free forever.
					</p>
					<ul class="facts" aria-label="At a glance">
						<li><strong>{guideCount}</strong> guides</li>
						<li><strong>7</strong> platforms</li>
						<li>Every claim sourced</li>
					</ul>
				</div>
				<div class="hero-3d">
					<Seal3D />
				</div>
			</section>

			<section class="find" aria-label="Find a guide">
				<GuidesIndex />
			</section>

			<section class="start" aria-labelledby="start-h">
				<h2 id="start-h">Popular guides</h2>
				<ul>
					{
						picks.map((g) => (
							<li>
								<a href={g.href} data-section={g.section}>
									<span class="cover" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d={g.icon} />
										</svg>
									</span>
									<span class="sec">{g.label}</span>
									<strong>{g.title}</strong>
									<span class="txt">{g.text}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="trust" aria-labelledby="trust-h">
				<h2 id="trust-h">Free, and honest about it.</h2>
				<ul>
					<li>
						<strong>Affiliate links are labeled</strong>
						<span>Right where they appear, never hidden in a footer.</span>
					</li>
					<li>
						<strong>A free option, every time</strong>
						<span>Every tool pick names a free or non-affiliate alternative.</span>
					</li>
					<li>
						<strong>Who is behind it</strong>
						<span>The team behind this site is building a talent agency. We say so up front.</span>
					</li>
				</ul>
				<p class="trust-links">
					<a href="/about/how-we-make-money/">How we make money</a>
					<a href="/about/contribute/">Contribute on GitHub</a>
				</p>
			</section>
		</main>

		<footer class="foot">
			<img class="lockup" src={lockup.src} width="160" height="24" alt={SITE_NAME} />
			<nav aria-label="Footer">
				<a href="/about/">About</a>
				<a href="/about/editorial-standards/">Editorial standards</a>
				<a href="/about/corrections/">Corrections</a>
				<a href={REPO_URL}>GitHub</a>
				<a href="https://www.instagram.com/selectcreators/">Instagram</a>
			</nav>
			<p>Educational information, not legal or financial advice.</p>
		</footer>
		<TabBar variant="landing" />
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		background: var(--sc-obsidian);
		color: var(--sc-platinum);
		font-family: var(--sc-font-sans);
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
	html,
	body {
		overflow-x: clip;
	}
	body {
		margin: 0;
	}
	a {
		color: inherit;
	}
	::selection {
		background: rgb(255 255 255 / 0.85);
		color: #050505;
	}
</style>

<style>
	/* A still glow, no motion. */
	.bg {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		background:
			radial-gradient(70vmax 50vmax at 10% -20%, rgb(255 134 184 / 0.10), transparent 60%),
			radial-gradient(70vmax 50vmax at 95% -15%, rgb(195 166 255 / 0.11), transparent 60%);
	}

	.site-header {
		position: sticky;
		top: 0;
		z-index: 30;
		height: 4rem;
		padding: 0 clamp(1rem, 3vw, 1.5rem);
		background: rgb(8 7 10 / 0.92);
		border-bottom: 1px solid var(--sc-line);
	}
	@media (hover: hover) and (pointer: fine) {
		.site-header {
			background: rgb(8 7 10 / 0.72);
			backdrop-filter: blur(14px);
			-webkit-backdrop-filter: blur(14px);
		}
	}
	.search-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		height: 2.25rem;
		padding: 0 0.9rem;
		border: 1px solid var(--sc-line-strong);
		border-radius: 999px;
		color: var(--sc-silver);
		font-size: 0.88rem;
		text-decoration: none;
		transition: color 0.15s, border-color 0.15s;
	}
	.search-pill:hover {
		color: var(--sc-ivory);
		border-color: var(--sc-line-bright);
	}
	.search-pill svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	@media (max-width: 40rem) {
		.search-pill span {
			display: none;
		}
		.search-pill {
			width: 2.25rem;
			padding: 0;
			justify-content: center;
		}
	}

	main {
		width: min(100%, 64rem);
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 2rem);
	}

	.hero {
		display: grid;
		align-items: center;
		gap: 0.5rem;
		padding: clamp(1.75rem, 5vw, 4rem) 0 1.25rem;
	}
	.eyebrow {
		margin: 0 0 1rem;
		color: var(--sc-silver);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}
	h1 {
		margin: 0;
		font-family: var(--sc-font-display);
		font-size: clamp(2.2rem, 5.2vw, 3.5rem);
		line-height: 1.02;
		letter-spacing: -0.03em;
		font-weight: 700;
		color: var(--sc-ivory);
	}
	h1 span {
		background: linear-gradient(90deg, var(--sc-rose, #ff86b8), var(--sc-ion, #c3a6ff));
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}
	.lead {
		max-width: 36rem;
		margin: 1.25rem 0 0;
		color: var(--sc-silver);
		font-size: clamp(1rem, 1.6vw, 1.12rem);
		line-height: 1.6;
	}
	.hero-3d {
		justify-self: center;
		width: min(100%, 22rem);
		aspect-ratio: 1;
	}
	@media (max-width: 47.99rem) {
		.hero-3d {
			order: -1;
			justify-self: start;
			width: 7.5rem;
			margin: -0.5rem 0 0 -0.75rem;
		}
	}
	@media (min-width: 48rem) {
		.hero {
			grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
			gap: 2rem;
		}
	}


	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.5rem 0 0;
		padding: 0;
		list-style: none;
	}
	.facts li {
		padding: 0.35rem 0.8rem;
		border: 1px solid var(--sc-line);
		border-radius: 999px;
		background: rgb(255 255 255 / 0.03);
		color: var(--sc-silver);
		font-size: 0.82rem;
	}
	.facts strong {
		color: var(--sc-ivory);
		font-weight: 600;
	}

	/* Start here: six guide covers. A tinted plate with the section's icon. */
	.start {
		padding: 0 0 3rem;
	}
	.start h2,
	.find :global(.gi h2) {
		margin: 0 0 1rem;
		font-family: var(--sc-font-display);
		font-size: 1.2rem;
		font-weight: 700;
		color: var(--sc-ivory);
	}
	.start ul {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.start a {
		display: grid;
		align-content: start;
		gap: 0.35rem;
		height: 100%;
		padding: 0.75rem 0.75rem 1.1rem;
		border: 1px solid var(--sc-line);
		border-radius: 18px;
		background: rgb(255 255 255 / 0.02);
		text-decoration: none;
		transition: border-color 0.2s, transform 0.2s, background-color 0.2s;
	}
	.start a:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, transparent);
		background: color-mix(in srgb, var(--accent) 5%, transparent);
		transform: translateY(-2px);
	}
	.cover {
		display: grid;
		place-items: center;
		aspect-ratio: 16 / 8;
		margin-bottom: 0.6rem;
		border-radius: 12px;
		color: color-mix(in srgb, var(--accent) 80%, #fff);
		background:
			radial-gradient(120% 90% at 20% 10%, color-mix(in srgb, var(--accent) 38%, transparent), transparent 60%),
			radial-gradient(90% 80% at 100% 100%, color-mix(in srgb, var(--accent) 18%, transparent), transparent 70%),
			#111014;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 20%, transparent);
	}
	.cover svg {
		width: 2.4rem;
		height: 2.4rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.start .sec {
		padding-inline: 0.25rem;
		color: var(--accent);
		font-size: 0.75rem;
		font-weight: 600;
	}
	.start strong {
		padding-inline: 0.25rem;
		color: var(--sc-ivory);
		font-size: 1.02rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.start .txt {
		padding-inline: 0.25rem;
		color: var(--sc-silver);
		font-size: 0.86rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 47.99rem) {
		.start ul {
			grid-template-columns: none;
			grid-auto-flow: column;
			grid-auto-columns: 78%;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scrollbar-width: none;
			margin-inline: calc(-1 * clamp(1rem, 4vw, 2rem));
			padding-inline: clamp(1rem, 4vw, 2rem);
			scroll-padding-inline: clamp(1rem, 4vw, 2rem);
		}
		.start ul::-webkit-scrollbar {
			display: none;
		}
		.start li {
			scroll-snap-align: start;
		}
	}
	.find {
		padding: 1rem 0 2.5rem;
	}

	.trust {
		padding: 2.5rem 0 3rem;
		border-top: 1px solid var(--sc-line);
	}
	.trust h2 {
		margin: 0 0 1.25rem;
		font-family: var(--sc-font-display);
		font-size: 1.35rem;
		letter-spacing: -0.02em;
		color: var(--sc-ivory);
	}
	.trust ul {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 48rem) {
		.trust ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 2rem;
		}
	}
	.trust li {
		display: grid;
		gap: 0.3rem;
	}
	.trust strong {
		color: var(--sc-ivory);
		font-weight: 600;
		font-size: 0.98rem;
	}
	.trust li span {
		color: var(--sc-silver);
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.trust-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 1.5rem 0 0;
		font-size: 0.92rem;
	}
	.trust-links a {
		color: var(--sc-ivory);
		text-decoration: underline;
		text-decoration-color: var(--sc-line-strong);
		text-underline-offset: 4px;
	}
	.trust-links a:hover {
		text-decoration-color: var(--sc-ion);
	}

	.foot {
		display: grid;
		gap: 1rem;
		justify-items: start;
		width: min(100%, 64rem);
		margin: 0 auto;
		padding: 2rem clamp(1rem, 4vw, 2rem) 2.5rem;
		border-top: 1px solid var(--sc-line);
		color: var(--sc-silver);
		font-size: 0.85rem;
	}
	.foot .lockup {
		height: 22px;
		width: auto;
	}
	.foot nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
	}
	.foot a {
		text-decoration: none;
	}
	.foot a:hover {
		color: var(--sc-ivory);
	}
	.foot p {
		margin: 0;
		color: var(--sc-steel, #8f8e94);
	}
</style>
