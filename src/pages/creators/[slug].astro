---
/**
 * One creator: their advice, the software and gear they use, their case study
 * and the best outside resources about them. Every item links to its source.
 */
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CreatorCard from '../../components/CreatorCard.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import TikTokEmbed from '../../components/TikTokEmbed.astro';
import { loadDirectory, NICHES, NICHE_TINT, PLATFORMS, initials, creatorPath, type DirectoryEntry } from '../../lib/creators';
import { SITE_NAME } from '../../site.mjs';
import { getCollection } from 'astro:content';
import { directoryTools, findDirectoryTool, toolPath } from '../../lib/tool-directory';

export const getStaticPaths = (async () => {
	const all = await loadDirectory();
	return all.map((c) => ({ params: { slug: c.id }, props: { c, all } }));
}) satisfies GetStaticPaths;

const { c, all } = Astro.props as { c: DirectoryEntry; all: DirectoryEntry[] };

const GEAR = [
	['camera', 'Camera'],
	['lens', 'Lenses'],
	['audio', 'Audio'],
	['lighting', 'Lighting'],
	['editing', 'Editing'],
	['support', 'Support and storage'],
] as const;

// Link each app to its tool directory page when we list it.
const dirTools = directoryTools(await getCollection('tools'));
const tools = c.tools.map((t) => ({ ...t, dir: findDirectoryTool(t.name, dirTools) }));

const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const similar = all
	.filter((o) => o.id !== c.id)
	.map((o) => ({ o, score: (o.niche === c.niche ? 3 : 0) + o.platforms.filter((p) => c.platforms.includes(p)).length }))
	.sort((a, b) => b.score - a.score)
	.slice(0, 4)
	.map((x) => x.o);

// Every source on the page, once.
const sources = new Map<string, string>();
for (const a of c.advice) sources.set(a.source, a.sourceTitle);
for (const t of c.tools) sources.set(t.source, t.sourceTitle);
for (const s of c.setups) sources.set(s.source, s.sourceTitle);

const yt = c.videos.filter((v) => v.platform === 'youtube');
const tt = c.videos.filter((v) => v.platform === 'tiktok');

const what = [c.advice.length && 'advice', c.tools.length && 'software', c.gearCount && 'gear'].filter(Boolean) as string[];
const whatText = what.length > 1 ? `${what.slice(0, -1).join(', ')} and ${what.at(-1)}` : (what[0] ?? 'profile');
const title = `${c.name}: ${whatText}`;
const description = c.about;

const ld = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	name: `${c.name} on ${SITE_NAME}`,
	url: new URL(creatorPath(c.id), Astro.site).href,
	mainEntity: { '@type': 'Person', name: c.name, description: c.known, ...(c.site ? { url: c.site, sameAs: [c.site] } : {}) },
};
---

<StarlightPage
	frontmatter={{
		title: c.name,
		description,
		head: [
			{ tag: 'title', content: `${title} | ${SITE_NAME}` },
			{ tag: 'script', attrs: { type: 'application/ld+json' }, content: JSON.stringify(ld) },
		],
		tableOfContents: false,
		prev: false,
		next: false,
		editUrl: false,
		status: 'draft',
		confidence: 'verified',
	}}
>
	<article class="cp not-content" data-section={NICHE_TINT[c.niche]}>
		<p class="cp-crumbs">
			<a href="/creators/">Creator directory</a>
			<span aria-hidden="true">/</span>
			<a href={`/creators/?niche=${c.niche}`}>{NICHES[c.niche]}</a>
		</p>

		<header class="cp-hero">
			<span class="cp-mono" aria-hidden="true" data-morph-target>{initials(c.name)}</span>
			<div>
				<p class="cp-known">{c.known}</p>
				<p class="cp-plats">
					{c.platforms.map((p) => <span>{PLATFORMS[p]}</span>)}
					{c.site && (
						<a href={c.site} target="_blank" rel="noopener">
							{host(c.site)} ↗
						</a>
					)}
				</p>
			</div>
		</header>

		<nav class="cp-jump" aria-label="On this page">
			{c.videos.length > 0 && <a href="#watch">Watch <span>{c.videos.length}</span></a>}
			{c.advice.length > 0 && <a href="#advice">Advice <span>{c.advice.length}</span></a>}
			{c.tools.length > 0 && <a href="#software">Software <span>{c.tools.length}</span></a>}
			{c.gearCount > 0 && <a href="#gear">Gear <span>{c.gearCount}</span></a>}
			{c.caseStudy && <a href="#story">Case study</a>}
			{c.resources.length > 0 && <a href="#learn">Learn more <span>{c.resources.length}</span></a>}
		</nav>

		{
			c.videos.length > 0 && (
				<section id="watch" aria-labelledby="h-watch">
					<h2 id="h-watch">Watch</h2>
					{tt.length > 0 && (
						<div class="tt-row">
							{tt.map((v) => (
								<TikTokEmbed id={v.id} handle={v.handle} title={v.title} date={v.date} stat={v.stat} caption={v.why} />
							))}
						</div>
					)}
					{yt.map((v) => (
						<YouTubeEmbed id={v.id} title={v.title} caption={`${v.why} ${v.channel}, ${v.date}.`} />
					))}
					<p class="cp-more">Videos load only when you tap play.</p>
				</section>
			)
		}

		{
			c.advice.length > 0 && (
				<section id="advice" aria-labelledby="h-advice">
					<h2 id="h-advice">What they'd tell you</h2>
					<div class="cp-quotes">
						{c.advice.map((a) => (
							<figure class={a.quote ? 'is-quote' : 'is-summary'}>
								<span class="cp-kind">{a.quote ? 'In their words' : 'Our summary'}</span>
								<blockquote>{a.quote ? <>“{a.text}”</> : a.text}</blockquote>
								<figcaption>
									<a href={a.source} target="_blank" rel="noopener">
										{a.sourceTitle}
									</a>
									<span> · {a.date}</span>
								</figcaption>
							</figure>
						))}
					</div>
				</section>
			)
		}

		{
			c.tools.length > 0 && (
				<section id="software" aria-labelledby="h-software">
					<h2 id="h-software">Software and apps</h2>
					<ul class="cp-tools">
						{tools.map((t) => (
							<li>
								<span class="cp-tool-mono" aria-hidden="true">{t.name[0]}</span>
								<span class="cp-tool-body">
									<strong>{t.dir ? <a class="cp-tool-dir" href={toolPath(t.dir.slug)}>{t.name}</a> : t.name}</strong>
									<span>{t.use}</span>
								</span>
								<a href={t.source} target="_blank" rel="noopener" aria-label={`Source: ${t.sourceTitle}`}>
									{t.date} ↗
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		{
			c.setups.length > 0 && (
				<section id="gear" aria-labelledby="h-gear">
					<h2 id="h-gear">Gear</h2>
					{c.setups.map((s) => (
						<div class="cp-setup">
							<p class="cp-setup-head">
								<span>{s.asOf}</span>
								{s.cost && <span>{s.cost} setup, their figure</span>}
							</p>
							<dl>
								{GEAR.filter(([k]) => s.gear[k].length).map(([k, label]) => (
									<div>
										<dt>{label}</dt>
										<dd>
											{s.gear[k].map((g) => (
												<span>{g}</span>
											))}
										</dd>
									</div>
								))}
							</dl>
							{s.note && <p class="cp-note">{s.note}</p>}
							<a class="cp-src" href={s.source} target="_blank" rel="noopener">
								{s.from === 'video' ? 'From their video' : 'From their page'} “{s.sourceTitle}” ↗
							</a>
						</div>
					))}
					<p class="cp-more">
						Compare with other creators on the <a href="/stack/#what-creators-actually-use">Stack page</a>.
					</p>
				</section>
			)
		}

		{
			c.caseStudy && (
				<section id="story" aria-labelledby="h-story">
					<h2 id="h-story">The full story</h2>
					<a class="cp-case" href={`/${c.caseStudy}/`}>
						<span>Case study</span>
						<strong>{c.caseStudyTitle}</strong>
						<em>Read it →</em>
					</a>
				</section>
			)
		}

		{
			c.resources.length > 0 && (
				<section id="learn" aria-labelledby="h-learn">
					<h2 id="h-learn">Learn more</h2>
					<ul class="cp-res">
						{c.resources.map((r) => (
							<li>
								<a href={r.url} target={r.url.startsWith('/') ? undefined : '_blank'} rel={r.url.startsWith('/') ? undefined : 'noopener'}>
									<strong>{r.name}</strong>
									{r.by && <span class="by">By {r.by}</span>}
									<span>{r.why}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section aria-labelledby="h-similar">
			<h2 id="h-similar">Creators like {c.name.split(' (')[0]}</h2>
			<div class="cp-similar">{similar.map((o) => <CreatorCard c={o} />)}</div>
		</section>

		<section class="cp-sources" aria-labelledby="h-sources">
			<h2 id="h-sources">Sources</h2>
			<ul>
				{[...sources].map(([u, t]) => (
					<li>
						<a href={u} target="_blank" rel="noopener">
							{t}
						</a>{' '}
						<span>({host(u)})</span>
					</li>
				))}
			</ul>
			<p>Something out of date? Edit <code>src/data/creators/{c.id}.yaml</code> on GitHub.</p>
		</section>
	</article>
</StarlightPage>

<style>
	.cp {
		max-width: 48rem;
	}
	.cp section {
		margin-top: 2.25rem;
	}
	.cp h2 {
		margin: 0 0 0.85rem;
		font: 600 var(--sc-text-xl) / 1.2 var(--sc-font-display);
		color: var(--sc-ivory);
	}
	.cp-crumbs {
		display: flex;
		gap: 0.5rem;
		margin: 0 0 1rem;
		font-size: var(--sc-text-sm);
		color: var(--sc-steel);
	}
	.cp-crumbs a {
		color: var(--sc-silver);
		text-decoration: none;
	}
	.cp-crumbs a:hover {
		color: var(--sc-ivory);
	}
	.cp-hero {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: center;
	}
	.cp-mono {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 999px;
		background: linear-gradient(140deg, var(--accent), color-mix(in srgb, var(--accent) 35%, var(--sc-obsidian)));
		color: var(--sc-obsidian);
		font: 700 1.5rem / 1 var(--sc-font-display);
		box-shadow: 0 10px 40px -14px var(--accent);
	}
	.cp-known {
		margin: 0;
		font-size: var(--sc-text-lg);
		line-height: 1.4;
		color: var(--sc-ivory);
	}
	.cp-plats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0.5rem 0 0;
	}
	.cp-plats span,
	.cp-plats a {
		font-size: var(--sc-text-xs);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		color: var(--sc-silver);
		text-decoration: none;
	}
	.cp-plats a {
		color: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
	}
	.cp-about {
		margin: 1.1rem 0 0;
		line-height: 1.6;
		color: var(--sc-silver);
	}
	.cp-jump {
		position: sticky;
		top: calc(var(--sl-nav-height, 4rem) + 0.25rem);
		z-index: 2;
		display: flex;
		gap: 0.4rem;
		overflow-x: auto;
		scrollbar-width: none;
		margin: 1.4rem -1rem 0;
		padding: 0.5rem 1rem;
		background: color-mix(in srgb, var(--sc-obsidian) 85%, transparent);
		backdrop-filter: blur(10px);
	}
	.cp-jump a {
		flex: none;
		font-size: var(--sc-text-sm);
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		color: var(--sc-ivory);
		text-decoration: none;
	}
	.cp-jump a span {
		color: var(--sc-steel);
		margin-left: 0.15rem;
	}
	.cp section[id] {
		scroll-margin-top: 8rem;
	}
	.cp-quotes {
		display: grid;
		gap: 0.75rem;
	}
	@media (min-width: 44rem) {
		.cp-quotes {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.cp-quotes figure {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.1rem;
		border-radius: 18px;
		border: 1px solid var(--sc-line);
		background: var(--sc-fill-subtle);
	}
	.cp-quotes .is-quote {
		background:
			radial-gradient(100% 70% at 0% 0%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
			var(--sc-fill-subtle);
	}
	.cp-kind {
		font-size: var(--sc-text-xs);
		color: var(--accent);
	}
	.is-summary .cp-kind {
		color: var(--sc-steel);
	}
	.cp-quotes blockquote {
		margin: 0;
		padding: 0;
		border: 0;
		font-size: 1.05rem;
		line-height: 1.5;
		color: var(--sc-ivory);
	}
	.is-quote blockquote {
		font-family: var(--sc-font-display);
		font-size: 1.15rem;
	}
	.cp-quotes figcaption {
		margin-top: auto;
		font-size: var(--sc-text-xs);
		color: var(--sc-steel);
	}
	.cp-quotes figcaption a,
	.cp-src,
	.cp-more a,
	.cp-sources a {
		color: var(--sc-silver);
		text-underline-offset: 3px;
	}
	.cp-tools {
		list-style: none;
		margin: 0;
		padding: 0;
		border-radius: 18px;
		border: 1px solid var(--sc-line);
		overflow: hidden;
	}
	.cp-tools li {
		display: grid;
		grid-template-columns: 2.25rem 1fr auto;
		gap: 0.75rem;
		align-items: center;
		padding: 0.8rem 1rem;
	}
	.cp-tools li + li {
		border-top: 1px solid var(--sc-line);
	}
	.cp-tool-mono {
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 10px;
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		color: var(--accent);
		font: 700 0.95rem / 1 var(--sc-font-display);
	}
	.cp-tool-body {
		display: grid;
		min-width: 0;
	}
	.cp-tool-body strong {
		color: var(--sc-ivory);
		font-weight: 600;
	}
	.cp-tool-body span {
		font-size: var(--sc-text-sm);
		color: var(--sc-silver);
	}
	.cp-tools a {
		font-size: var(--sc-text-xs);
		color: var(--sc-steel);
		white-space: nowrap;
		text-decoration: none;
	}
	.cp-tools a.cp-tool-dir {
		font-size: inherit;
		color: inherit;
		white-space: normal;
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, currentColor 35%, transparent);
		text-underline-offset: 0.2em;
	}
	.cp-tools a.cp-tool-dir:hover {
		color: var(--accent);
	}
	.cp-setup {
		padding: 1.1rem;
		border-radius: 18px;
		border: 1px solid var(--sc-line);
		background: var(--sc-fill-subtle);
	}
	.cp-setup + .cp-setup {
		margin-top: 0.75rem;
	}
	.cp-setup-head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 0.8rem;
	}
	.cp-setup-head span {
		font-size: var(--sc-text-xs);
		padding: 0.15rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		color: var(--sc-silver);
	}
	.cp-setup dl {
		display: grid;
		gap: 0.65rem;
		margin: 0;
	}
	.cp-setup dt {
		font-size: var(--sc-text-xs);
		color: var(--sc-steel);
		margin-bottom: 0.3rem;
	}
	.cp-setup dd {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		margin: 0;
	}
	.cp-setup dd span {
		font-size: var(--sc-text-sm);
		padding: 0.2rem 0.6rem;
		border-radius: 8px;
		background: rgb(255 255 255 / 0.05);
		color: var(--sc-ivory);
	}
	.cp-note {
		margin: 0.85rem 0 0;
		font-size: var(--sc-text-sm);
		color: var(--sc-silver);
	}
	.cp-src {
		display: inline-block;
		margin-top: 0.85rem;
		font-size: var(--sc-text-xs);
	}
	.cp-more {
		font-size: var(--sc-text-sm);
		color: var(--sc-steel);
	}
	.cp-case {
		display: grid;
		gap: 0.3rem;
		padding: 1.2rem;
		border-radius: 18px;
		border: 1px solid color-mix(in srgb, var(--accent) 40%, var(--sc-line));
		background: radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%), var(--sc-fill-subtle);
		text-decoration: none;
	}
	.cp-case span {
		font-size: var(--sc-text-xs);
		color: var(--accent);
	}
	.cp-case strong {
		font: 600 1.2rem / 1.3 var(--sc-font-display);
		color: var(--sc-ivory);
	}
	.cp-case em {
		font-style: normal;
		font-size: var(--sc-text-sm);
		color: var(--sc-silver);
	}
	.cp-res {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	.cp-res a {
		display: grid;
		gap: 0.25rem;
		padding: 0.95rem 1.1rem;
		border-radius: 16px;
		border: 1px solid var(--sc-line);
		text-decoration: none;
	}
	.cp-res a:hover {
		border-color: var(--sc-line-bright);
	}
	.cp-res strong {
		color: var(--sc-ivory);
	}
	.cp-res .by {
		font-size: var(--sc-text-xs);
		color: var(--accent);
	}
	.cp-res span {
		font-size: var(--sc-text-sm);
		line-height: 1.5;
		color: var(--sc-silver);
	}
	.cp-similar {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
	}
	@media (min-width: 44rem) {
		.cp-similar {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
	.cp-sources ul {
		margin: 0;
		padding-left: 1.1rem;
		font-size: var(--sc-text-sm);
		color: var(--sc-silver);
	}
	.cp-sources li + li {
		margin-top: 0.3rem;
	}
	.cp-sources li span {
		color: var(--sc-steel);
	}
	.cp-sources p {
		margin-top: 0.8rem;
		font-size: var(--sc-text-xs);
		color: var(--sc-steel);
	}
</style>
