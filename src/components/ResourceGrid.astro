---
/** Curated "shortlist" resources from src/data/resources/, grouped by kind. */
import { getCollection } from 'astro:content';
import Cover from './Cover.astro';

interface Props {
	kind?: string;
}
const { kind } = Astro.props;
const kindLabels: Record<string, string> = {
	official: 'Straight from the platform',
	playbook: 'Playbooks',
	hiring: 'Hire your team',
	code: 'Open source',
	tool: 'Tools',
	learning: 'Learn',
};
const resources = (await getCollection('resources'))
	.map((r) => r.data)
	.filter((r) => !kind || r.kind === kind)
	.sort((a, b) => Number(b.featured) - Number(a.featured) || a.name.localeCompare(b.name));
---

<div class="res-grid sc-rail not-content" data-rail>
	{
		resources.map((r) => (
			<a
				class="res"
				href={r.url}
				rel={r.url.startsWith('/') ? undefined : r.affiliate ? 'sponsored noopener' : 'noopener'}
				target={r.url.startsWith('/') ? undefined : '_blank'}
				data-section={r.tint}
			>
				<Cover title={r.name} section={r.tint} label={r.coverLabel ?? r.name} kicker={kindLabels[r.kind]} />
				<div class="body">
					<div class="meta">
						<span class="pill">{r.free ? 'Free' : 'Paid'}</span>
						{r.affiliate && <span class="pill brass">affiliate</span>}
						{r.featured && <span class="pill gold">Top pick</span>}
					</div>
					<h3>{r.name}</h3>
					<p>{r.why}</p>
					<span class="src">{r.url.startsWith('/') ? 'Read our guide →' : new URL(r.url).hostname.replace(/^www\./, '') + ' ↗'}</span>
				</div>
			</a>
		))
	}
</div>

<style>
	.res-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-block: 1.25rem 2rem;
	}
	@media (min-width: 40rem) {
		.res-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.res {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sc-line);
		border-radius: var(--sc-radius-lg);
		background: linear-gradient(180deg, rgb(255 255 255 / 0.03), rgb(255 255 255 / 0.01));
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition:
			border-color var(--sc-dur-quick),
			transform var(--sc-dur-base) var(--sc-ease-settle);
	}
	.res:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		transform: translateY(-3px);
	}
	.res :global(.cover) {
		border-radius: 0;
	}
	.body {
		padding: 1rem 1.1rem 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		flex: 1;
	}
	.meta {
		display: flex;
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.pill {
		padding: 0.05rem 0.5rem;
		border-radius: var(--sc-radius-pill);
		border: 1px solid var(--sc-line-strong);
		font-family: var(--sc-font-mono);
		font-size: var(--sc-text-2xs);
		letter-spacing: 0;
		color: var(--sc-silver);
	}
	.brass {
		color: var(--sc-brass);
		border-color: color-mix(in srgb, var(--sc-brass) 50%, transparent);
	}
	.gold {
		color: var(--sc-champagne);
		border-color: color-mix(in srgb, var(--sc-champagne) 50%, transparent);
	}
	h3 {
		margin: 0.2rem 0 0;
		font-size: var(--sc-text-lg);
		letter-spacing: -0.015em;
		color: var(--sc-ivory);
	}
	p {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--sc-silver);
		flex: 1;
	}
	.src {
		margin-top: 0.4rem;
		font-family: var(--sc-font-mono);
		font-size: var(--sc-text-xs);
		color: var(--accent);
	}
</style>

<script>
	import '../scripts/rail';
</script>
