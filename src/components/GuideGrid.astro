---
/** Grid of guide cards with generated covers for one section. */
import { getCollection } from 'astro:content';
import Cover from './Cover.astro';

interface Props {
	section: string;
	kicker?: string;
}
const { section, kicker } = Astro.props;
const entries = (await getCollection('docs'))
	.filter((e) => e.id.startsWith(section + '/') && e.id !== section + '/index' && e.id !== section)
	.sort((a, b) => (a.data.sidebar?.order ?? 99) - (b.data.sidebar?.order ?? 99));

const coverMeta = (e: (typeof entries)[number]) => {
	const d = e.data as typeof e.data & { cover?: { label?: string; tint?: string } };
	return { label: d.cover?.label, tint: d.cover?.tint ?? section };
};
const statusText: Record<string, string> = { outline: 'Outline', draft: 'Draft', published: 'Reviewed' };
---

<div class="guide-grid not-content">
	{
		entries.map((e) => {
			const m = coverMeta(e);
			const status = (e.data as { status?: string }).status;
			return (
				<a class="guide-card" href={`/${e.id}/`} data-section={m.tint}>
					<Cover title={e.data.title} section={m.tint} label={m.label} kicker={kicker} />
					<div class="body">
						<h3>{e.data.title}</h3>
						{e.data.description && <p>{e.data.description}</p>}
						{status && <span class={`status s-${status}`}>{statusText[status]}</span>}
					</div>
				</a>
			);
		})
	}
</div>

<style>
	.guide-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-block: 1.5rem 2rem;
	}
	@media (min-width: 40rem) {
		.guide-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.guide-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--sc-line);
		border-radius: var(--sc-radius-lg);
		background: linear-gradient(180deg, rgb(255 255 255 / 0.03), rgb(255 255 255 / 0.01));
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		transition:
			border-color var(--sc-dur-quick),
			transform var(--sc-dur-base) var(--sc-ease-settle);
	}
	.guide-card:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		transform: translateY(-3px);
	}
	.guide-card :global(.cover) {
		border-radius: 0;
	}
	.body {
		padding: 1rem 1.1rem 1.2rem;
	}
	h3 {
		margin: 0;
		font-size: var(--sc-text-lg);
		letter-spacing: -0.015em;
		color: var(--sc-ivory);
	}
	p {
		margin: 0.35rem 0 0;
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--sc-silver);
	}
	.status {
		display: inline-block;
		margin-top: 0.75rem;
		padding: 0.1rem 0.5rem;
		border-radius: var(--sc-radius-pill);
		border: 1px solid var(--sc-line-strong);
		font-family: var(--sc-font-mono);
		font-size: var(--sc-text-2xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sc-steel);
	}
	.s-draft {
		color: var(--accent);
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
	}
	.s-published {
		color: var(--sc-jade);
		border-color: color-mix(in srgb, var(--sc-jade) 45%, transparent);
	}
</style>
