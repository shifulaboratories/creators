---
/** Numbered source list for Paywall pages. Pass ids from src/lib/money-data.ts. */
import { sources } from '../../lib/paywall-data';
interface Props {
	ids: string[];
	title?: string;
}
const { ids, title = 'Sources' } = Astro.props;
const list = ids.map((id) => sources[id]).filter(Boolean);
---

<section class="ms not-content" aria-label={title}>
	<h2 class="ms-title">{title}</h2>
	<ol>
		{
			list.map((s) => (
				<li>
					<a href={s.url} rel="noopener">{s.name}</a>
					<span class="ms-meta">
						{s.publisher} · {s.date}
					</span>
					<span class="ms-method">{s.method}</span>
				</li>
			))
		}
	</ol>
</section>

<style>
	.ms {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sc-line);
	}
	.ms-title {
		font-family: var(--sc-font-display);
		font-size: 1.05rem;
		margin: 0 0 0.75rem;
		color: var(--sc-ivory);
	}
	.ms ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.6rem;
	}
	.ms li {
		font-size: 0.85rem;
		line-height: 1.45;
		color: var(--sc-silver);
	}
	.ms li::marker {
		color: var(--sc-steel);
	}
	.ms a {
		color: var(--sc-platinum);
		text-decoration-color: var(--sc-line-strong);
	}
	.ms-meta,
	.ms-method {
		display: block;
		font-size: 0.78rem;
		color: var(--sc-steel);
	}
</style>
