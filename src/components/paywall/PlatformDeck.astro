---
/**
 * Swipeable cards, one per fan platform: what you keep, content rules, payouts,
 * who it suits and the catch. Filter to safe-for-work only. Data: src/lib/paywall-data.ts.
 */
import { platforms as enPlatforms, CHECKED } from '../../lib/paywall-data';
import { currentLocale, t, localize } from '../../i18n';
import { platformText, localDate } from '../../i18n/paywall';
const locale = currentLocale(Astro);
const L = t(locale).paywall;
const badge = L.badge;
const platforms = enPlatforms.map((p) => ({ ...p, ...(locale === 'en' ? {} : platformText[locale][p.key]), href: localize(locale, p.href) }));
---

<div class="pd not-content" data-pd data-section="paywall">
	<div class="pd-bar" role="group" aria-label={L.filter}>
		<button type="button" class="sc-chip" aria-pressed="true" data-f="all">{L.all}</button>
		<button type="button" class="sc-chip" aria-pressed="false" data-f="sfw">{L.sfwOnly}</button>
	</div>
	<div class="pd-rail sc-rail" data-rail data-no-swipe>
		{
			platforms.map((p, i) => (
				<article class={`pd-card is-${p.key}`} data-c={p.content} style={`--i:${i}`}>
					<header>
						<span class={`pd-badge c-${p.content}`}>{badge[p.content]}</span>
						{p.disclosure && <span class="pd-disc">{p.disclosure}</span>}
					</header>
					<h3>{p.name}</h3>
					<p class="pd-keep">{p.keepLabel}</p>
					<div class="pd-meter" aria-hidden="true">
						<i style={`--v:${Math.round((1 - p.pct) * 100)}`} />
					</div>
					<dl>
						<div>
							<dt>{L.content}</dt>
							<dd>{p.contentLabel}</dd>
						</div>
						<div>
							<dt>{L.payouts}</dt>
							<dd>{p.payout}</dd>
						</div>
						<div>
							<dt>{L.bestFor}</dt>
							<dd>{p.bestFor}</dd>
						</div>
						<div class="pd-watch">
							<dt>{L.watch}</dt>
							<dd>{p.watch}</dd>
						</div>
					</dl>
					<a class="pd-link" href={p.href}>
						{L.readGuide(p.name)}
					</a>
				</article>
			))
		}
	</div>
	<p class="pd-note">{L.note(localDate(CHECKED, locale))}</p>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-pd]').forEach((root) => {
		const chips = root.querySelectorAll<HTMLButtonElement>('[data-f]');
		chips.forEach((c) =>
			c.addEventListener('click', () => {
				const f = c.dataset.f;
				chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
				root.querySelectorAll<HTMLElement>('.pd-card').forEach((card) => {
					card.hidden = f === 'sfw' && card.dataset.c !== 'sfw';
				});
			}),
		);
	});
</script>

<style>
	.pd {
		margin-block: 1.5rem 2rem;
	}
	.pd-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin-bottom: 0.9rem;
	}
	.pd-rail {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
		gap: 0.9rem;
	}
	.pd-card {
		--c: var(--accent, var(--sc-rose));
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.1rem 1.1rem 1rem;
		border-radius: var(--sc-radius-lg);
		border: 1px solid var(--sc-line);
		background:
			radial-gradient(120% 70% at 100% 0%, color-mix(in srgb, var(--c) 16%, transparent), transparent 65%),
			rgb(255 255 255 / 0.025);
		animation: pd-in 0.5s var(--sc-ease-settle, ease) both;
		animation-delay: calc(var(--i) * 70ms);
		transition:
			transform var(--sc-dur-base, 0.3s) var(--sc-ease-settle, ease),
			border-color var(--sc-dur-quick, 0.15s);
	}
	.pd-card:hover {
		transform: translateY(-3px);
		border-color: color-mix(in srgb, var(--c) 45%, transparent);
	}
	.pd-card[hidden] {
		display: none;
	}
	.is-fanfix {
		--c: var(--sc-rose);
	}
	.is-onlyfans {
		--c: var(--sc-cyan);
	}
	.is-fanvue {
		--c: var(--sc-amethyst);
	}
	.is-patreon {
		--c: var(--sc-champagne);
	}
	.is-kofi {
		--c: var(--sc-jade);
	}
	header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.pd-badge,
	.pd-disc {
		font-size: 0.7rem;
		font-weight: 600;
		padding: 2px 9px;
		border-radius: var(--sc-radius-pill);
	}
	.pd-badge.c-sfw {
		background: color-mix(in srgb, var(--sc-jade) 22%, transparent);
		color: var(--sc-jade);
	}
	.pd-badge.c-mixed,
	.pd-badge.c-adult {
		background: color-mix(in srgb, var(--sc-ember) 22%, transparent);
		color: var(--sc-champagne);
	}
	.pd-disc {
		background: rgb(255 255 255 / 0.08);
		color: var(--sc-silver);
	}
	h3 {
		margin: 0.2rem 0 0;
		font-family: var(--sc-font-display);
		font-size: 1.6rem;
		letter-spacing: -0.02em;
		color: var(--sc-ivory);
	}
	.pd-keep {
		margin: 0;
		font-weight: 600;
		color: var(--c);
	}
	.pd-meter {
		height: 8px;
		border-radius: var(--sc-radius-pill);
		background: rgb(255 255 255 / 0.07);
		overflow: hidden;
	}
	.pd-meter i {
		display: block;
		height: 100%;
		width: calc(var(--v) * 1%);
		border-radius: inherit;
		background: linear-gradient(90deg, color-mix(in srgb, var(--c) 40%, transparent), var(--c));
		transform-origin: left;
		animation: sc-grow 1.1s var(--sc-ease-settle, ease) both;
	}
	dl {
		margin: 0.4rem 0 0;
		display: grid;
		gap: 0.55rem;
	}
	dt {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--sc-steel);
	}
	dd {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.45;
		color: var(--sc-platinum);
	}
	.pd-watch dd {
		color: var(--sc-champagne);
	}
	.pd-link {
		margin-top: auto;
		padding-top: 0.6rem;
		font-size: 0.86rem;
		font-weight: 600;
		color: var(--sc-ivory);
		text-decoration: none;
	}
	.pd-link:hover {
		color: var(--c);
	}
	.pd-note {
		margin: 0.8rem 0 0;
		font-size: 0.75rem;
		color: var(--sc-steel);
	}
	@keyframes pd-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.pd-card,
		.pd-meter i {
			animation: none;
		}
	}
</style>
