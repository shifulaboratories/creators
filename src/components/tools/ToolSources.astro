---
/** A short, plain list of where a tool's numbers come from. */
interface Props {
	items: { title: string; publisher: string; url: string; date?: string }[];
}
const { items } = Astro.props;
---

<section class="ts not-content" aria-labelledby="sources">
	<h2 id="sources">Sources</h2>
	<ol>
		{items.map((s) => (
			<li>
				<a href={s.url} rel="noopener" target="_blank">{s.title}</a>
				<span>{s.publisher}{s.date && ` · ${s.date}`}</span>
			</li>
		))}
	</ol>
</section>

<style>
	.ts {
		margin-top: 2rem;
	}
	.ts h2 {
		font-size: 1.1rem;
		margin: 0 0 0.5rem;
	}
	.ts ol {
		margin: 0;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.45rem;
		font-size: 0.85rem;
	}
	.ts li {
		margin: 0;
	}
	.ts span {
		display: block;
		color: var(--sc-steel);
		font-size: 0.78rem;
	}
</style>
