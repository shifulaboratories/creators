---
/**
 * Media kit builder. No signup and no server: the kit is drawn in the browser,
 * saved on this device (localStorage), and shared as a link whose #hash holds
 * the kit itself (compressed). A photo stays on this device and is never put
 * in the link.
 *
 * Downloads are made on the device too: the kit is rendered to a canvas
 * (modern-screenshot, loaded only on the first download) and saved as a PNG,
 * or wrapped into a one-page PDF by makePdf() in ./media-kit-pdf.ts, with the
 * email and website kept as clickable links.
 *
 * Three looks (noir, paper, pop) and three sizes (page, story, post). The
 * sheet is laid out at its real export size and scaled down to fit the
 * preview, so what you see is exactly what downloads. Fixed sizes shrink the
 * type a little (--fit) rather than cut anything off.
 */
import './tools.css';
import { siFacebook, siInstagram, siPinterest, siSnapchat, siThreads, siTiktok, siTwitch, siX, siYoutube } from 'simple-icons';

const PLATFORMS = ['Instagram', 'TikTok', 'YouTube', 'X', 'LinkedIn', 'Facebook', 'Threads', 'Pinterest', 'Twitch', 'Snapchat', 'Newsletter', 'Podcast'];
const ICONS: Record<string, string> = {
	Instagram: siInstagram.path,
	TikTok: siTiktok.path,
	YouTube: siYoutube.path,
	X: siX.path,
	Facebook: siFacebook.path,
	Threads: siThreads.path,
	Pinterest: siPinterest.path,
	Twitch: siTwitch.path,
	Snapchat: siSnapchat.path,
	// Generic shapes, not brand marks.
	Newsletter: 'M2 5.5A1.5 1.5 0 0 1 3.5 4h17A1.5 1.5 0 0 1 22 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-17A1.5 1.5 0 0 1 2 18.5zm2.2.5L12 12l7.8-6zM4 8.2v10.3h16V8.2l-8 6.1z',
	Podcast: 'M12 2a4 4 0 0 1 4 4v5a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4zm-7 9h2a5 5 0 0 0 10 0h2a7 7 0 0 1-6 6.93V21h3v2H8v-2h3v-3.07A7 7 0 0 1 5 11z',
};
const ACCENTS = [
	{ key: 'rose', hex: '#ff86b8' },
	{ key: 'champagne', hex: '#ffb47e' },
	{ key: 'butter', hex: '#ffe08a' },
	{ key: 'ion', hex: '#c3a6ff' },
	{ key: 'jade', hex: '#5fe3b0' },
	{ key: 'cyan', hex: '#7cc8ff' },
	{ key: 'ivory', hex: '#e9e4da' },
];
const STYLES = [
	{ key: 'noir', name: 'Noir', note: 'Dark and glowing' },
	{ key: 'paper', name: 'Paper', note: 'Clean editorial' },
	{ key: 'pop', name: 'Pop', note: 'Bold color' },
];
const FORMATS = [
	{ key: 'page', name: 'Page', note: 'PDF for email' },
	{ key: 'story', name: 'Story', note: '1080 × 1920' },
	{ key: 'post', name: 'Post', note: '1080 × 1350' },
];
---

<div
	class="mk not-content"
	data-section="deals"
	data-mk
	data-platforms={JSON.stringify(PLATFORMS)}
	data-accents={JSON.stringify(ACCENTS)}
	data-icons={JSON.stringify(ICONS)}
>
	<div class="mk-view-bar" data-viewbar hidden>
		<p>Someone shared this media kit with you.</p>
		<div class="tw-actions">
			<button type="button" class="tw-btn" data-dl="pdf">Download PDF</button>
			<button type="button" class="tw-btn is-primary" data-remix>Make your own, free</button>
		</div>
	</div>

	<div class="mk-tabs" role="tablist" aria-label="Media kit" data-tabs>
		<button type="button" role="tab" aria-selected="true" data-tab="edit">Edit</button>
		<button type="button" role="tab" aria-selected="false" data-tab="preview">Preview</button>
	</div>

	<div class="mk-layout">
		<form class="mk-form" data-form autocomplete="off" onsubmit="return false">
			<fieldset>
				<legend>Pick a look</legend>
				<div class="mk-styles" role="radiogroup" aria-label="Style">
					{
						STYLES.map((s) => (
							<button type="button" role="radio" aria-checked="false" data-style={s.key} class={`mk-style is-${s.key}`}>
								<span class="mk-style__thumb" aria-hidden="true">
									<i />
									<i />
									<i />
								</span>
								<b>{s.name}</b>
								<small>{s.note}</small>
							</button>
						))
					}
				</div>
				<div class="mk-swatches" role="radiogroup" aria-label="Accent color" data-swatches></div>
			</fieldset>

			<fieldset>
				<legend>You</legend>
				<div class="mk-photo">
					<div class="mk-photo__img" data-photo-preview aria-hidden="true"></div>
					<div>
						<label class="tw-btn mk-file">Add a photo<input type="file" accept="image/*" data-photo /></label>
						<button type="button" class="tw-btn" data-photo-clear hidden>Remove</button>
						<small>Stays on this device. Not included in share links.</small>
					</div>
				</div>
				<div class="tw-grid">
					<label class="tw-field"><span>Name</span><input data-k="name" maxlength="60" /></label>
					<label class="tw-field"><span>Main handle</span><input data-k="handle" maxlength="40" placeholder="@yourname" /></label>
				</div>
				<label class="tw-field"><span>One line about you</span><input data-k="tagline" maxlength="110" placeholder="Fitness and recipes for busy people" /></label>
				<label class="tw-field"><span>Bio</span><textarea data-k="bio" maxlength="420" rows="3"></textarea></label>
				<div class="tw-grid">
					<label class="tw-field"><span>Niche</span><input data-k="niche" maxlength="40" /></label>
					<label class="tw-field"><span>Based in</span><input data-k="location" maxlength="40" /></label>
					<label class="tw-field"><span>Email for brands</span><input data-k="email" type="email" maxlength="80" /></label>
					<label class="tw-field"><span>Website or link in bio</span><input data-k="link" maxlength="80" /></label>
				</div>
			</fieldset>

			<fieldset>
				<legend>Platforms</legend>
				<div class="mk-rows" data-plat-rows></div>
				<button type="button" class="tw-btn" data-add-plat>Add a platform</button>
				<small class="mk-help">Use numbers like 84K or 1.2M and we add up your total reach. Average views from your last 10 or so posts tell brands more than followers.</small>
			</fieldset>

			<fieldset>
				<legend>Audience</legend>
				<div class="tw-grid">
					<label class="tw-field"><span>Top countries or cities</span><input data-k="geo" maxlength="80" placeholder="US 62%, UK 11%, Canada 8%" /></label>
					<label class="tw-field"><span>Main age group</span><input data-k="age" maxlength="40" placeholder="25–34 (48%)" /></label>
					<label class="tw-field"><span>Gender split</span><input data-k="gender" maxlength="40" placeholder="Women 71%" /></label>
				</div>
				<small class="mk-help">Copy these from your app’s audience insights. Brands check.</small>
			</fieldset>

			<fieldset>
				<legend>Brands and results</legend>
				<label class="tw-field"><span>Brands you’ve worked with</span><input data-k="brands" maxlength="200" placeholder="Glossier, Notion, Gymshark" /><small>Separate with commas</small></label>
				<label class="tw-field"><span>A result to brag about</span><input data-k="proof" maxlength="140" placeholder="Drove 1,200 sign-ups for a skincare launch in 48 hours" /></label>
			</fieldset>

			<fieldset>
				<legend>Packages <small>(optional, shown on the Page size)</small></legend>
				<div class="mk-rows" data-pkg-rows></div>
				<button type="button" class="tw-btn" data-add-pkg>Add a package</button>
				<small class="mk-help">Not sure what to charge? Try the <a href="/tools/brand-deal-rate-calculator/">rate calculator</a>. Many creators leave prices off and send them on request.</small>
			</fieldset>

			<button type="button" class="tw-btn is-primary mk-next" data-tab="preview">Preview and download</button>
		</form>

		<div class="mk-side">
			<div class="mk-sticky">
				<div class="mk-formats" role="radiogroup" aria-label="Size" data-formats>
					{
						FORMATS.map((f) => (
							<button type="button" role="radio" aria-checked="false" data-fmt={f.key}>
								<b>{f.name}</b>
								<small>{f.note}</small>
							</button>
						))
					}
				</div>
				<div class="mk-stage" data-stage>
					<div class="mk-sheet" data-sheet></div>
				</div>
				<p class="mk-fit" data-fitnote hidden></p>
				<div class="tw-actions mk-actions">
					<button type="button" class="tw-btn is-primary" data-dl="main">Download PDF</button>
					<button type="button" class="tw-btn" data-dl="png" data-png-alt>Image</button>
					<button type="button" class="tw-btn" data-mkshare>Copy share link</button>
					<button type="button" class="tw-btn mk-reset" data-reset>Start over</button>
				</div>
				<p class="mk-status" aria-live="polite" data-status></p>
				<p class="tw-privacy">Made on this device. Downloads are drawn in your browser and nothing is uploaded. A share link carries the kit inside the link itself.</p>
			</div>
		</div>
	</div>
</div>

<script>
	import { makePdf } from './media-kit-pdf';
	type Plat = { p: string; handle: string; followers: string; views: string; er: string };
	type Pkg = { name: string; price: string };
	type Style = 'noir' | 'paper' | 'pop';
	type Fmt = 'page' | 'story' | 'post';
	type Kit = {
		v: 1;
		name: string; handle: string; tagline: string; bio: string; niche: string; location: string; email: string; link: string;
		geo: string; age: string; gender: string; brands: string; proof: string;
		plats: Plat[]; pkgs: Pkg[]; accent: string;
		/** Kept so links made before styles existed still open in the right colors. */
		theme?: 'dark' | 'light';
		style?: Style;
		fmt?: Fmt;
	};
	const KEY = 'sc-media-kit';
	const PHOTO_KEY = 'sc-media-kit-photo';
	/** Real export sizes in CSS pixels. Page is US Letter at 96 dpi; story and post are exported at 2.5x (1080 wide). */
	const SIZES: Record<Fmt, { w: number; h: number; scale: number; min: number }> = {
		page: { w: 816, h: 1056, scale: 2, min: 0.86 },
		story: { w: 432, h: 768, scale: 2.5, min: 0.62 },
		post: { w: 432, h: 540, scale: 2.5, min: 0.6 },
	};
	const SAMPLE: Kit = {
		v: 1,
		name: 'Maya Reyes',
		handle: '@mayamakes',
		tagline: 'Easy weeknight recipes and the gear that makes them easier',
		bio: 'I test kitchen gear and turn it into 30-second recipes for people with no time. My audience is mostly women 25 to 34 who cook at home four or more nights a week and buy what I recommend.',
		niche: 'Food and home',
		location: 'Austin, TX',
		email: 'hello@example.com',
		link: 'mayamakes.co',
		geo: 'US 64%, Canada 9%, UK 7%',
		age: '25–34 (51%)',
		gender: 'Women 78%',
		brands: 'HexClad, Our Place, Trader Joe’s, Instacart',
		proof: 'Sold out a 500-unit cookware drop in 36 hours with one Reel and two Stories',
		plats: [
			{ p: 'Instagram', handle: '@mayamakes', followers: '84K', views: '41K', er: '4.8%' },
			{ p: 'TikTok', handle: '@mayamakes', followers: '126K', views: '58K', er: '6.1%' },
			{ p: 'YouTube', handle: 'Maya Makes', followers: '22K', views: '15K', er: '' },
		],
		pkgs: [
			{ name: '1 Reel + 3 Stories', price: '$1,800' },
			{ name: '1 TikTok video', price: '$1,500' },
			{ name: '30 days of usage rights', price: '+35%' },
		],
		accent: 'rose',
		style: 'noir',
		fmt: 'page',
	};
	const normalize = (k: Kit): Kit => {
		const out = { ...SAMPLE, ...k };
		if (!k.style) out.style = k.theme === 'light' ? 'paper' : 'noir';
		if (!out.fmt || !(out.fmt in SIZES)) out.fmt = 'page';
		delete out.theme;
		return out;
	};
	const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
	/** "84K" → 84000, "1.2M" → 1200000, "12,400" → 12400. NaN when it isn't a count. */
	const parseCount = (s: string) => {
		const m = s.replace(/[,\s]/g, '').match(/^(\d+(?:\.\d+)?)([kmb])?\+?$/i);
		if (!m) return NaN;
		return +m[1] * ({ k: 1e3, m: 1e6, b: 1e9 }[(m[2] || '').toLowerCase() as 'k'] ?? 1);
	};
	const short = (n: number) => {
		const f = (v: number) => (v >= 100 ? Math.round(v) : Math.round(v * 10) / 10).toString();
		if (n >= 1e9) return f(n / 1e9) + 'B';
		if (n >= 1e6) return f(n / 1e6) + 'M';
		if (n >= 1e3) return f(n / 1e3) + 'K';
		return String(Math.round(n));
	};
	const slug = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'my';
	const store = {
		get: (k: string) => { try { return localStorage.getItem(k); } catch { return null; } },
		set: (k: string, v: string) => { try { localStorage.setItem(k, v); return true; } catch { return false; } },
		del: (k: string) => { try { localStorage.removeItem(k); } catch { /* private mode */ } },
	};
	// Share links: JSON → deflate → base64url in the #hash, so the kit never touches a server.
	const b64u = (bytes: Uint8Array) => btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
	const unb64u = (s: string) => Uint8Array.from(atob(s.replace(/-/g, '+').replace(/_/g, '/')), (c) => c.charCodeAt(0));
	const pipe = async (bytes: Uint8Array, stream: CompressionStream | DecompressionStream) =>
		new Uint8Array(await new Response(new Blob([bytes as BlobPart]).stream().pipeThrough(stream)).arrayBuffer());
	const encode = async (kit: Kit) => {
		const raw = new TextEncoder().encode(JSON.stringify(kit));
		if ('CompressionStream' in window) return 'z' + b64u(await pipe(raw, new CompressionStream('deflate-raw')));
		return 'j' + b64u(raw);
	};
	const decode = async (s: string): Promise<Kit | null> => {
		try {
			const bytes = unb64u(s.slice(1));
			const raw = s[0] === 'z' ? await pipe(bytes, new DecompressionStream('deflate-raw')) : bytes;
			const k = JSON.parse(new TextDecoder().decode(raw));
			return k && k.v === 1 ? normalize(k) : null;
		} catch {
			return null;
		}
	};
	const href = (link: string) => (/^https?:\/\//i.test(link) ? link : 'https://' + link.replace(/^\/+/, ''));

	document.querySelectorAll<HTMLElement>('[data-mk]').forEach(async (root) => {
		const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
		const PLATFORMS: string[] = JSON.parse(root.dataset.platforms!);
		const ACCENTS: { key: string; hex: string }[] = JSON.parse(root.dataset.accents!);
		const ICONS: Record<string, string> = JSON.parse(root.dataset.icons!);
		const sheet = $('[data-sheet]');
		const stage = $('[data-stage]');
		const status = $('[data-status]');
		const say = (t: string, ms = 3200) => {
			status.textContent = t;
			setTimeout(() => status.textContent === t && (status.textContent = ''), ms);
		};

		let kit: Kit = structuredClone(SAMPLE);
		let photo = store.get(PHOTO_KEY) ?? '';
		let shared = false;
		const fromHash = location.hash.startsWith('#kit=') ? await decode(location.hash.slice(5)) : null;
		if (fromHash) {
			kit = { ...fromHash, fmt: 'page' };
			shared = true;
			photo = '';
		} else {
			try {
				const saved = store.get(KEY);
				if (saved) kit = normalize(JSON.parse(saved));
			} catch { /* ignore a broken draft */ }
		}

		const save = () => { if (!shared) store.set(KEY, JSON.stringify(kit)); };

		// ---------- form ----------
		const fillFields = () => {
			root.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-k]').forEach((el) => {
				el.value = (kit as any)[el.dataset.k!] ?? '';
			});
			renderRows();
			renderPickers();
			renderPhoto();
		};
		const renderRows = () => {
			$('[data-plat-rows]').innerHTML = kit.plats
				.map(
					(r, i) => `<div class="mk-row" data-i="${i}">
						<label class="tw-field"><span>Platform</span><select data-pk="p">${PLATFORMS.map((p) => `<option${p === r.p ? ' selected' : ''}>${p}</option>`).join('')}</select></label>
						<label class="tw-field"><span>Handle</span><input data-pk="handle" maxlength="40" value="${esc(r.handle)}" /></label>
						<label class="tw-field"><span>Followers</span><input data-pk="followers" maxlength="12" value="${esc(r.followers)}" placeholder="84K" inputmode="decimal" /></label>
						<label class="tw-field"><span>Avg views</span><input data-pk="views" maxlength="12" value="${esc(r.views)}" placeholder="41K" inputmode="decimal" /></label>
						<label class="tw-field"><span>Engagement</span><input data-pk="er" maxlength="8" value="${esc(r.er)}" placeholder="4.8%" inputmode="decimal" /></label>
						<button type="button" class="mk-x" data-del-plat="${i}" aria-label="Remove ${esc(r.p)}">×</button>
					</div>`,
				)
				.join('');
			$('[data-pkg-rows]').innerHTML = kit.pkgs
				.map(
					(r, i) => `<div class="mk-row is-pkg" data-j="${i}">
						<label class="tw-field"><span>What you deliver</span><input data-gk="name" maxlength="60" value="${esc(r.name)}" /></label>
						<label class="tw-field"><span>Price</span><input data-gk="price" maxlength="16" value="${esc(r.price)}" placeholder="$1,500 or On request" /></label>
						<button type="button" class="mk-x" data-del-pkg="${i}" aria-label="Remove package">×</button>
					</div>`,
				)
				.join('');
		};
		const renderPickers = () => {
			const accent = ACCENTS.find((a) => a.key === kit.accent)?.hex ?? ACCENTS[0].hex;
			root.style.setProperty('--mk-pick', accent);
			$('[data-swatches]').innerHTML = ACCENTS.map(
				(a) => `<button type="button" role="radio" aria-checked="${a.key === kit.accent}" aria-label="${a.key}" data-accent="${a.key}" style="--sw:${a.hex}"></button>`,
			).join('');
			root.querySelectorAll<HTMLElement>('[data-style]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.style === kit.style)));
			root.querySelectorAll<HTMLElement>('[data-fmt]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.fmt === kit.fmt)));
			const main = $('[data-dl="main"]');
			main.textContent = kit.fmt === 'page' ? 'Download PDF' : 'Save image';
			$('[data-png-alt]').hidden = kit.fmt !== 'page';
		};
		const renderPhoto = () => {
			const p = $('[data-photo-preview]');
			p.style.backgroundImage = photo ? `url(${photo})` : '';
			p.textContent = photo ? '' : (kit.name || '?').trim().charAt(0).toUpperCase();
			$('[data-photo-clear]').hidden = !photo;
		};

		// ---------- the kit ----------
		const icon = (p: string) =>
			ICONS[p] ? `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="${ICONS[p]}"/></svg>` : `<b aria-hidden="true">${p === 'LinkedIn' ? 'in' : esc(p.charAt(0))}</b>`;
		const draw = () => {
			const accent = ACCENTS.find((a) => a.key === kit.accent)?.hex ?? ACCENTS[0].hex;
			const brands = kit.brands.split(',').map((b) => b.trim()).filter(Boolean);
			const facts = [
				['Top locations', kit.geo],
				['Main age group', kit.age],
				['Audience', kit.gender],
				['Based in', kit.location],
			].filter(([, v]) => v);
			const plats = kit.plats.filter((p) => p.followers || p.handle);
			const counts = plats.map((p) => parseCount(p.followers)).filter((n) => n > 0);
			const total = counts.length >= 2 ? counts.reduce((a, b) => a + b, 0) : 0;
			const views = plats.map((p) => parseCount(p.views)).filter((n) => n > 0);
			const initial = esc((kit.name || '?').trim().charAt(0).toUpperCase());
			const pkgs = kit.pkgs.filter((p) => p.name);
			sheet.className = `mk-sheet s-${kit.style} f-${kit.fmt}`;
			sheet.style.setProperty('--a', accent);
			sheet.innerHTML = `
				<div class="k-glow" aria-hidden="true"></div>
				<header class="k-head">
					<div class="k-avatar" ${photo ? `style="background-image:url(${photo})"` : ''}>${photo ? '' : initial}</div>
					<div class="k-id">
						<p class="k-kicker">Media kit${kit.niche ? ' · ' + esc(kit.niche) : ''}</p>
						<h2>${esc(kit.name || 'Your name')}</h2>
						${kit.handle ? `<p class="k-handle">${esc(kit.handle)}</p>` : ''}
					</div>
				</header>
				${kit.tagline ? `<p class="k-tagline">${esc(kit.tagline)}</p>` : ''}
				${
					total
						? `<div class="k-hero"><div><b>${short(total)}</b><span>followers across ${counts.length} platforms</span></div>${
								views.length >= 2 ? `<div><b>${short(views.reduce((a, b) => a + b, 0))}</b><span>average views per post, combined</span></div>` : ''
							}</div>`
						: ''
				}
				${
					plats.length
						? `<div class="k-plats n-${plats.length}">${plats
								.map(
									(p) => `<div class="k-plat">
										<div class="k-plat__top"><span class="k-ic">${icon(p.p)}</span><span class="k-plat__name">${esc(p.p)}${p.handle ? `<i>${esc(p.handle)}</i>` : ''}</span></div>
										<b>${esc(p.followers || '–')}</b><span class="k-plat__sub">${p.p === 'YouTube' ? 'subscribers' : p.p === 'Newsletter' ? 'subscribers' : 'followers'}</span>
										<div class="k-plat__meta">${p.views ? `<span><b>${esc(p.views)}</b> avg views</span>` : ''}${p.er ? `<span><b>${esc(p.er)}</b> engagement</span>` : ''}</div>
									</div>`,
								)
								.join('')}</div>`
						: ''
				}
				<div class="k-cols">
					<div class="k-col">
						${kit.bio ? `<section class="k-sec k-bio"><h3>About</h3><p>${esc(kit.bio)}</p></section>` : ''}
						${facts.length ? `<section class="k-sec k-aud"><h3>Audience</h3><dl class="k-facts">${facts.map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl></section>` : ''}
					</div>
					<div class="k-col">
						${kit.proof ? `<section class="k-proof"><span>Result</span><p>${esc(kit.proof)}</p></section>` : ''}
						${brands.length ? `<section class="k-sec k-wb"><h3>Worked with</h3><ul class="k-brands">${brands.map((b) => `<li>${esc(b)}</li>`).join('')}</ul></section>` : ''}
						${pkgs.length ? `<section class="k-sec k-pk"><h3>Packages</h3><ul class="k-pkgs">${pkgs.map((p) => `<li><span>${esc(p.name)}</span><b>${esc(p.price || 'On request')}</b></li>`).join('')}</ul></section>` : ''}
					</div>
				</div>
				<footer class="k-foot">
					<div class="k-contact">${kit.email ? `<span class="k-email" data-href="mailto:${esc(kit.email)}">${esc(kit.email)}</span>` : ''}${kit.link ? `<span class="k-link" data-href="${esc(href(kit.link))}">${esc(kit.link)}</span>` : ''}</div>
					<span class="k-made" data-href="https://creators.select/tools/media-kit-builder/">Made free at creators.select</span>
				</footer>`;
			fit();
		};

		// Shrink the type until the kit fits its size. Page grows taller instead once it hits its floor.
		let scale = 1;
		const fit = () => {
			const S = SIZES[kit.fmt!];
			sheet.style.width = S.w + 'px';
			let f = 1;
			const set = () => sheet.style.setProperty('--fit', String(f));
			set();
			let over = false;
			if (kit.fmt === 'page') {
				sheet.style.height = 'auto';
				sheet.style.minHeight = S.h + 'px';
				while (sheet.offsetHeight > S.h + 1 && f > S.min) { f -= 0.02; set(); }
			} else {
				sheet.style.minHeight = '';
				sheet.style.height = S.h + 'px';
				while (sheet.scrollHeight > S.h + 1 && f > S.min) { f -= 0.02; set(); }
				over = sheet.scrollHeight > S.h + 1;
			}
			const note = $('[data-fitnote]');
			note.hidden = !over;
			if (over) note.textContent = 'This is a lot for one ' + kit.fmt + '. The bottom gets cut off: shorten your line, brands or audience, or use the Page size.';
			place();
		};
		const place = () => {
			const S = SIZES[kit.fmt!];
			scale = Math.min(1, stage.clientWidth / S.w) || 1;
			sheet.style.transform = `scale(${scale})`;
			sheet.style.left = Math.max(0, (stage.clientWidth - S.w * scale) / 2) + 'px';
			stage.style.height = Math.ceil(sheet.offsetHeight * scale) + 'px';
			stage.style.setProperty('--w', Math.floor(S.w * scale) + 'px');
		};
		new ResizeObserver(() => place()).observe(stage);

		let queued = 0;
		const update = () => {
			cancelAnimationFrame(queued);
			queued = requestAnimationFrame(() => { draw(); save(); });
		};

		// ---------- downloads ----------
		let busy = false;
		const render = async () => {
			const S = SIZES[kit.fmt!];
			await document.fonts.ready;
			const { domToCanvas } = await import('modern-screenshot');
			return domToCanvas(sheet, {
				scale: S.scale,
				width: S.w,
				height: sheet.offsetHeight,
				style: { transform: 'none', position: 'relative', left: '0', top: '0', margin: '0', borderRadius: '0' },
				backgroundColor: null,
			});
		};
		const links = () => {
			const box = sheet.getBoundingClientRect();
			return [...sheet.querySelectorAll<HTMLElement>('[data-href]')].map((el) => {
				const r = el.getBoundingClientRect();
				return { url: el.dataset.href!, x: (r.left - box.left) / scale, y: (r.top - box.top) / scale, w: r.width / scale, h: r.height / scale };
			});
		};
		const saveFile = async (blob: Blob, name: string) => {
			const file = new File([blob], name, { type: blob.type });
			// Phones: the share sheet has "Save Image" / "Save to Files", which beats a bare download.
			if (matchMedia('(pointer: coarse)').matches && navigator.canShare?.({ files: [file] })) {
				try {
					await navigator.share({ files: [file], title: name });
					return true;
				} catch (err) {
					if ((err as Error).name === 'AbortError') return false;
					// NotAllowedError: the tap "expired" while we drew. Fall through to a plain download.
				}
			}
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = name;
			document.body.appendChild(a);
			a.click();
			a.remove();
			setTimeout(() => URL.revokeObjectURL(url), 10000);
			return true;
		};
		const download = async (kind: 'pdf' | 'png', btn: HTMLButtonElement) => {
			if (busy) return;
			busy = true;
			const label = btn.textContent;
			btn.disabled = true;
			btn.textContent = 'Drawing…';
			root.classList.add('is-busy');
			try {
				const canvas = await render();
				const base = `${slug(kit.name)}-media-kit${kit.fmt === 'page' ? '' : '-' + kit.fmt}`;
				let ok: boolean;
				if (kind === 'pdf') {
					const jpg = await new Promise<Blob>((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('blob'))), 'image/jpeg', 0.93));
					const pdf = makePdf({
						jpeg: new Uint8Array(await jpg.arrayBuffer()),
						px: { w: canvas.width, h: canvas.height },
						size: { w: SIZES[kit.fmt!].w, h: sheet.offsetHeight },
						links: links(),
						title: `${kit.name || 'Creator'} · Media kit`,
					});
					ok = await saveFile(pdf, base + '.pdf');
				} else {
					const png = await new Promise<Blob>((res, rej) => canvas.toBlob((b) => (b ? res(b) : rej(new Error('blob'))), 'image/png'));
					ok = await saveFile(png, base + '.png');
				}
				if (ok) say(kind === 'pdf' ? 'PDF ready. Your email and website are clickable in it.' : 'Image ready. Post it to your Story or link it from your bio.');
			} catch (err) {
				console.error(err);
				say('Couldn’t draw the file on this browser. Try Chrome or Safari, or take a screenshot of the preview.', 6000);
			} finally {
				busy = false;
				btn.disabled = false;
				btn.textContent = label;
				root.classList.remove('is-busy');
			}
		};

		// ---------- events ----------
		root.querySelector('[data-form]')!.addEventListener('input', (e) => {
			const el = e.target as HTMLInputElement;
			if (el.dataset.k) (kit as any)[el.dataset.k] = el.value;
			const row = el.closest<HTMLElement>('.mk-row');
			if (row?.dataset.i && el.dataset.pk) (kit.plats[+row.dataset.i] as any)[el.dataset.pk] = el.value;
			if (row?.dataset.j && el.dataset.gk) (kit.pkgs[+row.dataset.j] as any)[el.dataset.gk] = el.value;
			if (el.dataset.k === 'name') renderPhoto();
			update();
		});
		root.addEventListener('click', async (e) => {
			const t = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
			if (!t) return;
			if (t.dataset.delPlat) { kit.plats.splice(+t.dataset.delPlat, 1); renderRows(); update(); }
			else if (t.dataset.delPkg) { kit.pkgs.splice(+t.dataset.delPkg, 1); renderRows(); update(); }
			else if (t.matches('[data-add-plat]')) {
				if (kit.plats.length >= 6) return say('Six platforms is plenty for one page.');
				const used = new Set(kit.plats.map((p) => p.p));
				kit.plats.push({ p: PLATFORMS.find((p) => !used.has(p)) ?? 'Instagram', handle: kit.handle, followers: '', views: '', er: '' });
				renderRows(); update();
			} else if (t.matches('[data-add-pkg]')) {
				if (kit.pkgs.length >= 6) return say('Keep it to six packages or fewer.');
				kit.pkgs.push({ name: '', price: '' }); renderRows(); update();
			} else if (t.dataset.accent) { kit.accent = t.dataset.accent; renderPickers(); update(); }
			else if (t.dataset.style) { kit.style = t.dataset.style as Style; renderPickers(); update(); }
			else if (t.dataset.fmt) { kit.fmt = t.dataset.fmt as Fmt; renderPickers(); update(); }
			else if (t.dataset.tab) {
				setTab(t.dataset.tab);
				if (t.classList.contains('mk-next')) root.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
			else if (t.dataset.dl) {
				const kind = t.dataset.dl === 'png' || (t.dataset.dl === 'main' && kit.fmt !== 'page') ? 'png' : 'pdf';
				download(kind, t);
			} else if (t.matches('[data-mkshare]')) {
				const url = `${location.origin}${location.pathname}#kit=${await encode(kit)}`;
				try {
					if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share({ title: `${kit.name} · Media kit`, url });
					else { await navigator.clipboard.writeText(url); say(photo ? 'Link copied. Your photo stays off the link, so it shows your initial.' : 'Link copied.'); }
				} catch (err) {
					if ((err as Error).name !== 'AbortError') say('Couldn’t copy. Long-press to copy from the address bar instead.');
				}
			} else if (t.matches('[data-reset]')) {
				kit = structuredClone(SAMPLE);
				kit.name = kit.handle = kit.tagline = kit.bio = kit.niche = kit.location = kit.email = kit.link = kit.geo = kit.age = kit.gender = kit.brands = kit.proof = '';
				kit.plats = [{ p: 'Instagram', handle: '', followers: '', views: '', er: '' }];
				kit.pkgs = [];
				photo = '';
				store.del(PHOTO_KEY);
				fillFields(); update();
				setTab('edit');
				say('Cleared. Start with your name.');
			} else if (t.matches('[data-photo-clear]')) { photo = ''; store.del(PHOTO_KEY); renderPhoto(); update(); }
			else if (t.matches('[data-remix]')) {
				history.replaceState(null, '', location.pathname);
				shared = false;
				root.classList.remove('is-shared');
				$('[data-viewbar]').hidden = true;
				setTab('edit');
				save();
				place();
			}
		});

		// Photo: shrink to 400px on this device before saving, so it fits in storage and downloads stay small.
		root.querySelector<HTMLInputElement>('[data-photo]')!.addEventListener('change', async (e) => {
			const f = (e.target as HTMLInputElement).files?.[0];
			if (!f) return;
			try {
				const bmp = await createImageBitmap(f);
				const s = Math.min(bmp.width, bmp.height);
				const c = document.createElement('canvas');
				c.width = c.height = 400;
				c.getContext('2d')!.drawImage(bmp, (bmp.width - s) / 2, (bmp.height - s) / 2, s, s, 0, 0, 400, 400);
				photo = c.toDataURL('image/jpeg', 0.86);
				if (!store.set(PHOTO_KEY, photo)) say('Photo added for now. Your browser won’t let us keep it after you leave.');
				renderPhoto(); update();
			} catch {
				say('That file didn’t open as an image. Try a JPG or PNG.');
			}
		});

		const tabs = $('[data-tabs]');
		const setTab = (tab: string) => {
			root.dataset.tab = tab;
			tabs.querySelectorAll('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String((b as HTMLElement).dataset.tab === tab)));
			if (tab === 'preview') requestAnimationFrame(() => fit());
		};

		fillFields();
		if (shared) {
			root.classList.add('is-shared');
			$('[data-viewbar]').hidden = false;
			setTab('preview');
		} else setTab('edit');
		draw();
		// Web fonts change line lengths; fit again once they're in.
		document.fonts?.ready.then(() => fit());
	});
</script>

