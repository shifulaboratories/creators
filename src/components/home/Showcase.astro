---
/**
 * Home page showcase: a bento of live previews for the newest things on the
 * site. Each tile is built from real site data at build time and links to the
 * full feature. Interactions are tiny (a few lines of JS each) and the whole
 * thing is readable with JS off. Motion only plays once, on reveal or on tap.
 */
import { getChangelog, NEWS_PLATFORM_INFO } from '../../lib/timeline';
import { jobs } from '../../lib/jobs';
import { localize, type Locale } from '../../i18n';
import type { HomeCopy } from '../../i18n/home';

interface Props {
	locale: Locale;
	T: HomeCopy['show'];
}
const { locale, T } = Astro.props;
const L = (p: string) => localize(locale, p);
const en = locale === 'en' ? undefined : 'en';

// Platform timeline: the four newest dated changes.
const latest = (await getChangelog()).slice(0, 4);

// Jobs: total open roles and who's hiring most.
const byCompany = new Map<string, number>();
for (const j of jobs) byCompany.set(j.company, (byCompany.get(j.company) ?? 0) + 1);
const topHiring = [...byCompany].sort((a, b) => b[1] - a[1]).slice(0, 4);
const topMax = topHiring[0]?.[1] ?? 1;
const companyCount = byCompany.size;

// Case studies: the one move each creator made (from /case-studies/).
const cases = [
	{ id: 'mrbeast', name: 'MrBeast', tint: 'youtube', move: 'Designs the thumbnail before the video.' },
	{ id: 'alix-earle', name: 'Alix Earle', tint: 'instagram', move: 'Turned Get Ready With Me into a story show.' },
	{ id: 'alex-cooper', name: 'Alex Cooper', tint: 'deals', move: 'Owned her show, then licensed it for nine figures.' },
	{ id: 'khaby-lame', name: 'Khaby Lame', tint: 'tiktok', move: 'No words, so every video worked in every country.' },
	{ id: 'ryan-trahan', name: 'Ryan Trahan', tint: 'grow', move: 'Turned vlogs into seasons with a goal.' },
	{ id: 'ali-abdaal', name: 'Ali Abdaal', tint: 'earn', move: 'Five income streams, so ads became the small half.' },
];
const initials = (n: string) => n.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase();

// Taste map: six topic clusters, the same layout as the full explainer.
const topics = [
	{ key: 'beauty', color: 'var(--sc-rose)', x: 20, y: 28 },
	{ key: 'travel', color: 'var(--sc-amethyst)', x: 52, y: 16 },
	{ key: 'food', color: 'var(--sc-champagne)', x: 82, y: 32 },
	{ key: 'comedy', color: 'var(--sc-ion)', x: 50, y: 52 },
	{ key: 'money', color: 'var(--sc-cyan)', x: 22, y: 76 },
	{ key: 'fitness', color: 'var(--sc-jade)', x: 80, y: 76 },
] as const;
const jitter = [
	[-6, -4],
	[5, -5],
	[-3, 6],
	[7, 3],
];
---

<section class="show" aria-labelledby="show-h">
	<div class="show-head" data-rv>
		<span class="show-pill"><i aria-hidden="true"></i>{T.pill}</span>
		<h2 id="show-h">{T.title}</h2>
		<p>{T.lead}</p>
	</div>

	<div class="bento">
		<!-- Media kit builder -->
		<article class="tile t-kit" data-rv style="--d:0">
			<div class="tile-copy">
				<span class="tag" style="--accent:var(--sc-champagne)">{T.kit.tag}</span>
				<h3>{T.kit.title}</h3>
				<p>{T.kit.text}</p>
			</div>
			<div class="kit-stage">
				<div class="kit-looks" role="radiogroup" aria-label={T.kit.looks}>
					<button type="button" role="radio" aria-checked="true" data-look="noir">Noir</button>
					<button type="button" role="radio" aria-checked="false" data-look="paper">Paper</button>
					<button type="button" role="radio" aria-checked="false" data-look="pop">Pop</button>
				</div>
				<div class="kit-card" data-kit data-look="noir" aria-hidden="true">
					<div class="kc-top">
						<span class="kc-av"></span>
						<span class="kc-id"><b>Maya Reyes</b><small>@mayamakes · Beauty</small></span>
					</div>
					<div class="kc-stats">
						<span><b>248K</b><small>Followers</small></span>
						<span><b>4.8%</b><small>Engaged</small></span>
						<span><b>92K</b><small>Avg views</small></span>
					</div>
					<div class="kc-bars"><i style="--h:38%"></i><i style="--h:62%"></i><i style="--h:48%"></i><i style="--h:80%"></i><i style="--h:70%"></i><i style="--h:96%"></i></div>
					<div class="kc-foot"><span>Reels</span><span>Stories</span><span>UGC</span></div>
				</div>
				<p class="sample">{T.kit.sample}</p>
			</div>
			<a class="go stretch" href={L('/tools/media-kit-builder/')} hreflang={en}>{T.kit.cta}<span aria-hidden="true">→</span></a>
		</article>

		<!-- Taste map -->
		<article class="tile t-taste" data-rv style="--d:1">
			<div class="tile-copy">
				<span class="tag" style="--accent:var(--sc-rose)">{T.taste.tag}</span>
				<h3>{T.taste.title}</h3>
				<p>{T.taste.text}</p>
			</div>
			<div class="tm-mini" data-tm-mini data-moved={T.taste.moved}>
				<svg viewBox="0 0 100 92" role="img" aria-label={T.taste.mapLabel}>
					{
						topics.map((t) =>
							jitter.map(([dx, dy]) => (
								<circle class="tm-dot" data-topic={t.key} cx={t.x + dx} cy={t.y + dy} r="2.1" style={`--c:${t.color}`} />
							)),
						)
					}
					<line class="tm-trail" x1="50" y1="46" x2="50" y2="46" data-trail />
					<g class="tm-you" data-you style="transform: translate(50px, 46px)">
						<circle r="5.5" class="tm-you-ring" />
						<circle r="2.8" class="tm-you-dot" />
					</g>
				</svg>
				<div class="tm-chips" role="group" aria-label={T.taste.chipsLabel}>
					{
						topics.map((t, i) => (
							<button type="button" data-topic={t.key} style={`--c:${t.color}`} aria-pressed="false">
								<span aria-hidden="true">♥</span> {T.taste.topics[i]}
							</button>
						))
					}
				</div>
				<p class="tm-status" data-tm-status aria-live="polite">{T.taste.start}</p>
			</div>
			<a class="go stretch" href={L('/algorithms/taste-map/')} hreflang={en}>{T.taste.cta}<span aria-hidden="true">→</span></a>
		</article>

		<!-- Platform timeline -->
		<article class="tile t-time" data-rv style="--d:2">
			<div class="tile-copy">
				<span class="tag" style="--accent:var(--sc-cyan)">{T.time.tag}</span>
				<h3>{T.time.title}</h3>
			</div>
			<ol class="tl" lang={en}>
				{
					latest.map((c, i) => (
						<li style={`--i:${i}`} data-section={c.platform}>
							<span class="tl-dot" aria-hidden="true" />
							<span class="tl-meta">
								<b>{NEWS_PLATFORM_INFO[c.platform]?.name ?? c.platform}</b> · {c.label}
							</span>
							<span class="tl-title">{c.title}</span>
						</li>
					))
				}
			</ol>
			<a class="go stretch" href="/news/timeline/" hreflang={en}>{T.time.cta}<span aria-hidden="true">→</span></a>
		</article>

		<!-- Jobs -->
		<article class="tile t-jobs" data-rv style="--d:3">
			<div class="tile-copy">
				<span class="tag" style="--accent:var(--sc-jade)">{T.jobs.tag}</span>
				<p class="jobs-big"><b data-count={jobs.length}>{jobs.length}</b> <span>{T.jobs.open.replace('{n}', String(companyCount))}</span></p>
			</div>
			<ul class="jobs-bars" aria-label={T.jobs.top}>
				{
					topHiring.map(([co, n], i) => (
						<li style={`--w:${Math.round((n / topMax) * 100)}%; --i:${i}`}>
							<span class="jb-name">{co}</span>
							<span class="jb-n">{n}</span>
						</li>
					))
				}
			</ul>
			<a class="go stretch" href="/jobs/" hreflang={en}>{T.jobs.cta}<span aria-hidden="true">→</span></a>
		</article>

		<!-- Case studies -->
		<article class="tile t-cases" data-rv style="--d:4">
			<div class="tile-copy">
				<span class="tag" style="--accent:var(--sc-amethyst)">{T.cases.tag}</span>
				<h3>{T.cases.title}</h3>
			</div>
			<ul class="cases" lang={en}>
				{
					cases.map((c, i) => (
						<li style={`--i:${i}`}>
							<a href={L(`/case-studies/${c.id}/`)} hreflang={en} data-section={c.tint} class="sc-press">
								<span class="cs-av" aria-hidden="true">{initials(c.name)}</span>
								<span class="cs-txt"><b>{c.name}</b><small>{c.move}</small></span>
							</a>
						</li>
					))
				}
			</ul>
			<a class="go" href={L('/case-studies/')} hreflang={en}>{T.cases.cta}<span aria-hidden="true">→</span></a>
		</article>
	</div>
</section>

<script>
	// Reveal tiles once as they scroll into view (CSS does the motion).
	const rv = document.querySelectorAll<HTMLElement>('[data-rv]');
	if ('IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(es) =>
				es.forEach((e) => {
					if (!e.isIntersecting) return;
					e.target.classList.add('is-in');
					io.unobserve(e.target);
				}),
			{ rootMargin: '0px 0px -10% 0px' },
		);
		rv.forEach((el) => io.observe(el));
	} else rv.forEach((el) => el.classList.add('is-in'));

	// Jobs: count up once when the tile appears.
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
		const to = Number(el.dataset.count);
		if (reduce || !('IntersectionObserver' in window)) return;
		const io = new IntersectionObserver(([e]) => {
			if (!e.isIntersecting) return;
			io.disconnect();
			const t0 = performance.now();
			const tick = (t: number) => {
				const k = Math.min(1, (t - t0) / 900);
				el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
				if (k < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		});
		io.observe(el);
	});

	// A soft light follows the pointer across tiles on laptops.
	if (matchMedia('(hover: hover) and (pointer: fine)').matches)
		document.querySelectorAll<HTMLElement>('.bento .tile').forEach((t) =>
			t.addEventListener('pointermove', (e) => {
				const r = t.getBoundingClientRect();
				t.style.setProperty('--mx', `${e.clientX - r.left}px`);
				t.style.setProperty('--my', `${e.clientY - r.top}px`);
			}),
		);

	// Media kit: switch the sample card between the builder's three looks.
	document.querySelectorAll<HTMLButtonElement>('[data-look]').forEach((b) => {
		if (b.tagName !== 'BUTTON') return;
		b.addEventListener('click', (ev) => {
			ev.stopPropagation();
			const tile = b.closest('.t-kit')!;
			tile.querySelectorAll('[role=radio]').forEach((r) => r.setAttribute('aria-checked', String(r === b)));
			tile.querySelector<HTMLElement>('[data-kit]')!.dataset.look = b.dataset.look;
		});
	});

	// Taste map: each reaction pulls "you" 45% of the way to that topic, and
	// the posts nearest you light up as your shortlist.
	document.querySelectorAll<HTMLElement>('[data-tm-mini]').forEach((root) => {
		const you = root.querySelector<SVGGElement>('[data-you]')!;
		const trail = root.querySelector<SVGLineElement>('[data-trail]')!;
		const status = root.querySelector<HTMLElement>('[data-tm-status]')!;
		const dots = [...root.querySelectorAll<SVGCircleElement>('.tm-dot')];
		const centers: Record<string, [number, number]> = {};
		for (const d of dots) {
			const k = d.dataset.topic!;
			const c = centers[k] ?? [0, 0];
			centers[k] = [c[0] + Number(d.getAttribute('cx')) / 4, c[1] + Number(d.getAttribute('cy')) / 4];
		}
		let pos: [number, number] = [50, 46];
		const near = () => {
			const ranked = dots.map((d) => ({ d, dist: Math.hypot(Number(d.getAttribute('cx')) - pos[0], Number(d.getAttribute('cy')) - pos[1]) })).sort((a, b) => a.dist - b.dist);
			dots.forEach((d) => d.classList.remove('is-near'));
			ranked.slice(0, 5).forEach((r) => r.d.classList.add('is-near'));
		};
		root.querySelectorAll<HTMLButtonElement>('button[data-topic]').forEach((b) =>
			b.addEventListener('click', () => {
				const [tx, ty] = centers[b.dataset.topic!];
				const from = pos;
				pos = [from[0] + (tx - from[0]) * 0.45, from[1] + (ty - from[1]) * 0.45];
				trail.setAttribute('x1', String(from[0]));
				trail.setAttribute('y1', String(from[1]));
				trail.setAttribute('x2', String(pos[0]));
				trail.setAttribute('y2', String(pos[1]));
				you.style.transform = `translate(${pos[0]}px, ${pos[1]}px)`;
				b.setAttribute('aria-pressed', 'true');
				root.classList.add('is-moved');
				near();
				status.textContent = root.dataset.moved ?? status.textContent;
			}),
		);
	});
</script>

<style>
	.show {
		padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(2rem, 5vw, 3.5rem);
	}
	.show-head {
		display: grid;
		justify-items: center;
		gap: 0.75rem;
		margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
		text-align: center;
	}
	.show-pill {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.75rem 0.3rem 0.55rem;
		border-radius: 999px;
		background: rgb(220 255 107 / 0.1);
		box-shadow: inset 0 0 0 1px rgb(220 255 107 / 0.3);
		color: var(--sc-lime);
		font-size: 0.78rem;
		font-weight: 600;
	}
	.show-pill i {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--sc-lime);
		box-shadow: 0 0 10px var(--sc-lime);
	}
	.show-head h2 {
		margin: 0;
		font-family: var(--sc-font-display);
		font-size: clamp(1.8rem, 4.4vw, 2.8rem);
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--sc-ivory);
		text-wrap: balance;
	}
	.show-head p {
		max-width: 34rem;
		margin: 0;
		color: var(--sc-silver);
		line-height: 1.6;
		text-wrap: pretty;
	}

	/* ---------- Bento ---------- */
	.bento {
		display: grid;
		gap: 0.85rem;
	}
	@media (min-width: 48rem) {
		.bento {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
		.t-kit,
		.t-taste {
			grid-column: span 3;
		}
		.t-time,
		.t-jobs,
		.t-cases {
			grid-column: span 2;
		}
	}

	.tile {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		min-width: 0;
		padding: clamp(1.1rem, 2.4vw, 1.5rem);
		border-radius: 24px;
		background:
			radial-gradient(120% 80% at 0% 0%, rgb(255 255 255 / 0.045), transparent 55%),
			linear-gradient(180deg, rgb(255 255 255 / 0.035), rgb(255 255 255 / 0.012));
		box-shadow:
			inset 0 0 0 1px var(--sc-line),
			inset 0 1px 0 rgb(255 255 255 / 0.06);
		overflow: hidden;
		transition: box-shadow 0.3s, transform 0.3s;
	}
	/* A soft light that follows the pointer on laptops. */
	.tile::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: radial-gradient(22rem circle at var(--mx, 50%) var(--my, -30%), rgb(195 166 255 / 0.1), transparent 60%);
		opacity: 0;
		transition: opacity 0.3s;
	}
	@media (hover: hover) and (pointer: fine) {
		.tile:hover {
			box-shadow:
				inset 0 0 0 1px var(--sc-line-strong),
				inset 0 1px 0 rgb(255 255 255 / 0.08),
				0 24px 60px -30px rgb(195 166 255 / 0.35);
		}
		.tile:hover::before {
			opacity: 1;
		}
	}
	.tile-copy {
		display: grid;
		gap: 0.45rem;
	}
	.tag {
		justify-self: start;
		padding: 0.22rem 0.6rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--accent) 14%, transparent);
		color: var(--accent);
		font-size: 0.74rem;
		font-weight: 600;
	}
	.tile h3 {
		margin: 0;
		font-family: var(--sc-font-display);
		font-size: clamp(1.15rem, 2vw, 1.35rem);
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--sc-ivory);
		text-wrap: balance;
	}
	.tile-copy p {
		margin: 0;
		color: var(--sc-silver);
		font-size: 0.92rem;
		line-height: 1.55;
	}
	.go {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-top: auto;
		color: var(--sc-ivory);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}
	.go span {
		transition: transform 0.2s;
	}
	.tile:hover .go span,
	.go:focus-visible span {
		transform: translateX(3px);
	}
	/* The whole tile is the link, except the controls inside it. */
	.stretch::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 0;
		border-radius: inherit;
	}
	.kit-looks,
	.tm-chips,
	.cases {
		position: relative;
		z-index: 1;
	}

	/* Reveal: tiles rise in once. Without JS everything is just there. */
	:global(html.js) [data-rv] {
		opacity: 0;
		transform: translateY(18px);
	}
	:global(html.js) [data-rv].is-in {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.7s var(--sc-ease-settle, ease) calc(var(--d, 0) * 80ms),
			transform 0.7s var(--sc-ease-settle, ease) calc(var(--d, 0) * 80ms),
			box-shadow 0.3s;
	}

	/* ---------- Media kit ---------- */
	.t-kit {
		background:
			radial-gradient(90% 70% at 100% 100%, rgb(255 180 126 / 0.14), transparent 60%),
			radial-gradient(120% 80% at 0% 0%, rgb(255 255 255 / 0.045), transparent 55%),
			rgb(255 255 255 / 0.02);
	}
	.kit-stage {
		display: grid;
		justify-items: center;
		gap: 0.85rem;
		padding: 0.25rem 0;
	}
	.kit-looks {
		display: inline-flex;
		gap: 0.25rem;
		padding: 0.25rem;
		border-radius: 999px;
		background: rgb(0 0 0 / 0.35);
		box-shadow: inset 0 0 0 1px var(--sc-line);
	}
	.kit-looks button {
		min-height: 2rem;
		padding: 0 0.9rem;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: var(--sc-silver);
		font: inherit;
		font-size: 0.82rem;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	.kit-looks [aria-checked='true'] {
		background: var(--sc-ivory);
		color: #0a0a0b;
	}
	.kit-card {
		--bg: #121015;
		--fg: #f5f5f4;
		--mut: #a3a1a8;
		--ac: #ffb47e;
		--ac2: #ff86b8;
		width: min(100%, 19rem);
		display: grid;
		gap: 0.9rem;
		padding: 1.1rem;
		border-radius: 18px;
		background:
			radial-gradient(80% 60% at 100% 0%, color-mix(in srgb, var(--ac2) 22%, transparent), transparent 60%),
			var(--bg);
		color: var(--fg);
		box-shadow:
			0 0 0 1px rgb(255 255 255 / 0.08),
			0 30px 60px -24px rgb(0 0 0 / 0.8),
			0 0 50px -20px color-mix(in srgb, var(--ac) 60%, transparent);
		transform: perspective(900px) rotateX(8deg) rotateY(-10deg) rotateZ(1deg);
		transition:
			transform 0.6s var(--sc-ease-settle, ease),
			background 0.4s,
			color 0.4s,
			box-shadow 0.4s;
	}
	.t-kit:hover .kit-card {
		transform: perspective(900px) rotateX(0) rotateY(0) rotateZ(0) translateY(-4px);
	}
	.kit-card[data-look='paper'] {
		--bg: #f6f2ea;
		--fg: #17151a;
		--mut: #6c6870;
		--ac: #17151a;
		--ac2: #e9dfcf;
	}
	.kit-card[data-look='pop'] {
		--bg: #ff86b8;
		--fg: #17151a;
		--mut: #4a2034;
		--ac: #dcff6b;
		--ac2: #c3a6ff;
	}
	.kc-top {
		display: flex;
		align-items: center;
		gap: 0.7rem;
	}
	.kc-av {
		width: 2.6rem;
		height: 2.6rem;
		flex: none;
		border-radius: 50%;
		background: conic-gradient(from 200deg, var(--ac), var(--ac2), var(--ac));
		box-shadow: 0 0 0 2px var(--bg), 0 0 0 3px color-mix(in srgb, var(--fg) 25%, transparent);
	}
	.kc-id {
		display: grid;
		line-height: 1.25;
	}
	.kc-id b {
		font-family: var(--sc-font-display);
		font-size: 1.02rem;
	}
	.kc-id small,
	.kc-stats small,
