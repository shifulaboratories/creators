---
/**
 * Share button for a guide. Opens a bottom sheet with a 1080x1920 Story card,
 * copy link, the phone's own share sheet, and the networks creators use. Also turns on Story
 * sharing for any stat on the page: <ShareStat>, a .sc-stat tile, or any
 * element with data-story-value (see src/scripts/story.ts and CONTRIBUTING.md).
 */
import { Icon } from '@astrojs/starlight/components';
import { currentLocale, t as tr, sectionLabel } from '../i18n';
interface Props {
	title: string;
	description?: string;
	section?: string;
}
const { title, description, section } = Astro.props;
const site = (Astro.site ?? new URL('https://creators.select')).origin;
const url = new URL(Astro.url.pathname, site).href;
const locale = currentLocale(Astro);
const L = tr(locale).share;
const close = tr(locale).ai.close;
const text = L.text(title);
const u = encodeURIComponent(url);
const t = encodeURIComponent(text);
const links = [
	{ name: 'X', icon: 'x.com', href: `https://x.com/intent/post?text=${t}&url=${u}` },
	{ name: 'Threads', icon: 'threads', href: `https://www.threads.net/intent/post?text=${encodeURIComponent(`${text} ${url}`)}` },
	{ name: 'LinkedIn', icon: 'linkedin', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}` },
	{ name: 'WhatsApp', icon: 'whatsapp', href: `https://wa.me/?text=${encodeURIComponent(`${text} ${url}`)}` },
] as const;
---

<button type="button" class="ga-btn" data-sheet-open="share-sheet" aria-haspopup="dialog">
	<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg>
	{L.button}
</button>
<dialog
	id="share-sheet"
	class="sc-sheet not-content"
	aria-labelledby="share-sheet-title"
	data-share
	data-title={title}
	data-text={text}
	data-url={url}
	data-description={description}
	data-kicker={section ? sectionLabel(section, locale) : undefined}
	data-copied={tr(locale).ai.copied}
	data-failed={tr(locale).ai.copyFailed}
	data-share-label={L.button}
	data-to-story={L.toStory('{v}')}
>
	<button type="button" class="sc-sheet__grab" data-sheet-grab data-sheet-close aria-label={close}></button>
	<button type="button" class="sc-sheet__close" data-sheet-close aria-label={close}>×</button>
	<div class="sc-sheet__body">
		<p class="sc-sheet__title" id="share-sheet-title">{L.title}</p>
		<p class="sc-sheet__sub">{title}</p>
		<ul class="sc-sheet__list">
			<li>
				<button type="button" class="sc-sheet__row is-primary" data-story-page>
					<span class="sc-sheet__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3" /><path d="M10 6.5h4" /></svg></span>
					<span>{L.story}<small>{L.storySmall}</small></span>
				</button>
			</li>
			<li>
				<button type="button" class="sc-sheet__row" data-share-copy>
					<span class="sc-sheet__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span>
					<span data-label>{L.copyLink}</span>
				</button>
			</li>
			<li>
				<button type="button" class="sc-sheet__row" data-share-native hidden>
					<span class="sc-sheet__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12M7 8l5-5 5 5M5 13v6a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-6" /></svg></span>
					<span>{L.more}<small>{L.moreSmall}</small></span>
				</button>
			</li>
		</ul>
		<ul class="sc-sheet__apps">
			{links.map((l) => (
				<li>
					<a class="sc-sheet__app" href={l.href} target="_blank" rel="noopener">
						<span class="sc-sheet__icon is-fill">{l.icon === 'whatsapp' ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a9.5 9.5 0 0 0-8.2 14.3L2.5 21.5l4.8-1.3A9.5 9.5 0 1 0 12 2.5zm0 1.8a7.7 7.7 0 1 1-4 14.3l-.3-.2-2.8.8.8-2.7-.2-.3A7.7 7.7 0 0 1 12 4.3zm-3 3.6c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.1s.9 2.4 1 2.6c.1.2 1.8 2.9 4.5 3.9 2.2.9 2.7.7 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.3-1.6-.8c-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.3 6.3 0 0 1-3.1-2.7c-.2-.4.2-.4.7-1.3.1-.1 0-.3 0-.4l-.7-1.8c-.2-.5-.4-.4-.6-.4z" /></svg> : <Icon name={l.icon} size="1.15rem" />}</span>
						{l.name}
					</a>
				</li>
			))}
		</ul>
	</div>
</dialog>

<script>
	import { initSheets, closeSheet } from '../scripts/sheet';
	initSheets();
	type Story = typeof import('../scripts/story');
	let story: Promise<Story> | undefined;
	const loadStory = () => (story ??= import('../scripts/story'));
	const accent = () => getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || undefined;
	const bar = document.querySelector<HTMLDialogElement>('[data-share]');
	const meta = bar?.dataset ?? {};

	function flash(b: HTMLElement, msg: string) {
		const el = b.querySelector<HTMLElement>('[data-label]') ?? b;
		const prev = el.innerHTML;
		el.textContent = msg;
		setTimeout(() => (el.innerHTML = prev), 1600);
	}
	async function copy(b: HTMLElement, text: string) {
		try {
			await navigator.clipboard.writeText(text);
			flash(b, meta.copied ?? 'Copied ✓');
		} catch {
			flash(b, meta.failed ?? 'Couldn’t copy');
		}
	}

	// Native share sheet where it exists (phones); otherwise copy the link.
	const native = bar?.querySelector<HTMLButtonElement>('[data-share-native]');
	if (native && 'share' in navigator) native.hidden = false;
	native?.addEventListener('click', () => {
		// The phone's share sheet must open inside the tap, so it goes first.
		navigator.share({ title: meta.title, text: meta.text, url: meta.url }).catch(() => {});
		if (bar) closeSheet(bar);
	});
	bar?.querySelector<HTMLButtonElement>('[data-share-copy]')?.addEventListener('click', (e) =>
		copy(e.currentTarget as HTMLElement, meta.url!),
	);
	bar?.querySelector<HTMLButtonElement>('[data-story-page]')?.addEventListener('click', async () => {
		const [{ openStory }] = await Promise.all([loadStory(), bar && closeSheet(bar)]);
		openStory({ title: meta.title!, label: meta.description, kicker: meta.kicker, accent: accent(), url: meta.url });
	});

	// Any stat on the page can become a Story card.
	const icon =
		'<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="3" /><path d="M10 6.5h4" /></svg>';
	for (const tile of document.querySelectorAll<HTMLElement>('.sc-stat')) {
		if (tile.querySelector('[data-story-value]') || tile.closest('[data-story-value]')) continue;
		const value = tile.querySelector('.sc-stat__value')?.textContent?.trim();
		const label = tile.querySelector('.sc-stat__label')?.textContent?.trim();
		if (!value) continue;
		const b = document.createElement('button');
		b.type = 'button';
		b.className = 'sc-story-btn';
		b.dataset.storyValue = value;
		if (label) b.dataset.storyLabel = label;
		if (tile.dataset.storySource) b.dataset.storySource = tile.dataset.storySource;
		b.innerHTML = `${icon}<span>${meta.shareLabel ?? 'Share'}</span>`;
		b.setAttribute('aria-label', (meta.toStory ?? 'Share “{v}” to your Story').replace('{v}', value));
		tile.append(b);
	}
	document.addEventListener('click', async (e) => {
		const el = (e.target as HTMLElement).closest<HTMLElement>('[data-story-value]');
		if (!el) return;
		e.preventDefault();
		const { openStory } = await loadStory();
		const d = el.dataset;
		openStory({
			value: d.storyValue,
			label: d.storyLabel,
			source: d.storySource,
			title: d.storyTitle || meta.title || document.title,
			kicker: meta.kicker,
			accent: d.storyAccent || accent(),
			url: meta.url,
		});
	});
</script>

<style is:global>
	.sc-story-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		width: fit-content;
		margin-top: 0.35rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		background: transparent;
		color: var(--sc-silver);
		font: 600 0.72rem / 1.4 var(--sc-font-sans);
		cursor: pointer;
	}
	.sc-story-btn:hover {
		color: var(--sc-ivory);
		border-color: var(--accent, var(--sc-rose));
	}
	.sc-story-btn svg {
		width: 13px;
		height: 13px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
	}
	dialog.sc-story {
		display: flex;
		margin: auto;
		gap: 1.5rem;
		align-items: center;
		max-width: min(40rem, calc(100vw - 2rem));
		padding: 1.25rem;
		border: 1px solid var(--sc-line-strong);
		border-radius: 24px;
		background: var(--sc-onyx);
		color: var(--sc-platinum);
		box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.8);
	}
	dialog.sc-story:not([open]) {
		display: none;
	}
	dialog.sc-story::backdrop {
		background: rgb(8 7 10 / 0.72);
		backdrop-filter: blur(6px);
	}
	.sc-story img {
		width: 216px;
		height: auto;
		border-radius: 16px;
		border: 1px solid var(--sc-line);
		flex: none;
	}
	.sc-story__close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		margin: 0;
	}
	.sc-story__close button {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		border: 0;
		background: rgb(255 255 255 / 0.06);
		color: var(--sc-ivory);
		font-size: 1.25rem;
		cursor: pointer;
	}
	.sc-story__title {
		margin: 0 0 0.5rem;
		font: 700 1.35rem / 1.2 var(--sc-font-display);
		color: var(--sc-ivory);
	}
	.sc-story ol {
		margin: 0 0 1rem;
		padding-left: 1.1rem;
		font-size: 0.9rem;
		color: var(--sc-silver);
	}
	.sc-story__btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.sc-story__btns > * {
		padding: 0.55rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		background: transparent;
		color: var(--sc-ivory);
		font: 600 0.85rem / 1 var(--sc-font-sans);
		text-decoration: none;
		cursor: pointer;
	}
	.sc-story__btns > :first-child:not([hidden]),
	.sc-story__btns [hidden] + a {
		border-color: transparent;
		background: var(--sc-aurora);
		color: #120d12;
	}
	@media (max-width: 34rem) {
		dialog.sc-story {
			flex-direction: column;
		}
		.sc-story img {
			width: 180px;
		}
	}
</style>
