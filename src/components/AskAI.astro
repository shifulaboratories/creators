---
/**
 * Hand a page (or the whole site) to an AI assistant in one tap.
 * Pre-fills Claude, ChatGPT or Perplexity with a prompt that points at our
 * plain-Markdown copy of the page, and offers "Copy as Markdown".
 * variant="sheet" renders one "Ask AI" button that opens a bottom sheet
 * (used in guide headers so phones don't open on a wall of buttons).
 */
import { SITE_NAME } from '../site.mjs';
interface Props {
	scope?: 'page' | 'site';
	mdPath?: string; // e.g. /platforms/youtube.md
	title?: string;
	variant?: 'row' | 'sheet';
}
const { scope = 'page', mdPath, title, variant = 'row' } = Astro.props;
const site = (Astro.site ?? new URL('https://creators.select')).origin;
const pageUrl = new URL(Astro.url.pathname, site).href;
const source = scope === 'site' ? `${site}/llms-full.txt` : mdPath ? `${site}${mdPath}` : pageUrl;
const prompt =
	scope === 'site'
		? `Read ${source}, the full ${SITE_NAME} creator handbook. Use it as your main source and cite the page URLs you rely on. First ask me what platform I'm on, my niche and my goal, then help me make a plan.`
		: `Read ${source} (the "${title}" guide from ${SITE_NAME}, ${pageUrl}). Use it as your source. Summarize it in five bullets, then ask about my platform, niche and goal and help me apply it.`;
const q = encodeURIComponent(prompt);
const targets = [
	{ name: 'Claude', href: `https://claude.ai/new?q=${q}`, note: 'Summarize it, then plan with you' },
	{ name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}`, note: 'Same prompt, opens in ChatGPT' },
	{ name: 'Perplexity', href: `https://www.perplexity.ai/search?q=${q}`, note: 'Good for checking the sources' },
];
const sparkle = 'M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z';
---

{variant === 'sheet' && (
	<>
		<button type="button" class="ga-btn" data-sheet-open="ai-sheet" aria-haspopup="dialog">
			<svg viewBox="0 0 24 24" aria-hidden="true" class="is-fill"><path d={sparkle} /></svg>
			Ask AI
		</button>
		<dialog id="ai-sheet" class="sc-sheet not-content" aria-labelledby="ai-sheet-title">
			<button type="button" class="sc-sheet__grab" data-sheet-grab data-sheet-close aria-label="Close"></button>
			<button type="button" class="sc-sheet__close" data-sheet-close aria-label="Close">×</button>
			<div class="sc-sheet__body">
				<p class="sc-sheet__title" id="ai-sheet-title">Ask AI about this guide</p>
				<p class="sc-sheet__sub">Opens your assistant with this guide already loaded, so you can ask how it applies to you.</p>
				<ul class="sc-sheet__list">
					{targets.map((t, i) => (
						<li>
							<a class:list={['sc-sheet__row', { 'is-primary': i === 0 }]} href={t.href} target="_blank" rel="noopener">
								<span class="sc-sheet__icon is-fill"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={sparkle} /></svg></span>
								<span>{t.name}<small>{t.note}</small></span>
								<span class="arrow" aria-hidden="true">↗</span>
							</a>
						</li>
					))}
					{mdPath && (
						<li>
							<button type="button" class="sc-sheet__row" data-copy={mdPath}>
								<span class="sc-sheet__icon"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg></span>
								<span data-copy-label>Copy the guide for any AI<small>Plain text, ready to paste</small></span>
							</button>
						</li>
					)}
				</ul>
			</div>
		</dialog>
	</>
)}

{variant === 'row' && <div class="ai not-content" data-ai>
	<span class="ai-label">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z" /></svg>
		{scope === 'site' ? 'Ask AI about the whole library' : 'Ask AI about this guide'}
	</span>
	<div class="ai-btns">
		{targets.map((t) => <a class="ai-btn" href={t.href} target="_blank" rel="noopener">{t.name} ↗</a>)}
		{mdPath && <button type="button" class="ai-btn" data-copy={mdPath}>Copy for AI</button>}
		{scope === 'site' && <a class="ai-btn" href="/llms-full.txt">llms-full.txt</a>}
	</div>
</div>}

<script>
	import { initSheets } from '../scripts/sheet';
	initSheets();
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
		b.addEventListener('click', async () => {
			const el = b.querySelector<HTMLElement>('[data-copy-label]') ?? b;
			const label = el.innerHTML;
			try {
				// Safari needs the clipboard write to start inside the tap, so hand it a promise.
				const text = fetch(b.dataset.copy!).then((r) => r.text());
				if ('ClipboardItem' in window) {
					await navigator.clipboard.write([new ClipboardItem({ 'text/plain': text.then((t) => new Blob([t], { type: 'text/plain' })) })]);
				} else {
					await navigator.clipboard.writeText(await text);
				}
				el.textContent = el === b ? 'Copied ✓' : 'Copied ✓ Paste it into any assistant';
			} catch {
				el.textContent = 'Couldn’t copy';
			}
			setTimeout(() => (el.innerHTML = label), 2000);
		}),
	);
</script>

<style>
	.ai {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin: 0 0 1.25rem;
		padding: 0.6rem 0.75rem;
		border-radius: 14px;
		border: 1px solid color-mix(in srgb, var(--sc-ion) 30%, transparent);
		background: linear-gradient(90deg, rgb(195 166 255 / 0.08), rgb(255 134 184 / 0.04));
	}
	.ai-label {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--sc-ivory);
	}
	.ai-label svg {
		width: 16px;
		height: 16px;
		fill: var(--sc-ion);
	}
	.ai-btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.ai-btn {
		appearance: none;
		font: inherit;
		font-family: var(--sc-font-mono);
		font-size: 0.7rem;
		padding: 0.3rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		background: rgb(255 255 255 / 0.03);
		color: var(--sc-ivory);
		text-decoration: none;
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.ai-btn:hover {
		border-color: var(--sc-ion);
		background: rgb(195 166 255 / 0.1);
	}
</style>
