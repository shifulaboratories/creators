---
/**
 * "Redline this contract": step through a made-up brand agreement with nine
 * real-world problems. Each step highlights the phrase, explains why, and shows
 * the strike-and-replace. Ends with an email you can copy.
 */
import { redlines, redlineBrand, scripts } from '../../lib/money-data';
const email = scripts.find((s) => s.key === 'redline')!.body;
const passes = [...new Set(redlines.map((r) => r.pass))];
---

<div class="sc-widget rw not-content" data-section="deals" data-rw data-steps={JSON.stringify(redlines)} data-email={email}>
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">Interactive · Redline this contract</div>
			<p class="sc-widget__title">Influencer Agreement: {redlineBrand} × You</p>
		</div>
		<span class="rw-count" data-count aria-live="polite"></span>
	</div>

	<ol class="rw-passes" aria-label="Review passes">
		{passes.map((p) => <li data-pass={p}>{p}</li>)}
	</ol>

	<div class="rw-paper" data-paper>
		<div class="rw-clause-title" data-title></div>
		<p class="rw-text" data-text></p>
	</div>

	<div class="rw-toggle" role="group" aria-label="View">
		<button type="button" class="sc-chip" data-view="before" aria-pressed="true">As they sent it</button>
		<button type="button" class="sc-chip" data-view="after" aria-pressed="false">With your redline</button>
	</div>

	<div class="rw-why">
		<span>Why change it</span>
		<p data-why></p>
		<a data-more href="#">Read about this clause →</a>
	</div>

	<div class="rw-nav">
		<button type="button" class="rw-btn is-ghost" data-prev>Back</button>
		<div class="rw-dots" data-dots role="tablist" aria-label="Jump to a change"></div>
		<button type="button" class="rw-btn" data-next>Next change</button>
	</div>

	<div class="rw-done" data-done hidden>
		<div class="rw-done__badge">All {redlines.length} marked up</div>
		<h5>Your redlined summary</h5>
		<ol data-summary></ol>
		<p>Now send it back. Keep it friendly and short: brands redline creators all day, and most of these asks are routine.</p>
		<button type="button" class="rw-btn" data-copy>Copy the email to the brand</button>
		<button type="button" class="rw-btn is-ghost" data-restart>Start over</button>
	</div>
	<p class="sc-widget__note">{redlineBrand} is made up. The problem wording is typical of real creator contracts. Educational information, not legal advice: for a big fee, a long term or anything you don’t understand, have a lawyer review it.</p>
</div>

<script>
	type R = { pass: string; title: string; before: string; cut: string; add: string; why: string; clause: string };
	const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
	document.querySelectorAll<HTMLElement>('[data-rw]').forEach((root) => {
		const steps: R[] = JSON.parse(root.dataset.steps!);
		const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
		let i = 0;
		let view: 'before' | 'after' = 'before';
		const seen = new Set<number>();
		const dots = $('[data-dots]');
		dots.innerHTML = steps.map((s, n) => `<button type="button" role="tab" aria-label="Change ${n + 1}: ${esc(s.title)}" data-dot="${n}"></button>`).join('');

		const render = () => {
			const s = steps[i];
			seen.add(i);
			$('[data-done]').hidden = true;
			root.querySelector<HTMLElement>('.rw-nav')!.hidden = false;
			$('[data-paper]').hidden = false;
			root.querySelector<HTMLElement>('.rw-why')!.hidden = false;
			root.querySelector<HTMLElement>('.rw-toggle')!.hidden = false;
			$('[data-count]').textContent = `Change ${i + 1} of ${steps.length}`;
			$('[data-title]').textContent = s.title;
			const [pre, rest] = s.before.split('[[');
			const [, post] = rest.split(']]');
			$('[data-text]').innerHTML =
				view === 'before'
					? `${esc(pre)}<mark class="rw-flag">${esc(s.cut)}</mark>${esc(post)}`
					: `${esc(pre)}<del>${esc(s.cut)}</del> <ins>${esc(s.add)}</ins>${esc(post)}`;
			$('[data-why]').textContent = s.why;
			$<HTMLAnchorElement>('[data-more]').href = `/deals/clause-library/#clause-${s.clause}`;
			root.querySelectorAll<HTMLElement>('[data-pass]').forEach((p) => {
				p.classList.toggle('is-on', p.dataset.pass === s.pass);
				p.classList.toggle('is-done', steps.every((x, n) => x.pass !== p.dataset.pass || seen.has(n)) && p.dataset.pass !== s.pass);
			});
			root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
			dots.querySelectorAll<HTMLButtonElement>('[data-dot]').forEach((d) => {
				const n = +d.dataset.dot!;
				d.setAttribute('aria-selected', String(n === i));
				d.classList.toggle('seen', seen.has(n));
			});
			$<HTMLButtonElement>('[data-prev]').disabled = i === 0;
			$('[data-next]').textContent = i === steps.length - 1 ? 'Finish' : view === 'before' ? 'Show the fix' : 'Next change';
		};
		const finish = () => {
			$('[data-paper]').hidden = true;
			root.querySelector<HTMLElement>('.rw-why')!.hidden = true;
			root.querySelector<HTMLElement>('.rw-toggle')!.hidden = true;
			$('[data-done]').hidden = false;
			root.querySelector<HTMLElement>('.rw-nav')!.hidden = true;
			$('[data-count]').textContent = 'Done';
			root.querySelectorAll<HTMLElement>('[data-pass]').forEach((p) => (p.className = 'is-done'));
			$('[data-summary]').innerHTML = steps.map((s) => `<li><b>${esc(s.title)}:</b> ${esc(s.add.charAt(0).toUpperCase() + s.add.slice(1))}.</li>`).join('');
		};
		$('[data-next]').addEventListener('click', () => {
			if (view === 'before') {
				view = 'after';
				return render();
			}
			if (i === steps.length - 1) return finish();
			i++;
			view = 'before';
			render();
		});
		$('[data-prev]').addEventListener('click', () => {
			if (view === 'after') view = 'before';
			else if (i > 0) {
				i--;
				view = 'after';
			}
			render();
		});
		root.querySelector('.rw-toggle')!.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-view]');
			if (!b) return;
			view = b.dataset.view as typeof view;
			render();
		});
		dots.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-dot]');
			if (!b) return;
			i = +b.dataset.dot!;
			view = 'before';
			render();
		});
		$('[data-restart]').addEventListener('click', () => {
			i = 0;
			view = 'before';
			seen.clear();
			render();
		});
		$('[data-copy]').addEventListener('click', async (e) => {
			const b = e.currentTarget as HTMLButtonElement;
			try {
				await navigator.clipboard.writeText(root.dataset.email!);
				b.textContent = 'Copied';
			} catch {
				b.textContent = 'Copy failed';
			}
			setTimeout(() => (b.textContent = 'Copy the email to the brand'), 1800);
		});
		render();
	});
</script>

<style>
	.rw-count {
		font-size: 0.75rem;
		color: var(--sc-silver);
		font-variant-numeric: tabular-nums;
	}
	.rw-passes {
		list-style: none;
		margin: 0 0 0.9rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}
	.rw-passes li {
		font-size: 0.7rem;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line);
		color: var(--sc-steel);
		transition: all 0.25s;
	}
	.rw-passes li.is-on {
		color: #111;
		background: var(--accent);
		border-color: var(--accent);
		font-weight: 600;
	}
	.rw-passes li.is-done {
		color: var(--sc-jade);
		border-color: color-mix(in srgb, var(--sc-jade) 40%, transparent);
	}
	.rw-passes li.is-done::before {
		content: '✓ ';
	}
	.rw-paper {
		padding: 1.1rem 1.1rem 1.2rem;
		border-radius: 12px;
		background: #f6f1ea;
		color: #2a2622;
		box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
		font-family: Georgia, 'Times New Roman', serif;
		min-height: 8.5rem;
	}
	.rw-clause-title {
		font-family: var(--sc-font-sans);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: #6f655b;
		margin-bottom: 0.4rem;
	}
	.rw-text {
		margin: 0;
		font-size: 1rem;
		line-height: 1.6;
	}
	:global(.rw-text mark.rw-flag) {
		background: linear-gradient(transparent 55%, rgb(255 134 184 / 0.55) 55%);
		color: inherit;
		padding: 0 1px;
		animation: rw-pulse 1.6s ease-in-out 2;
	}
	:global(.rw-text del) {
		color: #b23a5b;
		text-decoration-thickness: 2px;
	}
	:global(.rw-text ins) {
		color: #0f7a52;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
		animation: rw-in 0.4s ease both;
	}
	@keyframes rw-pulse {
		50% {
			background-color: rgb(255 134 184 / 0.2);
		}
	}
	@keyframes rw-in {
		from {
			opacity: 0;
		}
	}
	.rw-toggle[hidden],
	.rw-nav[hidden],
	.rw-paper[hidden] {
		display: none;
	}
	.rw-toggle {
		display: flex;
		gap: 0.4rem;
		margin: 0.85rem 0;
	}
	.rw-why {
		padding: 0.8rem 0.9rem;
		border-radius: 12px;
		background: color-mix(in srgb, var(--accent) 10%, transparent);
	}
	.rw-why span {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--accent);
	}
	.rw-why p {
		margin: 0.2rem 0 0.4rem;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--sc-ivory);
	}
	.rw-why a {
		font-size: 0.8rem;
		color: var(--sc-silver);
	}
	.rw-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem;
		margin-top: 1rem;
	}
	.rw-dots {
		display: flex;
		gap: 4px;
		flex-wrap: nowrap;
		min-width: 0;
		justify-content: center;
	}
	:global(.rw-dots button) {
		width: 7px;
		height: 7px;
		flex: none;
		padding: 0;
		border: 0;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.16);
		cursor: pointer;
		transition: width 0.25s, background 0.25s;
	}
	:global(.rw-dots button.seen) {
		background: color-mix(in srgb, var(--accent) 50%, transparent);
	}
	:global(.rw-dots button[aria-selected='true']) {
		width: 14px;
		background: var(--accent);
	}
	.rw-btn {
		appearance: none;
		font: inherit;
		font-weight: 600;
		font-size: 0.85rem;
		padding: 0.6rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--sc-ivory);
		background: var(--sc-ivory);
		color: #0a0a0a;
		cursor: pointer;
		white-space: nowrap;
	}
	.rw-btn.is-ghost {
		background: transparent;
		color: var(--sc-ivory);
		border-color: var(--sc-line-strong);
	}
	.rw-btn:disabled {
		opacity: 0.35;
		cursor: default;
	}
	.rw-btn:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.rw-done {
		padding: 1rem;
		border-radius: 14px;
		border: 1px solid color-mix(in srgb, var(--sc-jade) 40%, transparent);
		background: var(--sc-jade-tint);
	}
	.rw-done__badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: var(--sc-lime);
		color: #111;
	}
	.rw-done h5 {
		margin: 0.6rem 0 0.4rem;
		font-family: var(--sc-font-display);
		font-size: 1.1rem;
		color: var(--sc-ivory);
	}
	.rw-done ol {
		margin: 0 0 0.8rem;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.35rem;
		font-size: 0.84rem;
		color: var(--sc-platinum);
		line-height: 1.45;
	}
	.rw-done p {
		font-size: 0.85rem;
		color: var(--sc-silver);
	}
	.rw-done .rw-btn {
		margin: 0.3rem 0.4rem 0 0;
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.rw-text mark.rw-flag),
		:global(.rw-text ins) {
			animation: none;
		}
	}
</style>
