---
/** What you actually take home from a paid membership on each platform. Fees from src/lib/money-data.ts. */
import { fees, sources } from '../../lib/money-data';
const payload = fees.map((f) => ({ ...f, url: sources[f.src].url }));
---

<div class="sc-widget kc not-content" data-section="earn" data-kc data-fees={JSON.stringify(payload)}>
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">Interactive · Take-home pay</div>
			<p class="sc-widget__title">What you keep from each member, by platform</p>
		</div>
	</div>
	<div class="kc-inputs">
		<label>
			<span>Price per month <b data-out="price">$8</b></span>
			<input class="sc-range" type="range" min="1" max="50" value="8" data-in="price" aria-label="Price per month in dollars" />
		</label>
		<label>
			<span>Paying members <b data-out="members">250</b></span>
			<input class="sc-range" type="range" min="0" max="1000" value="467" data-in="members" aria-label="Paying members" />
		</label>
	</div>
	<ol class="kc-list" data-list></ol>
	<p class="sc-widget__note">
		Card payments made on the web, in US dollars. Members who pay through Apple’s in-app purchase cost you up to 30% more, and currency conversion and payout fees are extra. YouTube’s 70% is of net revenue, so taxes and app-store fees come out first. Ghost and beehiiv charge a flat plan that isn’t included here, so they win only once your revenue covers it.
	</p>
</div>

<script>
	type F = { key: string; name: string; pct: number; procPct: number; procFixed: number; monthly?: string; note: string; url: string };
	const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
	const toMembers = (x: number) => Math.round(Math.pow(10, 1 + (x / 1000) * 3)); // 10 … 10,000
	document.querySelectorAll<HTMLElement>('[data-kc]').forEach((root) => {
		const fees: F[] = JSON.parse(root.dataset.fees!);
		const price = root.querySelector<HTMLInputElement>('[data-in="price"]')!;
		const mem = root.querySelector<HTMLInputElement>('[data-in="members"]')!;
		const list = root.querySelector<HTMLElement>('[data-list]')!;
		const render = () => {
			const p = +price.value;
			const n = toMembers(+mem.value);
			price.style.setProperty('--fill', ((p - 1) / 49) * 100 + '%');
			mem.style.setProperty('--fill', +mem.value / 10 + '%');
			root.querySelector('[data-out="price"]')!.textContent = '$' + p;
			root.querySelector('[data-out="members"]')!.textContent = n.toLocaleString('en-US');
			const gross = p * n;
			const rows = fees
				.map((f) => {
					const per = Math.max(0, p - p * f.pct - (p * f.procPct + f.procFixed));
					return { f, keep: per * n, share: per / p };
				})
				.sort((a, b) => b.keep - a.keep);
			list.innerHTML = rows
				.map(
					(r, i) => `<li style="--v:${(r.share * 100).toFixed(1)};--i:${i}">
						<div class="kc-head"><a href="${r.f.url}" rel="noopener">${r.f.name}</a><b>${usd(r.keep)}<small>/mo${r.f.monthly ? ' ' + r.f.monthly : ''}</small></b></div>
						<div class="kc-track"><span class="kc-fill"></span><span class="kc-pct">${Math.round(r.share * 100)}%</span></div>
						<p>${r.f.note}</p>
					</li>`,
				)
				.join('');
			list.dataset.gross = usd(gross);
		};
		price.addEventListener('input', render);
		mem.addEventListener('input', render);
		render();
	});
</script>

<style>
	.kc-inputs {
		display: grid;
		gap: 0.8rem;
		margin-bottom: 1.1rem;
	}
	@media (min-width: 40rem) {
		.kc-inputs {
			grid-template-columns: 1fr 1fr;
			gap: 1.5rem;
		}
	}
	.kc-inputs label {
		display: grid;
		font-size: 0.85rem;
		color: var(--sc-silver);
	}
	.kc-inputs b {
		color: var(--sc-ivory);
		font-variant-numeric: tabular-nums;
	}
	.kc-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.9rem;
	}
	:global(.kc-list li) {
		display: grid;
		gap: 0.35rem;
		animation: kc-in 0.3s ease both;
		animation-delay: calc(var(--i) * 40ms);
	}
	:global(.kc-head) {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 0.75rem;
		font-size: 0.9rem;
	}
	:global(.kc-head a) {
		color: var(--sc-ivory);
		text-decoration-color: var(--sc-line-strong);
		font-weight: 600;
	}
	:global(.kc-head b) {
		font-family: var(--sc-font-display);
		color: var(--sc-ivory);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	:global(.kc-head small) {
		font-family: var(--sc-font-sans);
		font-weight: 400;
		font-size: 0.7rem;
		color: var(--sc-steel);
		margin-left: 0.2rem;
	}
	:global(.kc-track) {
		position: relative;
		height: 22px;
		border-radius: 999px;
		background: rgb(255 255 255 / 0.05);
		overflow: hidden;
	}
	:global(.kc-fill) {
		position: absolute;
		inset: 0 auto 0 0;
		width: calc(var(--v) * 1%);
		border-radius: inherit;
		background: linear-gradient(90deg, color-mix(in srgb, var(--sc-jade) 45%, transparent), var(--sc-jade));
		transition: width 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
	}
	:global(.kc-pct) {
		position: absolute;
		left: 0.6rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 0.72rem;
		font-weight: 600;
		color: #06281b;
	}
	:global(.kc-list p) {
		margin: 0;
		font-size: 0.76rem;
		line-height: 1.45;
		color: var(--sc-silver);
	}
	@keyframes kc-in {
		from {
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.kc-list li) {
			animation: none;
		}
		:global(.kc-fill) {
			transition: none;
		}
	}
</style>
