---
/**
 * A small 3D object for covers: a thick glass tile in the section color with a
 * logo or icon on its face, tilted in perspective. It floats slowly while on
 * screen and turns to face you on hover. CSS only (transforms run on the GPU),
 * and it holds still for people who prefer reduced motion.
 */
import type { Glyph } from '../lib/glyphs';

interface Props {
	glyph: Glyph;
	size?: 'sm' | 'md' | 'lg';
	/** Stagger the float so a grid of tiles doesn't bob in sync. */
	delay?: number;
}
const { glyph, size = 'md', delay = 0 } = Astro.props;
---

<span class:list={['g3d', size]} style={`--d:${-delay}s`} aria-hidden="true" data-g3d>
	<span class="obj">
		<span class="face">
			{
				glyph.kind === 'text' ? (
					<b>{glyph.d}</b>
				) : (
					<svg viewBox="0 0 24 24" class={glyph.kind}>
						<path d={glyph.d} />
					</svg>
				)
			}
		</span>
	</span>
	<span class="floor"></span>
</span>

<script>
	// Float only while on screen, so a long page never animates dozens of tiles.
	const tiles = document.querySelectorAll<HTMLElement>('[data-g3d]');
	if ('IntersectionObserver' in window && tiles.length) {
		const io = new IntersectionObserver((es) => es.forEach((e) => e.target.classList.toggle('live', e.isIntersecting)), { rootMargin: '80px' });
		tiles.forEach((t) => io.observe(t));
	}
</script>

<style>
	.g3d {
		--s: 5.5rem;
		position: relative;
		display: inline-grid;
		place-items: center;
		width: var(--s);
		height: var(--s);
		perspective: 600px;
	}
	.g3d.sm {
		--s: 3.25rem;
	}
	.g3d.lg {
		--s: 7rem;
	}
	.obj {
		position: relative;
		width: 78%;
		height: 78%;
		transform: rotateX(16deg) rotateY(-22deg) rotateZ(-4deg);
		transform-style: preserve-3d;
		transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
		will-change: transform;
	}
	.face {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		border-radius: 26%;
		color: #fff;
		background:
			linear-gradient(155deg, rgb(255 255 255 / 0.34), rgb(255 255 255 / 0) 42%),
			radial-gradient(120% 120% at 25% 15%, color-mix(in srgb, var(--accent, #c3a6ff) 92%, #fff), color-mix(in srgb, var(--accent, #c3a6ff) 55%, #0b0a0d) 70%);
		/* The tile's thickness: stacked edge shadows, then a soft cast shadow. */
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.5),
			inset 0 -2px 6px rgb(0 0 0 / 0.25),
			1px 1px 0 color-mix(in srgb, var(--accent, #c3a6ff) 45%, #000),
			2px 2px 0 color-mix(in srgb, var(--accent, #c3a6ff) 40%, #000),
			3px 3px 0 color-mix(in srgb, var(--accent, #c3a6ff) 35%, #000),
			4px 4px 0 color-mix(in srgb, var(--accent, #c3a6ff) 30%, #000),
			5px 5px 0 color-mix(in srgb, var(--accent, #c3a6ff) 25%, #000),
			6px 6px 0 color-mix(in srgb, var(--accent, #c3a6ff) 20%, #000),
			14px 18px 28px rgb(0 0 0 / 0.55);
	}
	.face svg {
		width: 50%;
		height: 50%;
		filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.35));
	}
	.face svg.brand {
		fill: currentColor;
	}
	.face svg.line {
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.face b {
		font-family: var(--sc-font-display);
		font-size: calc(var(--s) * 0.34);
		font-weight: 800;
		letter-spacing: -0.04em;
		filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.35));
	}
	.floor {
		position: absolute;
		left: 18%;
		right: 18%;
		bottom: -2%;
		height: 12%;
		border-radius: 50%;
		background: radial-gradient(closest-side, color-mix(in srgb, var(--accent, #c3a6ff) 45%, transparent), transparent);
		filter: blur(4px);
		opacity: 0.8;
	}
	@media (prefers-reduced-motion: no-preference) {
		.g3d.live .obj {
			animation: g3d-float 7s ease-in-out var(--d, 0s) infinite alternate;
		}
		:global(a:hover) .g3d .obj,
		:global(a:focus-visible) .g3d .obj {
			animation-play-state: paused;
			transform: rotateX(4deg) rotateY(-6deg) translateY(-4px) scale(1.06);
		}
	}
	@keyframes g3d-float {
		0% {
			transform: rotateX(16deg) rotateY(-22deg) rotateZ(-4deg) translateY(0);
		}
		100% {
			transform: rotateX(10deg) rotateY(-8deg) rotateZ(-1deg) translateY(-6px);
		}
	}
</style>
