---
/** "Whitelisting" on each platform: what the tool is called, how you approve it, what you control. Official sources only. */
import { adTools } from '../../lib/deal-terms-data';
import { sources } from '../../lib/money-data';
---

<figure class="at not-content" data-section="deals">
	<ul class="at-grid sc-rail">
		{
			adTools.map((t) => (
				<li class="at-card" style={`--c:${t.tint}`}>
					<p class="at-plat">{t.platform}</p>
					<p class="at-name">{t.name}</p>
					<dl>
						<dt>How you approve it</dt>
						<dd>{t.how}</dd>
						<dt>What you control</dt>
						<dd>{t.control}</dd>
						<dt>Watch for</dt>
						<dd>{t.watch}</dd>
					</dl>
					<p class="at-src">
						{t.srcs.map((s, i) => (
							<>
								{i > 0 && ' · '}
								<a href={sources[s].url} rel="noopener">
									{sources[s].name}
								</a>
							</>
						))}
					</p>
				</li>
			))
		}
	</ul>
	<figcaption>Brands and agencies still call all three “whitelisting.” None of them needs your password. <span class="sc-tag is-platform">From the platforms</span></figcaption>
</figure>

<style>
	.at {
		margin: 1.5rem 0 2rem;
	}
	.at-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.7rem;
	}
	@media (min-width: 52rem) {
		.at-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.at-card {
		margin: 0;
		padding: 1rem 1rem 0.9rem;
		border-radius: 18px;
		border: 1px solid color-mix(in srgb, var(--c) 35%, transparent);
		background: linear-gradient(180deg, color-mix(in srgb, var(--c) 12%, transparent), rgb(255 255 255 / 0.01) 70%);
	}
	.at-plat {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 650;
		color: var(--c);
	}
	.at-name {
		margin: 0.1rem 0 0.6rem;
		font-family: var(--sc-font-display);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--sc-ivory);
	}
	dl {
		margin: 0;
		display: grid;
		gap: 0.15rem;
	}
	dt {
		margin-top: 0.45rem;
		font-size: 0.72rem;
		font-weight: 650;
		color: var(--sc-steel);
	}
	dd {
		margin: 0;
		font-size: 0.86rem;
		line-height: 1.45;
		color: var(--sc-platinum);
	}
	.at-src {
		margin: 0.75rem 0 0;
		font-size: 0.72rem;
		line-height: 1.4;
	}
	.at-src a {
		color: var(--sc-silver);
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: 0.75rem;
		color: var(--sc-steel);
	}
</style>
