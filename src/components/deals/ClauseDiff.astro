---
/**
 * Tracked-changes redlines on contract "paper": the brand's wording struck in
 * red, your replacement in green, and the comment to leave in the margin.
 * Each card flips between their version, the redline and your clean version.
 *
 *   <ClauseDiff keys={['usage-term', 'ads-scope']} />   specific clauses
 *   <ClauseDiff topic="payment" />                       one topic
 *   <ClauseDiff gallery />                               all, with topic filter chips
 */
import { diffs, diffRuns, diffTopics, type DiffTopic } from '../../lib/deal-terms-data';
import { sources } from '../../lib/money-data';
interface Props {
	keys?: string[];
	topic?: DiffTopic;
	gallery?: boolean;
	title?: string;
}
const { keys, topic, gallery = false, title } = Astro.props;
const list = keys ? keys.map((k) => diffs.find((d) => d.key === k)!).filter(Boolean) : topic ? diffs.filter((d) => d.topic === topic) : diffs;
const topics = [...new Set(list.map((d) => d.topic))];
const heading = title ?? (gallery ? 'Before and after, clause by clause' : `Redline: ${diffTopics[list[0]?.topic ?? 'usage'].toLowerCase()}`);
---

<div class="sc-widget cd not-content" data-section="deals" data-cd data-view="redline">
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">{gallery ? `Redline gallery · ${list.length} clauses` : 'Before and after'}</div>
			<p class="sc-widget__title">{heading}</p>
		</div>
		<div class="cd-views" role="group" aria-label="Show">
			<button type="button" class="sc-chip" data-v="before" aria-pressed="false">Theirs</button>
			<button type="button" class="sc-chip" data-v="redline" aria-pressed="true">Redline</button>
			<button type="button" class="sc-chip" data-v="after" aria-pressed="false">Yours</button>
		</div>
	</div>

	{
		gallery && topics.length > 1 && (
			<div class="sc-chip-row cd-filter" role="group" aria-label="Filter by topic">
				<button type="button" class="sc-chip" data-t="all" aria-pressed="true">
					All
				</button>
				{topics.map((t) => (
					<button type="button" class="sc-chip" data-t={t} aria-pressed="false">
						{diffTopics[t]}
					</button>
				))}
			</div>
		)
	}

	<ol class:list={['cd-list', { 'is-gallery': gallery }]}>
		{
			list.map((d) => (
				<li class="cd-card" data-topic={d.topic} id={`redline-${d.key}`}>
					<div class="cd-paper">
						<div class="cd-where">
							<span>{d.where}</span>
							<b>{d.title}</b>
						</div>
						<p class="cd-text">
							{diffRuns(d.text).map((r) => (r.t === 'del' ? <del>{r.s}</del> : r.t === 'ins' ? <ins>{r.s}</ins> : <span>{r.s}</span>))}
						</p>
						<p class="cd-comment">
							<span aria-hidden="true">💬</span> {d.say}
						</p>
					</div>
					<p class="cd-why">
						{d.why}{' '}
						{d.tested && <span class="sc-tag is-practitioner">Creator-tested</span>}{' '}
						{d.srcs.map((s, i) => (
							<>
								{i > 0 && ' · '}
								<a href={sources[s].url} rel="noopener">
									{sources[s].publisher.split(' (')[0]}
								</a>
							</>
						))}
					</p>
				</li>
			))
		}
	</ol>
	<p class="sc-widget__note">Typical wording, not taken from any one brand’s contract. Educational information, not legal advice: for a big fee, a long term or anything you don’t understand, have a lawyer review it.</p>
</div>

<style>
	.cd-views {
		display: flex;
		gap: 0.3rem;
	}
	.cd-filter {
		margin: -0.2rem 0 1rem;
	}
	.cd-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.1rem;
	}
	@media (min-width: 60rem) {
		.cd-list.is-gallery {
			grid-template-columns: 1fr 1fr;
		}
	}
	.cd-card {
		margin: 0;
	}
	.cd-card[hidden] {
		display: none;
	}
	.cd-paper {
		position: relative;
		padding: 0.95rem 1rem 0.9rem;
		border-radius: 12px;
		background: #f6f1ea;
		color: #2a2622;
		box-shadow: 0 18px 40px -22px rgb(0 0 0 / 0.8);
	}
	.cd-where {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.2rem 0.8rem;
		margin-bottom: 0.5rem;
		font-size: 0.72rem;
		color: #7a6f64;
	}
	.cd-where b {
		color: #2a2622;
		font-weight: 650;
	}
	.cd-text {
		margin: 0;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 0.98rem;
		line-height: 1.6;
	}
	.cd-text del {
		color: #b23a5b;
		text-decoration-thickness: 1.5px;
		background: rgb(178 58 91 / 0.07);
	}
	.cd-text ins {
		color: #0f7a52;
		text-decoration: underline;
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
		background: rgb(15 122 82 / 0.07);
	}
	[data-view='before'] .cd-text ins,
	[data-view='after'] .cd-text del {
		display: none;
	}
	[data-view='before'] .cd-text del,
	[data-view='after'] .cd-text ins {
		color: inherit;
		text-decoration: none;
		background: none;
	}
	[data-view='before'] .cd-text del {
		background: linear-gradient(transparent 60%, rgb(255 134 184 / 0.45) 60%);
	}
	[data-view='before'] .cd-comment {
		visibility: hidden;
	}
	.cd-comment {
		margin: 0.7rem 0 0;
		padding: 0.45rem 0.65rem;
		border-left: 3px solid #c9a25a;
		border-radius: 0 8px 8px 0;
		background: #fff8e6;
		font-size: 0.82rem;
		line-height: 1.45;
		color: #4a4036;
	}
	.cd-why {
		margin: 0.55rem 0.2rem 0;
		font-size: 0.84rem;
		line-height: 1.5;
		color: var(--sc-silver);
	}
	.cd-why a {
		color: var(--sc-platinum);
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-cd]').forEach((root) => {
		root.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((b) =>
			b.addEventListener('click', () => {
				root.dataset.view = b.dataset.v!;
				root.querySelectorAll<HTMLButtonElement>('[data-v]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
			}),
		);
		root.querySelectorAll<HTMLButtonElement>('[data-t]').forEach((b) =>
			b.addEventListener('click', () => {
				const t = b.dataset.t!;
				root.querySelectorAll<HTMLButtonElement>('[data-t]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				root.querySelectorAll<HTMLElement>('.cd-card').forEach((c) => (c.hidden = t !== 'all' && c.dataset.topic !== t));
			}),
		);
	});
</script>
