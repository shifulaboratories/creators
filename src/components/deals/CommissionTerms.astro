---
/**
 * Two commission terms that move real money: what the percentage is taken
 * on (gross or net, deals you found) and what happens after you part ways
 * (the sunset clause). Sunset schedule: src/lib/deal-terms-data.ts.
 */
import { sunsets } from '../../lib/deal-terms-data';
import { sources } from '../../lib/money-data';
const pf = sources.pfeiffer;
---

<div class="sc-widget ct not-content" data-section="deals" data-ct data-sunsets={JSON.stringify(sunsets)}>
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">Interactive · Commission terms</div>
			<p class="sc-widget__title">Same 20%, very different checks</p>
		</div>
	</div>

	<div class="ct-grid">
		<label class="ct-in"><span>Brand pays</span><span class="ct-money"><i>$</i><input type="number" inputmode="numeric" min="0" step="100" value="10000" data-fee aria-label="Brand fee" /></span></label>
		<label class="ct-in"><span>You spend making it</span><span class="ct-money"><i>$</i><input type="number" inputmode="numeric" min="0" step="100" value="2500" data-cost aria-label="Production costs" /></span></label>
		<label class="ct-in"><span>Commission</span><span class="ct-money"><input type="number" inputmode="numeric" min="0" max="50" step="1" value="20" data-rate aria-label="Commission percent" /><i>%</i></span></label>
	</div>

	<div class="ct-toggles">
		<div class="sc-chip-row" role="group" aria-label="Commission taken on">
			<button type="button" class="sc-chip" data-base="gross" aria-pressed="true">On gross</button>
			<button type="button" class="sc-chip" data-base="net" aria-pressed="false">On net of costs</button>
		</div>
		<label class="ct-check"><input type="checkbox" data-mine /> I found this deal myself, and the contract excludes those</label>
	</div>

	<div class="ct-bar" aria-hidden="true">
		<span class="ct-seg is-cost" data-seg="cost"></span>
		<span class="ct-seg is-comm" data-seg="comm"></span>
		<span class="ct-seg is-you" data-seg="you"></span>
	</div>
	<div class="ct-legend" aria-live="polite">
		<span><i class="is-cost"></i>Costs <b data-out="cost"></b></span>
		<span><i class="is-comm"></i>Commission <b data-out="comm"></b></span>
		<span><i class="is-you"></i>You keep <b data-out="you"></b></span>
	</div>

	<div class="ct-sunset">
		<p class="ct-h">After you part ways: a brand they closed renews with you every six months. Their cut of each renewal:</p>
		{
			sunsets.map((s) => (
				<div class="ct-row" data-row={s.key}>
					<span class="ct-lbl">{s.label}</span>
					<div class="ct-months" data-months />
					<b class="ct-sum" data-sum />
				</div>
			))
		}
		<div class="ct-axis"><span>Year 1</span><span>Year 2</span><span>Year 3</span></div>
	</div>

	<p class="sc-widget__note">
		<a href={pf.url} rel="noopener">{pf.publisher}</a>: managers usually take commission on gross, and 15–20% is the norm. Net, exclusions and the step-down schedule are terms you can ask for. <span class="sc-tag is-practitioner">Creator-tested</span> Not legal advice.
	</p>
</div>

<style>
	.ct-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.5rem;
	}
	.ct-in {
		display: grid;
		gap: 0.25rem;
		font-size: 0.72rem;
		color: var(--sc-steel);
	}
	.ct-money {
		display: flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.35rem 0.55rem;
		border-radius: 12px;
		border: 1px solid var(--sc-line-strong);
	}
	.ct-money i {
		font-style: normal;
		color: var(--sc-steel);
	}
	.ct-money input {
		width: 100%;
		min-width: 0;
		border: 0;
		background: none;
		color: var(--sc-ivory);
		font: inherit;
		font-size: 0.98rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
	}
	.ct-toggles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
		align-items: center;
		margin-top: 0.9rem;
	}
	.ct-check {
		display: flex;
		gap: 0.45rem;
		align-items: center;
		font-size: 0.82rem;
		color: var(--sc-silver);
	}
	.ct-check input {
		accent-color: var(--accent);
	}
	.ct-bar {
		display: flex;
		height: 14px;
		margin-top: 1rem;
		border-radius: 999px;
		overflow: hidden;
		background: rgb(255 255 255 / 0.06);
	}
	.ct-seg {
		transition: flex-basis 0.3s;
	}
	.is-cost {
		background: var(--sc-slate);
	}
	.is-comm {
		background: var(--sc-ion);
	}
	.is-you {
		background: var(--sc-jade);
	}
	.ct-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1rem;
		margin-top: 0.5rem;
		font-size: 0.8rem;
		color: var(--sc-silver);
	}
	.ct-legend i {
		display: inline-block;
		width: 9px;
		height: 9px;
		margin-right: 0.3rem;
		border-radius: 3px;
	}
	.ct-legend b {
		color: var(--sc-ivory);
		font-variant-numeric: tabular-nums;
	}
	.ct-sunset {
		margin-top: 1.3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sc-line);
	}
	.ct-h {
		margin: 0 0 0.6rem;
		font-size: 0.84rem;
		font-weight: 650;
		color: var(--sc-platinum);
	}
	.ct-row {
		display: grid;
		grid-template-columns: 6.2rem 1fr 4.6rem;
		gap: 0.5rem;
		align-items: center;
		margin-bottom: 0.4rem;
	}
	.ct-lbl {
		font-size: 0.76rem;
		color: var(--sc-silver);
	}
	.ct-months {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 3px;
	}
	:global(.ct-months i) {
		display: grid;
		place-items: center;
		height: 26px;
		border-radius: 6px;
		background: rgb(255 255 255 / 0.05);
		font-style: normal;
		font-size: 0.66rem;
		color: var(--sc-steel);
		font-variant-numeric: tabular-nums;
	}
	:global(.ct-months i.is-on) {
		background: rgb(195 166 255 / var(--a));
		color: #0a0a0a;
		font-weight: 650;
	}
	.ct-sum {
		text-align: right;
		font-size: 0.86rem;
		color: var(--sc-ivory);
		font-variant-numeric: tabular-nums;
	}
	@media (max-width: 30rem) {
		.ct-row {
			grid-template-columns: 4.4rem 1fr 4.4rem;
			gap: 0.35rem;
		}
		.ct-sum {
			font-size: 0.78rem;
		}
		:global(.ct-months i) {
			font-size: 0.56rem;
			letter-spacing: -0.02em;
		}
		.ct-axis {
			margin-left: 4.75rem;
			margin-right: 4.75rem;
		}
	}
	.ct-axis {
		display: flex;
		justify-content: space-around;
		margin-left: 6.7rem;
		margin-right: 5.1rem;
		font-size: 0.64rem;
		color: var(--sc-steel);
	}
</style>

<script>
	type Sunset = { key: string; label: string; steps: { months: number; pct: number }[]; open: boolean };
	const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
	document.querySelectorAll<HTMLElement>('[data-ct]').forEach((root) => {
		const sunsets: Sunset[] = JSON.parse(root.dataset.sunsets!);
		const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
		let base: 'gross' | 'net' = 'gross';
		const render = () => {
			const fee = Math.max(0, +$<HTMLInputElement>('[data-fee]').value || 0);
			const cost = Math.min(fee, Math.max(0, +$<HTMLInputElement>('[data-cost]').value || 0));
			const rate = Math.min(50, Math.max(0, +$<HTMLInputElement>('[data-rate]').value || 0)) / 100;
			const mine = $<HTMLInputElement>('[data-mine]').checked;
			const comm = mine ? 0 : (base === 'gross' ? fee : fee - cost) * rate;
			const you = Math.max(0, fee - cost - comm);
			const total = fee || 1;
			(['cost', 'comm', 'you'] as const).forEach((k) => {
				const v = { cost, comm, you }[k];
				$(`[data-seg="${k}"]`).style.flexBasis = (v / total) * 100 + '%';
				$(`[data-out="${k}"]`).textContent = usd(v);
			});
			root.querySelectorAll<HTMLButtonElement>('[data-base]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.base === base)));
			// Sunset: renewals at months 3, 9, 15... each worth `fee`.
			sunsets.forEach((s) => {
				const pctAt = (m: number) => {
					let acc = 0;
					for (const st of s.steps) {
						if (m < acc + st.months) return st.pct;
						acc += st.months;
					}
					return s.open ? s.steps[s.steps.length - 1].pct : 0;
				};
				let sum = 0;
				const cells: string[] = [];
				for (let k = 0; k < 6; k++) {
					const p = pctAt(k * 6 + 3) * (rate / 0.2);
					sum += fee * p;
					cells.push(`<i class="${p ? 'is-on' : ''}" style="${p ? `--a:${Math.min(1, 0.3 + p * 3)}` : ''}">${Math.round(p * 1000) / 10}%</i>`);
				}
				const row = root.querySelector<HTMLElement>(`[data-row="${s.key}"]`)!;
				row.querySelector<HTMLElement>('[data-months]')!.innerHTML = cells.join('');
				row.querySelector<HTMLElement>('[data-sum]')!.textContent = usd(sum) + (s.open ? '+' : '');
			});
		};
		root.querySelectorAll<HTMLButtonElement>('[data-base]').forEach((b) =>
			b.addEventListener('click', () => {
				base = b.dataset.base as 'gross' | 'net';
				render();
			}),
		);
		root.querySelectorAll('input').forEach((i) => i.addEventListener('input', render));
		render();
	});
</script>
