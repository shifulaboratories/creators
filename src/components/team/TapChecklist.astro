---
/**
 * Tap-to-check list with a live tally. Used for "am I ready for a manager?"
 * and the red-flag check. Works without JavaScript as a plain checklist.
 */
interface Item {
	text: string;
	detail?: string;
}
interface Props {
	title: string;
	kicker?: string;
	items: Item[];
	/** 'good': more checks is better. 'flags': any check is a warning. */
	mode?: 'good' | 'flags';
	/** Verdicts by count, highest threshold first: [minChecked, message]. */
	verdicts: [number, string][];
}
const { title, kicker = 'Tap what’s true', items, mode = 'good', verdicts } = Astro.props;
const id = `tc-${Math.random().toString(36).slice(2, 8)}`;
---

<section class:list={['tc not-content', mode === 'flags' && 'is-flags']} data-tc data-verdicts={JSON.stringify(verdicts)} aria-labelledby={id}>
	<div class="tc-head">
		<p class="tc-kick">{kicker}</p>
		<h3 id={id} class="tc-title">{title}</h3>
	</div>
	<ul class="tc-list">
		{
			items.map((it) => (
				<li>
					<label class="tc-item">
						<input type="checkbox" />
						<span class="tc-box" aria-hidden="true" />
						<span class="tc-text">
							<b>{it.text}</b>
							{it.detail && <small>{it.detail}</small>}
						</span>
					</label>
				</li>
			))
		}
	</ul>
	<div class="tc-foot">
		<span class="tc-count"><b data-count>0</b> / {items.length}</span>
		<p class="tc-verdict" data-verdict aria-live="polite"></p>
	</div>
</section>

<style>
	.tc {
		--c: var(--sc-jade);
		margin-block: 1.5rem 2rem;
		padding: 1.25rem;
		border: 1px solid var(--sc-line);
		border-radius: var(--sc-radius-lg);
		background:
			radial-gradient(120% 80% at 0% 0%, color-mix(in srgb, var(--c) 9%, transparent), transparent 60%),
			rgb(255 255 255 / 0.02);
	}
	.tc.is-flags {
		--c: var(--sc-rose);
	}
	.tc-kick {
		margin: 0;
		display: inline-block;
		padding: 2px 10px;
		border-radius: var(--sc-radius-pill);
		background: color-mix(in srgb, var(--c) 20%, transparent);
		color: var(--c);
		font-size: var(--sc-text-xs);
		font-weight: 700;
	}
	.tc-title {
		margin: 0.5rem 0 1rem;
		font-family: var(--sc-font-display);
		font-size: var(--sc-text-xl);
		color: var(--sc-ivory);
		line-height: 1.2;
	}
	.tc-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.5rem;
	}
	.tc-item {
		display: grid;
		grid-template-columns: 1.5rem 1fr;
		gap: 0.75rem;
		align-items: start;
		padding: 0.75rem 0.85rem;
		border: 1px solid var(--sc-line);
		border-radius: var(--sc-radius-md);
		cursor: pointer;
		transition:
			border-color 0.2s,
			background 0.2s;
	}
	.tc-item input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.tc-box {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		border: 1.5px solid var(--sc-steel);
		display: grid;
		place-items: center;
		transition:
			background 0.2s,
			border-color 0.2s,
			transform 0.2s var(--sc-ease-press, ease);
	}
	.tc-box::after {
		content: '';
		width: 0.45rem;
		height: 0.8rem;
		border: solid #111;
		border-width: 0 2.5px 2.5px 0;
		transform: rotate(45deg) translate(-1px, -1px) scale(0);
		transition: transform 0.2s;
	}
	.tc-item:has(input:checked) {
		border-color: color-mix(in srgb, var(--c) 50%, transparent);
		background: color-mix(in srgb, var(--c) 8%, transparent);
	}
	.tc-item input:checked + .tc-box {
		background: var(--c);
		border-color: var(--c);
		transform: scale(1.06);
	}
	.tc-item input:checked + .tc-box::after {
		transform: rotate(45deg) translate(-1px, -1px) scale(1);
	}
	.tc-item input:focus-visible + .tc-box {
		outline: 2px solid var(--sc-ion);
		outline-offset: 2px;
	}
	.tc-text b {
		display: block;
		color: var(--sc-ivory);
		font-weight: 600;
		font-size: var(--sc-text-sm);
		line-height: 1.4;
	}
	.tc-text small {
		display: block;
		margin-top: 2px;
		color: var(--sc-silver);
		font-size: var(--sc-text-xs);
		line-height: 1.5;
	}
	.tc-foot {
		display: flex;
		gap: 0.85rem;
		align-items: center;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--sc-line);
	}
	.tc-count {
		flex: none;
		font-family: var(--sc-font-display);
		color: var(--sc-silver);
		font-size: var(--sc-text-lg);
	}
	.tc-count b {
		color: var(--c);
		font-size: var(--sc-text-2xl);
	}
	.tc-verdict {
		margin: 0;
		color: var(--sc-ivory);
		font-weight: 600;
		font-size: var(--sc-text-sm);
		line-height: 1.45;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-tc]').forEach((root) => {
		const verdicts = JSON.parse(root.dataset.verdicts || '[]') as [number, string][];
		const boxes = [...root.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const out = root.querySelector<HTMLElement>('[data-verdict]')!;
		const update = () => {
			const n = boxes.filter((b) => b.checked).length;
			count.textContent = String(n);
			out.textContent = (verdicts.find(([min]) => n >= min) || [0, ''])[1];
		};
		boxes.forEach((b) => b.addEventListener('change', update));
		update();
	});
</script>
