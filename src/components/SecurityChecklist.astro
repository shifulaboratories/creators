---
/**
 * Prevention checklist with a progress ring. Ticks are saved in this browser
 * only (localStorage), never sent anywhere.
 */
import { checklist as groups } from '../lib/protect-playbooks';
const total = groups.reduce((n, g) => n + g.items.length, 0);
const tagText = { platform: 'From the platform', practitioner: 'Creator-tested', law: 'The law' };
const tagClass = { platform: 'is-platform', practitioner: 'is-practitioner', law: 'is-code' };
---

<section class="sck sc-widget not-content" data-sck>
	<div class="sck-head">
		<div class="sck-ring" style={`--pct: 0`} aria-hidden="true">
			<span class="sck-num"><b data-done>0</b>/{total}</span>
		</div>
		<div>
			<p class="sc-widget__kicker">The 15-minute lockdown</p>
			<h2 class="sc-widget__title">Tick it off as you go</h2>
			<p class="sck-sub" data-msg>Start with the email. Everything else resets through it.</p>
		</div>
	</div>
	{
		groups.map((g) => (
			<div class="sck-group">
				<h3 class="sck-gt">
					<span aria-hidden="true">{g.emoji}</span> {g.title}
				</h3>
				<ul>
					{g.items.map((it) => (
						<li>
							<label class="sck-item">
								<input type="checkbox" data-id={it.id} />
								<span class="sck-box" aria-hidden="true" />
								<span class="sck-text">
									<strong>{it.t}</strong>
									<span>{it.d}</span>
									<span class="sck-meta">
										<span class={`sc-tag ${tagClass[it.tag]}`}>{tagText[it.tag]}</span>
										{it.href && (
											<a href={it.href} rel="noopener" target="_blank">
												{it.cta} ↗
											</a>
										)}
									</span>
								</span>
							</label>
						</li>
					))}
				</ul>
			</div>
		))
	}
	<p class="sc-widget__note">Your ticks stay in this browser. Nothing is sent anywhere.</p>
</section>

<style>
	@property --pct {
		syntax: '<number>';
		inherits: true;
		initial-value: 0;
	}
	.sck-head {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 1rem;
		align-items: center;
		margin-bottom: 1.25rem;
	}
	.sck-ring {
		--pct: 0;
		position: relative;
		width: 4.5rem;
		height: 4.5rem;
		border-radius: 50%;
		background:
			radial-gradient(circle, var(--sc-onyx) 54%, transparent 55%),
			conic-gradient(var(--accent) calc(var(--pct) * 1%), rgb(255 255 255 / 0.08) 0);
		transition: --pct var(--sc-dur-slow) var(--sc-ease-settle);
	}
	.sck-num {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.8rem;
		color: var(--sc-silver);
	}
	.sck-num b {
		color: var(--sc-ivory);
		font-size: 1.1rem;
	}
	.sck-sub {
		margin: 0.3rem 0 0;
		font-size: 0.85rem;
		color: var(--sc-silver);
	}
	.sck-group + .sck-group {
		margin-top: 1.25rem;
	}
	.sck-gt {
		margin: 0 0 0.5rem;
		font-family: var(--sc-font-display);
		font-size: 0.98rem;
		color: var(--sc-ivory);
	}
	.sck-group ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.45rem;
	}
	.sck-item {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.75rem;
		padding: 0.8rem 0.85rem;
		border-radius: var(--sc-radius-md);
		border: 1px solid var(--sc-line);
		background: var(--sc-fill-subtle);
		cursor: pointer;
		transition:
			border-color var(--sc-dur-quick),
			background var(--sc-dur-quick);
	}
	.sck-item input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.sck-box {
		width: 1.4rem;
		height: 1.4rem;
		margin-top: 0.05rem;
		clip-path: var(--sc-seal-clip);
		background: var(--sc-slate);
		display: grid;
		place-items: center;
		transition: background var(--sc-dur-quick);
	}
	.sck-box::after {
		content: '';
		width: 0.35rem;
		height: 0.65rem;
		border: solid var(--sc-obsidian);
		border-width: 0 2px 2px 0;
		rotate: 45deg;
		translate: 0 -1px;
		opacity: 0;
		transition: opacity var(--sc-dur-quick);
	}
	.sck-item:has(input:checked) {
		border-color: color-mix(in srgb, var(--accent) 40%, transparent);
		background: color-mix(in srgb, var(--accent) 7%, transparent);
	}
	.sck-item:has(input:checked) .sck-box {
		background: var(--accent);
	}
	.sck-item:has(input:checked) .sck-box::after {
		opacity: 1;
	}
	.sck-item:has(input:focus-visible) {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.sck-text {
		display: grid;
		gap: 0.2rem;
	}
	.sck-text strong {
		color: var(--sc-ivory);
		font-size: 0.95rem;
	}
	.sck-text > span {
		color: var(--sc-silver);
		font-size: 0.86rem;
		line-height: 1.5;
	}
	.sck-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
		margin-top: 0.25rem;
	}
	.sck-meta a {
		font-size: 0.8rem;
		color: var(--sc-ivory);
	}
</style>

<script>
	const KEY = 'sc-security-checklist';
	document.querySelectorAll<HTMLElement>('[data-sck]').forEach((root) => {
		const boxes = [...root.querySelectorAll<HTMLInputElement>('input[data-id]')];
		const ring = root.querySelector<HTMLElement>('.sck-ring')!;
		const done = root.querySelector<HTMLElement>('[data-done]')!;
		const msg = root.querySelector<HTMLElement>('[data-msg]')!;
		let saved: string[] = [];
		try {
			saved = JSON.parse(localStorage.getItem(KEY) || '[]');
		} catch {}
		boxes.forEach((b) => (b.checked = saved.includes(b.dataset.id!)));
		const update = () => {
			const on = boxes.filter((b) => b.checked);
			const pct = Math.round((on.length / boxes.length) * 100);
			ring.style.setProperty('--pct', String(pct));
			done.textContent = String(on.length);
			msg.textContent =
				pct === 100 ? 'Locked down. Re-check every few months, and whenever someone leaves your team.' : pct >= 50 ? 'Over halfway. The rest takes minutes.' : on.length ? 'Good start. Keep going.' : 'Start with the email. Everything else resets through it.';
			try {
				localStorage.setItem(KEY, JSON.stringify(on.map((b) => b.dataset.id)));
			} catch {}
		};
		root.addEventListener('change', update);
		update();
	});
</script>
