---
// Guide header: colored section kicker, title, lead, trust chips, one "Ask AI"
// and one "Share" button (each opens a sheet), and the three-point short version.
import AskAI from './AskAI.astro';
import ShareBar from './ShareBar.astro';
import { personName, CONTRIBUTORS_PATH } from '../data/people';
import Tldr from './Tldr.astro';
import { tldrFor } from '../data/tldr';
import { splitId, t, localize, currentLocale } from '../i18n';
const PAGE_TITLE_ID = '_top'; // Starlight's page title anchor

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as typeof entry.data & {
	status?: string;
	confidence?: string;
	authors?: string[];
	reviewers?: string[];
	lastReviewed?: Date;
	tldr?: string[];
	translation?: { review: 'machine' | 'native' };
};
const locale = currentLocale(Astro);
const L = t(locale);
const { base, locale: entryLocale } = splitId(entry.id);
const section = base.split('/')[0];
const labels = L.sections;
const tldr = tldrFor(entry.id, data.tldr);
const statusText = L.page.status;
const confidenceText = L.page.confidence;
const contributors = localize(locale, CONTRIBUTORS_PATH);
// Translated pages say how they were translated and link the English original.
const translated = entryLocale !== 'en' ? (data.translation?.review ?? 'machine') : undefined;
---

<header class="guide-head" data-section={section}>
	{labels[section] && <p class="kicker"><span class="swatch"></span>{labels[section]}</p>}
	<h1 id={PAGE_TITLE_ID}>{data.title}</h1>
	{data.description && <p class="lead">{data.description}</p>}
	{base !== 'guides' && <ul class="chips">
		{data.status && <li class={`chip status-${data.status}`}>{statusText[data.status]}</li>}
		{data.confidence && <li class="chip">{confidenceText[data.confidence]}</li>}
		{data.authors && data.authors.length > 0 && (
			<li class="chip byline">
				{L.page.by} {data.authors.map((id, i) => <>{i > 0 && ', '}<a href={`${contributors}#${id}`}>{personName(id)}</a></>)}
			</li>
		)}
		{data.reviewers && data.reviewers.length > 0 && (
			<li class="chip byline">
				{L.page.reviewedBy} {data.reviewers.map((id, i) => <>{i > 0 && ', '}<a href={`${contributors}#${id}`}>{personName(id)}</a></>)}
			</li>
		)}
		{section === 'underground' && <li class="chip ember">{L.page.noAffiliates}</li>}
	</ul>}
	{translated && (
		<p class="tr-note" data-review={translated}>
			{translated === 'native' ? L.page.reviewed : L.page.machine} <a href={`/${base}/`} hreflang="en">{L.page.readOriginal}</a>
		</p>
	)}
	{base !== '404' && base !== 'guides' && (
		<div class="actions">
			{<AskAI variant="sheet" mdPath={`/${entry.id}.md`} title={data.title} />}
			<ShareBar title={data.title} description={data.description} section={section} />
		</div>
	)}
	{tldr.length > 0 && <Tldr points={tldr} />}
	<script is:inline define:vars={{ section, hasTldr: tldr.length > 0 }}>
		// Tint the whole page with the section color, without :root:has() (slow on long pages).
		const r = document.documentElement;
		r.dataset.section = section;
		if (hasTldr) r.dataset.tldr = '';
		else delete r.dataset.tldr;
	</script>
</header>

<style>
	.tr-note {
		margin: 0.75rem 0 0;
		font-size: var(--sc-text-sm);
		color: var(--sc-steel);
	}
	.tr-note a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.guide-head {
		position: relative;
		padding-top: 0.5rem;
	}
	.kicker {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		margin: 0 0 0.9rem;
		padding: 0.3rem 0.75rem 0.3rem 0.55rem;
		border-radius: var(--sc-radius-pill);
		background: color-mix(in srgb, var(--accent, #fff) 14%, transparent);
		font-size: var(--sc-text-sm);
		font-weight: 600;
		color: var(--accent, var(--sc-steel));
	}
	.swatch {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent, var(--sc-steel));
		box-shadow: 0 0 12px var(--accent, transparent);
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 2.9rem);
		line-height: 1.05;
		font-family: var(--sc-font-display);
		letter-spacing: -0.02em;
		font-weight: 700;
		color: var(--sc-ivory);
	}
	.lead {
		margin: 0.9rem 0 0;
		max-width: 40rem;
		font-size: var(--sc-text-lg);
		line-height: 1.55;
		color: var(--sc-silver);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.chip {
		margin: 0;
		padding: 0.15rem 0.6rem;
		border-radius: var(--sc-radius-pill);
		border: 1px solid var(--sc-line-strong);
		font-size: var(--sc-text-xs);
		font-weight: 500;
		letter-spacing: 0;
		color: var(--sc-silver);
	}
	.status-published {
		color: var(--sc-jade);
		border-color: color-mix(in srgb, var(--sc-jade) 45%, transparent);
	}
	.byline a {
		color: var(--sc-ivory);
		text-decoration: none;
		font-weight: 600;
	}
	.byline a:hover {
		text-decoration: underline;
	}
	.actions {
		display: flex;
		gap: 0.5rem;
		margin-top: 1.1rem;
	}
	.ember {
		color: var(--sc-ember);
		border-color: color-mix(in srgb, var(--sc-ember) 45%, transparent);
	}
</style>
