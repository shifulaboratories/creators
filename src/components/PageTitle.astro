---
// Guide header: colored section kicker, title, lead, trust chips, one "Ask AI"
// and one "Share" button (each opens a sheet), and the three-point short version.
import AskAI from './AskAI.astro';
import ShareBar from './ShareBar.astro';
import { personName, CONTRIBUTORS_PATH } from '../data/people';
import Tldr from './Tldr.astro';
import DoThis from './guide/DoThis.astro';
import LibraryButton from './LibraryButton.astro';
import { isGuideId } from '../lib/library';
import { toolBySlug } from '../lib/free-tools';
import { tldrFor } from '../data/tldr';
import { NEWS_PLATFORM_INFO, getNews, newsPath, fmtDate, isoDate } from '../lib/news';
import { splitId, t, localize, currentLocale } from '../i18n';
const PAGE_TITLE_ID = '_top'; // Starlight's page title anchor

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as typeof entry.data & {
	status?: string;
	confidence?: string;
	authors?: string[];
	reviewers?: string[];
	lastReviewed?: Date;
	tldr?: string[];
	news?: { platform: string; announced: Date; published: Date; updated?: Date; confirmed: 'official' | 'reported' };
	payoff?: string;
	moves?: { do: string; why: string; source?: string }[];
	translation?: { review: 'machine' | 'native' };
};
const locale = currentLocale(Astro);
const L = t(locale);
// Translated pages ("es/paywall/fanfix") work from the English id for sections, saving and progress.
const { base, locale: entryLocale } = splitId(entry.id);
const contributors = localize(locale, CONTRIBUTORS_PATH);
// Translated pages say how they were translated and link the English original.
const translated = entryLocale !== 'en' ? (data.translation?.review ?? 'machine') : undefined;
const news = data.news;
const newsPlatform = news ? NEWS_PLATFORM_INFO[news.platform] : undefined;
// Platform guides and platform news pages link to that platform's latest update.
const [s0, s1] = base.split('/');
const latestFor = !news && ((s0 === 'platforms' || s0 === 'news') && s1 && NEWS_PLATFORM_INFO[s1] && !base.split('/')[2]) ? s1 : undefined;
const latest = s0 === 'platforms' && latestFor ? (await getNews(latestFor))[0] : undefined;
const section = base.split('/')[0];
// Tool pages keep a long, searchable <title> but show the tool's short name as the heading.
const tool = section === 'tools' ? toolBySlug(base.split('/')[1] ?? '') : undefined;
const labels = L.sections;
const isGuide = isGuideId(base);
const moves = data.moves ?? [];
const tldr = moves.length > 0 ? [] : tldrFor(entry.id, data.tldr);
// Read time covers the main read only: imports, tags and the folded-away
// details (<DeepDive>) don't count. 220 words a minute.
const mainText = (entry.body ?? '')
	.split(/<DeepDive[\s>]/)[0]
	.replace(/^import .*$/gm, '')
	.replace(/<[^>]+>/g, ' ')
	.replace(/[#*_`|>\-]+/g, ' ');
const words = mainText.split(/\s+/).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / 220));
const showTime = data.status !== 'outline' && !['guides', '404'].includes(base) && minutes >= 2;
const statusText = L.page.status;
// Pages built in src/pages/ with their own header content: no chips, Ask AI or Share.
const bare = ['guides', 'roadmap', 'changelog'].includes(base);
const confidenceText = L.page.confidence;
---

<header class="guide-head" data-section={section}>
	{labels[section] && <p class="kicker"><span class="swatch"></span>{news && newsPlatform ? <><a href="/news/">News</a><span aria-hidden="true">·</span><a href={`/news/${news.platform}/`}>{newsPlatform.name}</a></> : labels[section]}</p>}
	<h1 id={PAGE_TITLE_ID}>{tool?.name ?? data.title}</h1>
	{(data.payoff || data.description) && <p class={data.payoff ? 'lead payoff' : 'lead'}>{data.payoff ?? data.description}</p>}
	{news && <ul class="chips">
		<li class="chip">Announced <time datetime={isoDate(news.announced)}>{fmtDate(news.announced)}</time></li>
		{news.confirmed === 'official' ? <li class="chip status-published">Official</li> : <li class="chip brass">Reported</li>}
		{news.updated && news.updated.getTime() !== news.published.getTime() && <li class="chip">Updated {fmtDate(news.updated)}</li>}
	</ul>}
	{!bare && !news && section !== 'news' && <ul class="chips">
		{!tool && showTime && <li class="chip time">{L.page.minRead(minutes)}</li>}
		{!tool && data.status && data.status !== "draft" && <li class={`chip status-${data.status}`}>{statusText[data.status]}</li>}
		{!tool && data.confidence && <li class="chip">{confidenceText[data.confidence]}</li>}
		{data.authors && data.authors.length > 0 && (
			<li class="chip byline">
				{L.page.by} {data.authors.map((id, i) => <>{i > 0 && ', '}<a href={`${contributors}#${id}`}>{personName(id)}</a></>)}
			</li>
		)}
		{data.reviewers && data.reviewers.length > 0 && (
			<li class="chip byline">
				{L.page.reviewedBy} {data.reviewers.map((id, i) => <>{i > 0 && ', '}<a href={`${contributors}#${id}`}>{personName(id)}</a></>)}
			</li>
		)}
		{section === 'underground' && <li class="chip ember">{L.page.noAffiliates}</li>}
		{section === 'tools' && base !== 'tools' && <><li class="chip status-published">Free</li><li class="chip">No signup</li><li class="chip">Private</li></>}
	</ul>}
	{translated && (
		<p class="tr-note" data-review={translated}>
			{translated === 'native' ? L.page.reviewed : L.page.machine} <a href={`/${base}/`} hreflang="en">{L.page.readOriginal}</a>
		</p>
	)}
	{base !== '404' && !bare && (
		<div class="actions">
			<AskAI variant="sheet" mdPath={`/${entry.id}.md`} title={data.title} />
			<ShareBar title={data.title} description={data.description} section={section} />
			{isGuide && <LibraryButton kind="save" id={base} title={data.title} section={section} />}
		</div>
	)}
	{moves.length > 0 && <DoThis moves={moves} />}
	{tldr.length > 0 && <Tldr points={tldr} />}
	{latest && (
		<a class="latest" href={newsPath(latest)}>
			<span class="latest__k">{L.page.latest} · {fmtDate(latest.data.announced)}</span>
			<span class="latest__t">{latest.data.title}</span>
		</a>
	)}
	<script is:inline define:vars={{ section, hasTldr: tldr.length > 0 || moves.length > 0 }}>
		// Tint the whole page with the section color, without :root:has() (slow on long pages).
		const r = document.documentElement;
		r.dataset.section = section;
		if (hasTldr) r.dataset.tldr = '';
		else delete r.dataset.tldr;
	</script>
	<script>
		// Check off finished guides in the sidebar (stored on this device only).
		import { markLinks, onChange } from '../scripts/library';
		markLinks();
		onChange(() => markLinks());

		// Wide tables scroll sideways on phones. Let keyboard users focus them
		// so the arrow keys can scroll (WCAG 2.1.1).
		const focusWideTables = () => {
			for (const t of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table:not([tabindex])')) {
				if (t.scrollWidth > t.clientWidth + 1) {
					t.tabIndex = 0;
					t.setAttribute('aria-label', t.querySelector('th')?.textContent?.trim() ? `Table: ${t.querySelector('th')!.textContent!.trim()}` : 'Table');
				}
			}
		};
		focusWideTables();
		addEventListener('resize', focusWideTables, { passive: true });
	</script>
</header>

<style>
	.tr-note {
		margin: 0.75rem 0 0;
		font-size: var(--sc-text-sm);
		color: var(--sc-steel);
	}
	.tr-note a {
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.guide-head {
		position: relative;
		padding-top: 0.5rem;
	}
	.kicker {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: fit-content;
		margin: 0 0 0.9rem;
		padding: 0.3rem 0.75rem 0.3rem 0.55rem;
		border-radius: var(--sc-radius-pill);
		background: color-mix(in srgb, var(--accent, #fff) 14%, transparent);
		font-size: var(--sc-text-sm);
		font-weight: 600;
		color: var(--accent, var(--sc-steel));
	}
	.swatch {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--accent, var(--sc-steel));
		box-shadow: 0 0 12px var(--accent, transparent);
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 2.9rem);
		line-height: 1.05;
		font-family: var(--sc-font-display);
		letter-spacing: -0.02em;
		font-weight: 700;
		color: var(--sc-ivory);
	}
	.lead {
		margin: 0.9rem 0 0;
		max-width: 40rem;
		font-size: var(--sc-text-lg);
		line-height: 1.55;
		color: var(--sc-silver);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.chip {
		margin: 0;
		padding: 0.15rem 0.6rem;
		border-radius: var(--sc-radius-pill);
		border: 1px solid var(--sc-line-strong);
		font-size: var(--sc-text-xs);
		font-weight: 500;
		letter-spacing: 0;
		color: var(--sc-silver);
	}
	.payoff {
		color: var(--sc-platinum);
	}
	.time {
		color: var(--sc-ivory);
		border-color: var(--sc-line-bright);
	}
	.status-published {
		color: var(--sc-jade);
		border-color: color-mix(in srgb, var(--sc-jade) 45%, transparent);
	}
	.byline a {
		color: var(--sc-ivory);
		text-decoration: none;
		font-weight: 600;
	}
	.byline a:hover {
		text-decoration: underline;
	}
	.actions {
		display: flex;
		flex-wrap: wrap; /* longer Spanish and Portuguese labels wrap instead of getting cut off */
		gap: 0.5rem;
		margin-top: 1.1rem;
	}
	.kicker a {
		color: inherit;
		text-decoration: none;
	}
	.kicker a:hover {
		text-decoration: underline;
	}
	.brass {
		color: var(--sc-brass);
		border-color: color-mix(in srgb, var(--sc-brass) 45%, transparent);
	}
	.latest {
		display: grid;
		gap: 0.1rem;
		max-width: 40rem;
		margin-top: 0.9rem;
		padding: 0.6rem 0.9rem;
		font-size: var(--sc-text-sm);
		border-radius: 14px;
		border: 1px solid var(--sc-line-strong);
		text-decoration: none;
		color: inherit;
	}
	.latest:hover {
		background: var(--sc-fill-muted);
	}
	.latest__k {
		font-size: var(--sc-text-xs);
		color: var(--sc-lime);
		font-weight: 600;
	}
	.latest__t {
		color: var(--sc-ivory);
		font-weight: 600;
	}
	.ember {
		color: var(--sc-ember);
		border-color: color-mix(in srgb, var(--sc-ember) 45%, transparent);
	}
</style>
