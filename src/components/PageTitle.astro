---
// Guide header: colored section kicker, title, lead, and trust chips.
const PAGE_TITLE_ID = '_top'; // Starlight's page title anchor

const { entry } = Astro.locals.starlightRoute;
const data = entry.data as typeof entry.data & {
	status?: string;
	confidence?: string;
	authors?: string[];
	lastReviewed?: Date;
};
const section = entry.id.split('/')[0];
const labels: Record<string, string> = {
	grow: 'Grow',
	earn: 'Earn',
	deals: 'Deals and contracts',
	team: 'Team',
	stack: 'Stack',
	protect: 'Protect',
	underground: 'Underground',
	news: 'News',
	algorithms: 'How algorithms work',
	'case-studies': 'Case studies',
	platforms: 'Platforms',
	goldmines: 'Goldmines',
	about: 'About',
};
const statusText: Record<string, string> = { outline: 'Outline', draft: 'Draft', published: 'Reviewed' };
const confidenceText: Record<string, string> = {
	verified: 'Verified',
	'practitioner-view': 'Practitioner view',
	speculative: 'Speculative',
};
---

<header class="guide-head" data-section={section}>
	{labels[section] && <p class="kicker"><span class="swatch"></span>{labels[section]}</p>}
	<h1 id={PAGE_TITLE_ID}>{data.title}</h1>
	{data.description && <p class="lead">{data.description}</p>}
	<ul class="chips">
		{data.status && <li class={`chip status-${data.status}`}>{statusText[data.status]}</li>}
		{data.confidence && <li class="chip">{confidenceText[data.confidence]}</li>}
		{data.authors && data.authors.length > 0 && <li class="chip">By {data.authors.join(', ')}</li>}
		{section === 'underground' && <li class="chip ember">No affiliate links</li>}
	</ul>
</header>

<style>
	.guide-head {
		position: relative;
		padding-top: 0.5rem;
	}
	.kicker {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 0.75rem;
		font-family: var(--sc-font-mono);
		font-size: var(--sc-text-xs);
		letter-spacing: var(--sc-tracking-caps);
		text-transform: uppercase;
		color: var(--accent, var(--sc-steel));
	}
	.swatch {
		width: 8px;
		height: 8px;
		border-radius: 2px;
		background: var(--accent, var(--sc-steel));
		box-shadow: 0 0 12px var(--accent, transparent);
	}
	h1 {
		margin: 0;
		font-size: clamp(2rem, 6vw, 2.9rem);
		line-height: 1.05;
		letter-spacing: -0.035em;
		font-weight: 600;
		color: var(--sc-ivory);
	}
	.lead {
		margin: 0.9rem 0 0;
		max-width: 40rem;
		font-size: var(--sc-text-lg);
		line-height: 1.55;
		color: var(--sc-silver);
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 1.1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.chip {
		margin: 0;
		padding: 0.15rem 0.6rem;
		border-radius: var(--sc-radius-pill);
		border: 1px solid var(--sc-line-strong);
		font-family: var(--sc-font-mono);
		font-size: var(--sc-text-2xs);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sc-silver);
	}
	.status-published {
		color: var(--sc-jade);
		border-color: color-mix(in srgb, var(--sc-jade) 45%, transparent);
	}
	.ember {
		color: var(--sc-ember);
		border-color: color-mix(in srgb, var(--sc-ember) 45%, transparent);
	}
</style>
