---
/**
 * The Guides page: one big search box, then two calm blocks (platforms, topics).
 * Typing replaces both blocks with results: instant matches on titles and
 * summaries, then full-text hits from Pagefind after three letters.
 * Enter opens the top result. ?q= and ?s= make any view shareable, and the
 * home page's SearchAction points here.
 */
import { getCollection } from 'astro:content';
import { siFacebook, siInstagram, siTiktok, siX, siYoutube } from 'simple-icons';
import { SECTION_LABELS } from '../lib/share';
import { currentLocale, t, withFallback, localize, sectionLabel } from '../i18n';
import { sortedTerms, termPath } from '../lib/glossary';
import { topicIcons } from '../data/topic-icons';

const locale = currentLocale(Astro);
const L = t(locale).gallery;
const LB = t(locale).library;
// Spanish and Portuguese show the translation where there is one, else the English guide.
// Ids stay the English ones ("paywall/fanfix") so saved guides and progress carry across languages.
const all = withFallback(await getCollection('docs'), locale);
const docs = all.map((d) => d.entry);
const info = new Map(all.map((d) => [d.entry, d]));
const idOf = (e: (typeof docs)[number]) => info.get(e)!.base;
const has = (id: string) => all.some((e) => e.base === id);
const prefix = locale === 'en' ? '' : `/${locale}`;

type Topic = { id: string; title: string; text: string };
const topicsEn: Topic[] = [
	{ id: 'algorithms', title: 'How algorithms work', text: 'What feeds reward, from the platforms’ own research' },
	{ id: 'grow', title: 'Grow', text: 'Niche, hooks, formats, cadence and analytics' },
	{ id: 'strategy', title: 'Strategy', text: 'Clipping, fan pages and why one viral post rarely sells' },
	{ id: 'paywall', title: 'Paywall', text: 'Fanfix, OnlyFans, Patreon, Fanvue and chatting agencies' },
	{ id: 'deals', title: 'Brand deals', text: 'Agencies, commissions, pricing, negotiating, contracts' },
	{ id: 'earn', title: 'Earn', text: 'Every income stream and what it really pays' },
	{ id: 'rates', title: 'Creator rates', text: 'What creators charge, by platform and follower count' },
	{ id: 'reviews', title: 'Tool reviews', text: 'Stan, Beacons, Linktree and more, with their real fees' },
	{ id: 'tools', title: 'Free tools', text: 'Media kit, invoice, rate, engagement and tax calculators' },
	{ id: 'money', title: 'Money basics', text: 'Taxes, set-asides, LLC vs S corp, banking' },
	{ id: 'team', title: 'Team', text: 'Managers, agents, lawyers and first hires' },
	{ id: 'protect', title: 'Protect', text: 'Hacked, banned, impersonated or scammed' },
	{ id: 'case-studies', title: 'Case studies', text: 'How top creators grew, in their own words' },
	{ id: 'stack', title: 'Stack', text: 'Gear and software at every budget' },
	{ id: 'underground', title: 'Underground', text: 'Gray markets, reported as journalism' },
	{ id: 'shortlist', title: 'The Shortlist', text: 'The few resources worth your time' },
];
const topics = topicsEn.map((tp) => {
	const tr = L.topicText[tp.id];
	return tr ? { ...tp, title: tr[0], text: tr[1] } : tp;
});

const guides = docs.filter((e) => {
	const id = idOf(e);
	return id.includes('/') && !id.endsWith('/index') && SECTION_LABELS[id.split('/')[0]] && !id.startsWith('about/');
});
const count = (s: string) => guides.filter((e) => idOf(e).startsWith(s + '/')).length;
const liveTopics = topics.filter((t) => has(t.id) || count(t.id) > 0).map((t) => ({ ...t, n: count(t.id) }));

type Plat = { key: string; name: string; path?: string; href: string };
const platforms: Plat[] = [
	{ key: 'general', name: L.general, href: '/algorithms/' },
	{ key: 'instagram', name: 'Instagram', path: siInstagram.path, href: '/platforms/instagram/' },
	{ key: 'tiktok', name: 'TikTok', path: siTiktok.path, href: '/platforms/tiktok/' },
	{ key: 'youtube', name: 'YouTube', path: siYoutube.path, href: '/platforms/youtube/' },
	{ key: 'facebook', name: 'Facebook', path: siFacebook.path, href: '/platforms/facebook/' },
	{ key: 'linkedin', name: 'LinkedIn', href: '/platforms/linkedin/' },
	{ key: 'x', name: 'X', path: siX.path, href: '/platforms/x/' },
]
	.filter((p) => p.key === 'general' || has(p.href.slice(1, -1)))
	.map((p) => ({ ...p, href: localize(locale, p.href) }));

const order = ['algorithms', 'platforms', 'grow', 'strategy', 'paywall', 'deals', 'earn', 'rates', 'tools', 'reviews', 'money', 'team', 'protect', 'case-studies', 'stack', 'underground', 'shortlist', 'news'];
const rows = guides
	.map((e) => {
		const id = idOf(e);
		const translated = info.get(e)!.translated;
		const section = id.split('/')[0];
		const words = (e.body ?? '').replace(/<[^>]+>|import .*|[#*_`>|-]/g, ' ').split(/\s+/).filter(Boolean).length;
		return {
			id,
			href: localize(locale, `/${id}/`),
			translated,
			section,
			label: sectionLabel(section, locale)!,
			title: e.data.title,
			description: e.data.description ?? '',
			minutes: Math.max(1, Math.round(words / 220)),
			rank: (order.indexOf(section) + 1 || 99) * 100 + (e.data.sidebar?.order ?? 50),
		};
	})
	.sort((a, b) => a.rank - b.rank);

// Glossary terms join instant search results, after the guides.
const termRows = sortedTerms.map((t, i) => ({
	id: `glossary/${t.slug}`,
	href: termPath(t.slug),
	title: t.term,
	text: [t.term, t.full, ...(t.aka ?? []), t.short].join(' '),
	description: t.short,
	rank: 9000 + i,
}));
const lookup = Object.fromEntries(rows.map((r) => [r.id, [r.title, r.label, r.section, r.minutes]]));
const totals = Object.fromEntries(liveTopics.map((t) => [t.id, t.n]));

const suggestions = L.suggestions;
---

<div
	class="gi not-content"
	data-gi
	data-prefix={prefix}
	data-count-one={L.count(1, '{q}')}
	data-count-many={L.count(2, '{q}').replace('2', '{n}')}
	data-ask-prompt={L.askPrompt('{origin}', '{q}')}
	data-min={L.min}
	data-clear-label={LB.clear}
	data-clear-confirm={LB.clearConfirm}
	data-remove={LB.remove}
	data-n-of-done={LB.nOfDone}
>
	<form class="gi-search" role="search" action={localize(locale, '/guides/')} data-form>
		<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
		<input
			type="search"
			name="q"
			placeholder={L.search(rows.length)}
			aria-label={L.searchLabel}
			autocomplete="off"
			spellcheck="false"
			enterkeyhint="search"
			data-q
		/>
		<kbd aria-hidden="true">/</kbd>
	</form>
	<p class="gi-try" data-try>
		{L.try}
		{
			suggestions.map((s) => (
				<button type="button" data-suggest={s}>
					{s}
				</button>
			))
		}
	</p>

	<!-- Browse (hidden while searching) -->
	<div data-browse>
		<section class="gi-block gi-mine" id="mine" aria-labelledby="gi-mine" data-mine data-rows={JSON.stringify(lookup)} data-total={rows.length} hidden>
			<div class="gi-mine-head">
				<h2 id="gi-mine">{LB.mine}</h2>
				<span class="gi-local">{LB.local}</span>
			</div>
			<div class="gi-progress" data-progress>
				<p><strong data-done-n>0</strong> {LB.doneOf(rows.length)}</p>
				<span class="bar" aria-hidden="true"><span data-bar></span></span>
			</div>
			<a class="gi-resume" href="#" data-resume hidden>
				<span class="eyebrow">{LB.resume}</span>
				<strong data-resume-title></strong>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
			</a>
			<h3 class="gi-sub" data-saved-head>{LB.savedHead}</h3>
			<ul class="gi-saved" data-saved data-lib-mark></ul>
			<p class="gi-hint" data-saved-empty hidden>{LB.empty}</p>
			<button type="button" class="gi-clear" data-clear>{LB.clear}</button>
		</section>
		<section class="gi-block" aria-labelledby="gi-plat">
			<h2 id="gi-plat">{L.platforms}</h2>
			<ul class="gi-plats">
				{
					platforms.map((p) => (
						<li>
							<a href={p.href} data-section={p.key === 'general' ? 'algorithms' : p.key}>
								<span class="ic" aria-hidden="true">
									{p.path ? (
										<svg viewBox="0 0 24 24">
											<path d={p.path} />
										</svg>
									) : p.key === 'linkedin' ? (
										<b>in</b>
									) : (
										<svg viewBox="0 0 24 24">
											<path d="M12 3c.5 4 2.5 6 6.5 6.5-4 .5-6 2.5-6.5 6.5-.5-4-2.5-6-6.5-6.5C9.5 9 11.5 7 12 3z" />
										</svg>
									)}
								</span>
								{p.name}
							</a>
						</li>
					))
				}
			</ul>
			<a class="gi-more" href={localize(locale, '/platforms/')}>{L.morePlatforms}</a>
		</section>

		<section class="gi-block" aria-labelledby="gi-topics">
			<h2 id="gi-topics">{L.topics}</h2>
			<ul class="gi-topics" data-totals={JSON.stringify(totals)}>
				{
					liveTopics.map((t) => (
						<li>
							<a href={localize(locale, `/${t.id}/`)} data-section={t.id}>
								<span class="ti" aria-hidden="true">
									<svg viewBox="0 0 24 24">
										<path d={topicIcons[t.id] ?? topicIcons.shortlist} />
									</svg>
								</span>
								<span class="txt">
									<strong>{t.title}</strong>
									<span>{t.text}</span>
								</span>
								<span class="n" data-topic-n={t.id}>{t.n}</span>
							</a>
						</li>
					))
				}
				<li>
					<a href="/glossary/" data-section="glossary">
						<span class="ti" aria-hidden="true">
							<svg viewBox="0 0 24 24">
								<path d={topicIcons.glossary} />
							</svg>
						</span>
						<span class="txt">
							<strong>Glossary</strong>
							<span>CPM, RPM, usage rights and every term in plain English</span>
						</span>
						<span class="n">{sortedTerms.length}</span>
					</a>
				</li>
			</ul>
		</section>

		<details class="gi-all">
			<summary>{L.browseAll(rows.length)}</summary>
			<ol class="gi-list" data-lib-mark>
				{
					rows.map((r) => (
						<li>
							<a href={r.href} data-section={r.section}>
								<strong>{r.title}<span class="lib-tick" role="img" aria-label="done" /></strong>
								<span class="meta">
									<span class="dot" aria-hidden="true" />
									{r.label} · {r.minutes} {L.min}{!r.translated && <> · <abbr title={t(locale).grid.english}>{L.english}</abbr></>}
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</details>
	</div>

	<!-- Results (shown while searching) -->
	<div class="gi-results" data-results hidden>
		<p class="gi-count" aria-live="polite" data-count></p>
		<ol class="gi-list" data-list data-lib-mark>
			{
				rows.map((r) => (
					<li
						data-id={r.id}
						data-title={r.title.toLowerCase()}
						data-text={`${r.title} ${r.description} ${r.label}`.toLowerCase()}
						data-rank={r.rank}
						hidden
					>
						<a href={r.href} data-section={r.section}>
							<strong>{r.title}<span class="lib-tick" role="img" aria-label="done" /></strong>
							<span class="desc">{r.description}</span>
							<span class="hit" data-hit hidden />
							<span class="meta">
								<span class="dot" aria-hidden="true" />
								{r.label} · {r.minutes} {L.min}{!r.translated && <> · <abbr title={t(locale).grid.english}>{L.english}</abbr></>}
							</span>
						</a>
					</li>
				))
			}
			{
				termRows.map((r) => (
					<li data-id={r.id} data-title={r.title.toLowerCase()} data-text={`${r.text} glossary`.toLowerCase()} data-rank={r.rank} hidden>
						<a href={r.href} data-section="glossary" hreflang={locale === 'en' ? undefined : 'en'}>
							<strong>{r.title}</strong>
							<span class="desc">{r.description}</span>
							<span class="hit" data-hit hidden />
							<span class="meta">
								<span class="dot" aria-hidden="true" />
								{sectionLabel('glossary', locale)}{locale !== 'en' && ' · EN'}
							</span>
						</a>
					</li>
				))
			}
		</ol>
		<div class="gi-empty" data-empty hidden>
			<p>{L.none}</p>
			<a data-ask href="https://claude.ai/new" target="_blank" rel="noopener">{L.askClaude}</a>
		</div>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-gi]');
	if (root) {
		const form = root.querySelector<HTMLFormElement>('[data-form]')!;
		const q = root.querySelector<HTMLInputElement>('[data-q]')!;
		const browse = root.querySelector<HTMLElement>('[data-browse]')!;
		const tryRow = root.querySelector<HTMLElement>('[data-try]')!;
		const results = root.querySelector<HTMLElement>('[data-results]')!;
		const list = root.querySelector<HTMLElement>('[data-list]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const ask = root.querySelector<HTMLAnchorElement>('[data-ask]')!;
		const items = [...list.querySelectorAll<HTMLElement>('li')];
		let ft = new Map<string, string>();
		let token = 0;
		let pf: any = null;

		const loadPf = async () => {
			if (pf !== null) return pf;
			try {
				const url = '/pagefind/pagefind.js';
				pf = await import(/* @vite-ignore */ url);
				await pf.options?.({ excerptLength: 16 });
			} catch {
				pf = false;
			}
			return pf;
		};
		const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');

		const render = () => {
			const raw = q.value.trim();
			const terms = norm(raw).split(/\s+/).filter(Boolean);
			const active = terms.length > 0;
			browse.hidden = active;
			tryRow.hidden = active;
			results.hidden = !active;
			const p = new URLSearchParams(location.search);
			if (raw) p.set('q', raw);
			else p.delete('q');
			history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
			if (!active) return;

			const scored = items
				.map((el) => {
					const title = el.dataset.title!;
					const text = el.dataset.text!;
					let s = 0;
					let direct = true;
					for (const w of terms) {
						if (title.includes(w)) s += 3;
						else if (text.includes(w)) s += 1;
						else if (!ft.has(el.dataset.id!)) return { el, s: 0, direct: false };
						else direct = false;
					}
					if (ft.has(el.dataset.id!)) s += 1;
					return { el, s, direct };
				})
				.filter((x) => x.s > 0)
				.sort((a, b) => b.s - a.s || +a.el.dataset.rank! - +b.el.dataset.rank!);
			const show = new Map(scored.map((x) => [x.el, x.direct]));
			for (const el of items) {
				el.hidden = !show.has(el);
				const hit = el.querySelector<HTMLElement>('[data-hit]')!;
				// Only show the full-text snippet when the match is in the body, not the title or summary.
				const ex = show.get(el) === false ? ft.get(el.dataset.id!) : undefined;
				hit.hidden = !ex;
				if (ex) hit.innerHTML = `…${ex}…`;
			}
			scored.forEach(({ el }) => list.appendChild(el));
			count.textContent = (scored.length === 1 ? root.dataset.countOne! : root.dataset.countMany!).replace('{n}', String(scored.length)).replace('{q}', raw);
			empty.hidden = scored.length > 0;
			ask.href = 'https://claude.ai/new?q=' + encodeURIComponent(root.dataset.askPrompt!.replace('{origin}', location.origin).replace('{q}', raw));
		};

		const fullText = async () => {
			const value = q.value.trim();
			const t = ++token;
			if (value.length < 3) {
				ft = new Map();
				return;
			}
			const api = await loadPf();
			if (!api) return;
			const res = await api.debouncedSearch(value, {}, 160);
			if (!res || t !== token) return;
			const data = await Promise.all(res.results.slice(0, 30).map((r: any) => r.data()));
			// Pagefind URLs carry the language prefix (/es/...); rows are keyed by the English id.
			ft = new Map(data.map((d: any) => [d.url.replace(/^\/(es|pt-br)\//, '/').replace(/^\/|\/$/g, ''), d.excerpt]));
			render();
		};

		q.addEventListener('input', () => {
			render();
			fullText();
		});
		q.addEventListener('focus', () => loadPf(), { once: true });
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const first = items.find((el) => !el.hidden);
			if (first && q.value.trim()) location.href = first.querySelector('a')!.href;
		});
		root.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) =>
			b.addEventListener('click', () => {
				q.value = b.dataset.suggest!;
				q.focus();
				render();
				fullText();
			}),
		);
		addEventListener('keydown', (e) => {
			if (e.key === '/' && !(e.target as HTMLElement).closest('input,textarea,[contenteditable]')) {
				e.preventDefault();
				q.focus();
			}
			if (e.key === 'Escape' && document.activeElement === q && q.value) {
				q.value = '';
				render();
			}
		});

		const params = new URLSearchParams(location.search);
		const initial = params.get('q');
		if (params.has('focus') && !initial) q.focus({ preventScroll: true });
		if (initial) {
			q.value = initial;
			render();
			fullText();
		}
	}
</script>

<script>
	// "My guides": saved guides, done count and where you left off (this device only).
	import { read, toggle, clear, onChange, markLinks } from '../scripts/library';

	const mine = document.querySelector<HTMLElement>('[data-mine]');
	if (mine) {
		const rows: Record<string, [string, string, string, number]> = JSON.parse(mine.dataset.rows!);
		const gi = document.querySelector<HTMLElement>('[data-gi]')!.dataset;
		const pre = gi.prefix ?? '';
		const total = +mine.dataset.total!;
		const $ = <T extends HTMLElement>(s: string) => mine.querySelector<T>(s)!;
		const savedList = $('[data-saved]');
		const resume = $<HTMLAnchorElement>('[data-resume]');
		const topics = document.querySelector<HTMLElement>('[data-totals]');
		const totals: Record<string, number> = topics ? JSON.parse(topics.dataset.totals!) : {};
		const esc = (t: string) => t.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);

		const render = () => {
			const lib = read();
			const done = Object.keys(lib.done).filter((id) => rows[id]);
			const saved = Object.entries(lib.saved).sort((a, b) => b[1].at - a[1].at);
			const last = lib.last && rows[lib.last.id] && !lib.done[lib.last.id] && !lib.saved[lib.last.id] ? lib.last : undefined;
			const any = done.length + saved.length > 0 || !!last;
			mine.hidden = !any && location.hash !== '#mine';

			$('[data-done-n]').textContent = String(done.length);
			$('[data-bar]').style.width = `${Math.min(100, (done.length / Math.max(1, total)) * 100)}%`;
			$('[data-progress]').hidden = done.length === 0;

			resume.hidden = !last;
			if (last) {
				resume.href = `${pre}/${last.id}/`;
				resume.dataset.section = last.section;
				$('[data-resume-title]').textContent = rows[last.id][0];
			}

			$('[data-saved-head]').hidden = saved.length === 0;
			$('[data-saved-empty]').hidden = saved.length > 0;
			$('[data-clear]').hidden = !any;
			savedList.innerHTML = saved
				.map(([id, e]) => {
					const r = rows[id];
					const title = r ? r[0] : e.title;
					const meta = r ? `${r[1]} · ${r[3]} ${gi.min ?? 'min'}` : '';
					return `<li><a href="${pre}/${id}/" data-section="${esc(r ? r[2] : e.section)}"><span class="dot" aria-hidden="true"></span><strong>${esc(title)}<span class="lib-tick" role="img" aria-label="done"></span></strong><span class="meta">${esc(meta)}</span></a><button type="button" class="rm" data-rm="${esc(id)}" aria-label="${esc(gi.remove ?? 'Remove')}: ${esc(title)}">×</button></li>`;
				})
				.join('');

			// "2/9" on topic tiles once you've finished something there.
			document.querySelectorAll<HTMLElement>('[data-topic-n]').forEach((el) => {
				const t = el.dataset.topicN!;
				const n = done.filter((id) => id.startsWith(t + '/')).length;
				el.textContent = n ? `${n}/${totals[t]}` : String(totals[t]);
				el.classList.toggle('has-done', n > 0);
				el.title = n ? (gi.nOfDone ?? '{n} of {t} done').replace('{n}', String(n)).replace('{t}', String(totals[t])) : '';
			});
			markLinks();
		};

		savedList.addEventListener('click', (e) => {
			const b = (e.target as Element).closest<HTMLButtonElement>('[data-rm]');
			if (!b) return;
			const e2 = read().saved[b.dataset.rm!];
			if (e2) toggle('saved', b.dataset.rm!, e2, false);
		});
		$('[data-clear]').addEventListener('click', () => {
			if ($('[data-clear]').dataset.armed) return clear();
			const b = $('[data-clear]');
			b.dataset.armed = '1';
			b.textContent = gi.clearConfirm ?? 'Tap again to clear saved guides and progress';
			setTimeout(() => {
				delete b.dataset.armed;
				b.textContent = gi.clearLabel ?? 'Clear my guides';
			}, 4000);
		});
		onChange(render);
		render();
		if (location.hash === '#mine') mine.scrollIntoView();
	}
</script>

<style>
	.gi [hidden] {
		display: none !important;
	}
	.gi {
		--gi-r: 16px;
		margin-top: 0.25rem;
	}

	/* Search */
	.gi-search {
