---
/**
 * The Guides page: one big search box, then two calm blocks (platforms, topics).
 * Typing replaces both blocks with results: instant matches on titles and
 * summaries, then full-text hits from Pagefind after three letters.
 * Enter opens the top result. ?q= and ?s= make any view shareable, and the
 * home page's SearchAction points here.
 */
import { getCollection } from 'astro:content';
import { siFacebook, siInstagram, siTiktok, siX, siYoutube } from 'simple-icons';
import { SECTION_LABELS } from '../lib/share';

const docs = await getCollection('docs');
const has = (id: string) => docs.some((e) => e.id === id);

type Topic = { id: string; title: string; text: string };
const topics: Topic[] = [
	{ id: 'algorithms', title: 'How algorithms work', text: 'What feeds reward, from the platforms’ own research' },
	{ id: 'grow', title: 'Grow', text: 'Niche, hooks, formats, cadence and analytics' },
	{ id: 'paywall', title: 'Paywall', text: 'Fanfix, OnlyFans, Patreon, Fanvue and chatting agencies' },
	{ id: 'deals', title: 'Brand deals', text: 'Agencies, commissions, pricing, negotiating, contracts' },
	{ id: 'earn', title: 'Earn', text: 'Every income stream and what it really pays' },
	{ id: 'money', title: 'Money basics', text: 'Taxes, set-asides, LLC vs S corp, banking' },
	{ id: 'team', title: 'Team', text: 'Managers, agents, lawyers and first hires' },
	{ id: 'protect', title: 'Protect', text: 'Hacked, banned, impersonated or scammed' },
	{ id: 'case-studies', title: 'Case studies', text: 'How top creators grew, in their own words' },
	{ id: 'stack', title: 'Stack', text: 'Gear and software at every budget' },
	{ id: 'underground', title: 'Underground', text: 'Gray markets, reported as journalism' },
	{ id: 'shortlist', title: 'The Shortlist', text: 'The few resources worth your time' },
];

const guides = docs.filter((e) => e.id.includes('/') && !e.id.endsWith('/index') && SECTION_LABELS[e.id.split('/')[0]] && !e.id.startsWith('about/'));
const count = (s: string) => guides.filter((e) => e.id.startsWith(s + '/')).length;
const liveTopics = topics.filter((t) => has(t.id) || count(t.id) > 0).map((t) => ({ ...t, n: count(t.id) }));

type Plat = { key: string; name: string; path?: string; href: string };
const platforms: Plat[] = [
	{ key: 'general', name: 'General', href: '/algorithms/' },
	{ key: 'instagram', name: 'Instagram', path: siInstagram.path, href: '/platforms/instagram/' },
	{ key: 'tiktok', name: 'TikTok', path: siTiktok.path, href: '/platforms/tiktok/' },
	{ key: 'youtube', name: 'YouTube', path: siYoutube.path, href: '/platforms/youtube/' },
	{ key: 'facebook', name: 'Facebook', path: siFacebook.path, href: '/platforms/facebook/' },
	{ key: 'linkedin', name: 'LinkedIn', href: '/platforms/linkedin/' },
	{ key: 'x', name: 'X', path: siX.path, href: '/platforms/x/' },
].filter((p) => p.key === 'general' || has(p.href.slice(1, -1)));

const order = ['algorithms', 'platforms', 'grow', 'paywall', 'deals', 'earn', 'money', 'team', 'protect', 'case-studies', 'stack', 'underground', 'shortlist', 'news'];
const rows = guides
	.map((e) => {
		const section = e.id.split('/')[0];
		const words = (e.body ?? '').replace(/<[^>]+>|import .*|[#*_`>|-]/g, ' ').split(/\s+/).filter(Boolean).length;
		return {
			id: e.id,
			href: `/${e.id}/`,
			section,
			label: SECTION_LABELS[section],
			title: e.data.title,
			description: e.data.description ?? '',
			minutes: Math.max(1, Math.round(words / 220)),
			rank: (order.indexOf(section) + 1 || 99) * 100 + (e.data.sidebar?.order ?? 50),
		};
	})
	.sort((a, b) => a.rank - b.rank);

const suggestions = ['brand deal rates', 'taxes', 'hacked account', 'OnlyFans', 'hooks'];
---

<div class="gi not-content" data-gi>
	<form class="gi-search" role="search" action="/guides/" data-form>
		<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
		<input
			type="search"
			name="q"
			placeholder={`Search ${rows.length} guides`}
			aria-label="Search guides"
			autocomplete="off"
			spellcheck="false"
			enterkeyhint="search"
			data-q
		/>
		<kbd aria-hidden="true">/</kbd>
	</form>
	<p class="gi-try" data-try>
		Try
		{
			suggestions.map((s) => (
				<button type="button" data-suggest={s}>
					{s}
				</button>
			))
		}
	</p>

	<!-- Browse (hidden while searching) -->
	<div data-browse>
		<section class="gi-block" aria-labelledby="gi-plat">
			<h2 id="gi-plat">Platforms</h2>
			<ul class="gi-plats">
				{
					platforms.map((p) => (
						<li>
							<a href={p.href} data-section={p.key === 'general' ? 'algorithms' : p.key}>
								<span class="ic" aria-hidden="true">
									{p.path ? (
										<svg viewBox="0 0 24 24">
											<path d={p.path} />
										</svg>
									) : p.key === 'linkedin' ? (
										<b>in</b>
									) : (
										<svg viewBox="0 0 24 24">
											<path d="M12 3c.5 4 2.5 6 6.5 6.5-4 .5-6 2.5-6.5 6.5-.5-4-2.5-6-6.5-6.5C9.5 9 11.5 7 12 3z" />
										</svg>
									)}
								</span>
								{p.name}
							</a>
						</li>
					))
				}
			</ul>
			<a class="gi-more" href="/platforms/">Threads, Pinterest, Twitch and more</a>
		</section>

		<section class="gi-block" aria-labelledby="gi-topics">
			<h2 id="gi-topics">Topics</h2>
			<ul class="gi-topics">
				{
					liveTopics.map((t) => (
						<li>
							<a href={`/${t.id}/`} data-section={t.id}>
								<span class="dot" aria-hidden="true" />
								<span class="txt">
									<strong>{t.title}</strong>
									<span>{t.text}</span>
								</span>
								<span class="n">{t.n}</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>

		<details class="gi-all">
			<summary>Browse all {rows.length} guides</summary>
			<ol class="gi-list">
				{
					rows.map((r) => (
						<li>
							<a href={r.href} data-section={r.section}>
								<strong>{r.title}</strong>
								<span class="meta">
									<span class="dot" aria-hidden="true" />
									{r.label} · {r.minutes} min
								</span>
							</a>
						</li>
					))
				}
			</ol>
		</details>
	</div>

	<!-- Results (shown while searching) -->
	<div class="gi-results" data-results hidden>
		<p class="gi-count" aria-live="polite" data-count></p>
		<ol class="gi-list" data-list>
			{
				rows.map((r) => (
					<li
						data-id={r.id}
						data-title={r.title.toLowerCase()}
						data-text={`${r.title} ${r.description} ${r.label}`.toLowerCase()}
						data-rank={r.rank}
						hidden
					>
						<a href={r.href} data-section={r.section}>
							<strong>{r.title}</strong>
							<span class="desc">{r.description}</span>
							<span class="hit" data-hit hidden />
							<span class="meta">
								<span class="dot" aria-hidden="true" />
								{r.label} · {r.minutes} min
							</span>
						</a>
					</li>
				))
			}
		</ol>
		<div class="gi-empty" data-empty hidden>
			<p>No guide matches that yet.</p>
			<a data-ask href="https://claude.ai/new" target="_blank" rel="noopener">Ask Claude, using this site as the source</a>
		</div>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-gi]');
	if (root) {
		const form = root.querySelector<HTMLFormElement>('[data-form]')!;
		const q = root.querySelector<HTMLInputElement>('[data-q]')!;
		const browse = root.querySelector<HTMLElement>('[data-browse]')!;
		const tryRow = root.querySelector<HTMLElement>('[data-try]')!;
		const results = root.querySelector<HTMLElement>('[data-results]')!;
		const list = root.querySelector<HTMLElement>('[data-list]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const ask = root.querySelector<HTMLAnchorElement>('[data-ask]')!;
		const items = [...list.querySelectorAll<HTMLElement>('li')];
		let ft = new Map<string, string>();
		let token = 0;
		let pf: any = null;

		const loadPf = async () => {
			if (pf !== null) return pf;
			try {
				const url = '/pagefind/pagefind.js';
				pf = await import(/* @vite-ignore */ url);
				await pf.options?.({ excerptLength: 16 });
			} catch {
				pf = false;
			}
			return pf;
		};
		const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');

		const render = () => {
			const raw = q.value.trim();
			const terms = norm(raw).split(/\s+/).filter(Boolean);
			const active = terms.length > 0;
			browse.hidden = active;
			tryRow.hidden = active;
			results.hidden = !active;
			const p = new URLSearchParams(location.search);
			if (raw) p.set('q', raw);
			else p.delete('q');
			history.replaceState(null, '', p.toString() ? `?${p}` : location.pathname);
			if (!active) return;

			const scored = items
				.map((el) => {
					const title = el.dataset.title!;
					const text = el.dataset.text!;
					let s = 0;
					let direct = true;
					for (const w of terms) {
						if (title.includes(w)) s += 3;
						else if (text.includes(w)) s += 1;
						else if (!ft.has(el.dataset.id!)) return { el, s: 0, direct: false };
						else direct = false;
					}
					if (ft.has(el.dataset.id!)) s += 1;
					return { el, s, direct };
				})
				.filter((x) => x.s > 0)
				.sort((a, b) => b.s - a.s || +a.el.dataset.rank! - +b.el.dataset.rank!);
			const show = new Map(scored.map((x) => [x.el, x.direct]));
			for (const el of items) {
				el.hidden = !show.has(el);
				const hit = el.querySelector<HTMLElement>('[data-hit]')!;
				// Only show the full-text snippet when the match is in the body, not the title or summary.
				const ex = show.get(el) === false ? ft.get(el.dataset.id!) : undefined;
				hit.hidden = !ex;
				if (ex) hit.innerHTML = `…${ex}…`;
			}
			scored.forEach(({ el }) => list.appendChild(el));
			count.textContent = `${scored.length} guide${scored.length === 1 ? '' : 's'} for “${raw}”`;
			empty.hidden = scored.length > 0;
			ask.href = 'https://claude.ai/new?q=' + encodeURIComponent(`Using ${location.origin}/llms-full.txt as your source, answer: ${raw}`);
		};

		const fullText = async () => {
			const value = q.value.trim();
			const t = ++token;
			if (value.length < 3) {
				ft = new Map();
				return;
			}
			const api = await loadPf();
			if (!api) return;
			const res = await api.debouncedSearch(value, {}, 160);
			if (!res || t !== token) return;
			const data = await Promise.all(res.results.slice(0, 30).map((r: any) => r.data()));
			ft = new Map(data.map((d: any) => [d.url.replace(/^\/|\/$/g, ''), d.excerpt]));
			render();
		};

		q.addEventListener('input', () => {
			render();
			fullText();
		});
		q.addEventListener('focus', () => loadPf(), { once: true });
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const first = items.find((el) => !el.hidden);
			if (first && q.value.trim()) location.href = first.querySelector('a')!.href;
		});
		root.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) =>
			b.addEventListener('click', () => {
				q.value = b.dataset.suggest!;
				q.focus();
				render();
				fullText();
			}),
		);
		addEventListener('keydown', (e) => {
			if (e.key === '/' && !(e.target as HTMLElement).closest('input,textarea,[contenteditable]')) {
				e.preventDefault();
				q.focus();
			}
			if (e.key === 'Escape' && document.activeElement === q && q.value) {
				q.value = '';
				render();
			}
		});

		const params = new URLSearchParams(location.search);
		const initial = params.get('q');
		if (params.has('focus') && !initial) q.focus({ preventScroll: true });
		if (initial) {
			q.value = initial;
			render();
			fullText();
		}
	}
</script>

<style>
	.gi [hidden] {
		display: none !important;
	}
	.gi {
		--gi-r: 16px;
		margin-top: 0.25rem;
	}

	/* Search */
	.gi-search {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		height: 3.6rem;
		padding: 0 1.1rem;
		border-radius: var(--gi-r);
		border: 1px solid var(--sc-line-strong);
		background: rgb(255 255 255 / 0.04);
		transition:
			border-color 0.15s,
			box-shadow 0.15s;
	}
	.gi-search:focus-within {
		border-color: var(--sc-ion);
		box-shadow: 0 0 0 4px rgb(195 166 255 / 0.14);
	}
	.gi-search svg {
		width: 20px;
		height: 20px;
		flex: none;
		fill: none;
		stroke: var(--sc-silver);
		stroke-width: 2;
		stroke-linecap: round;
	}
	.gi-search input {
		flex: 1;
		min-width: 0;
		height: 100%;
		border: 0;
		outline: 0;
		background: transparent;
		color: var(--sc-ivory);
		font: inherit;
		font-size: 1.08rem;
	}
	.gi-search input::placeholder {
		color: #85848a;
	}
	.gi-search input::-webkit-search-cancel-button {
		filter: invert(0.7);
	}
	.gi-search kbd {
		flex: none;
		padding: 0.1rem 0.45rem;
		border-radius: 6px;
		border: 1px solid var(--sc-line-strong);
		font: inherit;
		font-size: 0.75rem;
		color: var(--sc-silver);
	}
	@media (hover: none), (max-width: 40rem) {
		.gi-search kbd {
			display: none;
		}
	}
	.gi-try {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin: 0.8rem 0 0;
		font-size: 0.85rem;
		color: var(--sc-silver);
	}
	.gi-try button {
		padding: 0.25rem 0.7rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line);
		background: transparent;
		color: var(--sc-ivory);
		font: inherit;
		font-size: 0.82rem;
		cursor: pointer;
	}
	.gi-try button:hover {
		border-color: var(--sc-line-bright);
	}

	/* Blocks */
	.gi-block {
		margin-top: 2.75rem;
	}
	.gi h2 {
		margin: 0 0 0.9rem;
		padding: 0;
		border: 0;
		font-family: var(--sc-font-display);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--sc-ivory);
	}
	.gi ul,
	.gi ol {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.gi li {
		margin: 0;
	}

	/* Platforms: one tidy row */
	.gi-plats {
		display: grid;
		grid-template-columns: repeat(7, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.gi-plats a {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
		padding: 1rem 0.5rem 0.9rem;
		border-radius: var(--gi-r);
		border: 1px solid var(--sc-line);
		background: rgb(255 255 255 / 0.02);
		color: var(--sc-ivory);
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}
	.gi-plats a:hover {
		border-color: color-mix(in srgb, var(--accent) 55%, transparent);
		background: color-mix(in srgb, var(--accent) 7%, transparent);
	}
	.ic {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 12px;
		background: color-mix(in srgb, var(--accent) 16%, transparent);
	}
	.ic svg {
		width: 1.15rem;
		height: 1.15rem;
		fill: var(--accent);
	}
	.ic b {
		font-family: var(--sc-font-display);
		font-size: 0.95rem;
		color: var(--accent);
	}
	.gi-more {
		display: inline-block;
		margin-top: 0.8rem;
		font-size: 0.85rem;
		color: var(--sc-silver);
	}
	.gi-more:hover {
		color: var(--sc-ivory);
	}

	/* Topics: quiet two/three-column list */
	.gi-topics {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
	}
	.gi-topics a {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		height: 100%;
		padding: 0.95rem 1rem;
		border-radius: var(--gi-r);
		border: 1px solid var(--sc-line);
		background: rgb(255 255 255 / 0.02);
		color: inherit;
		text-decoration: none;
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}
	.gi-topics a:hover {
		border-color: color-mix(in srgb, var(--accent) 55%, transparent);
		background: color-mix(in srgb, var(--accent) 6%, transparent);
	}
	.gi .dot {
		flex: none;
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--accent);
	}
	.txt {
		display: grid;
		gap: 0.15rem;
		flex: 1;
		min-width: 0;
	}
	.txt strong {
		font-size: 0.98rem;
		color: var(--sc-ivory);
	}
	.txt span {
		font-size: 0.82rem;
		line-height: 1.4;
		color: var(--sc-silver);
	}
	.n {
		flex: none;
		min-width: 1.6rem;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		text-align: center;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sc-silver);
		background: rgb(255 255 255 / 0.05);
	}

	/* Browse all */
	.gi-all {
		margin-top: 2.25rem;
		border-top: 1px solid var(--sc-line);
		padding-top: 1.25rem;
	}
	.gi-all summary {
		cursor: pointer;
		width: fit-content;
		font-weight: 600;
		color: var(--sc-ivory);
	}
	.gi-all[open] summary {
		margin-bottom: 0.75rem;
	}

	/* Lists (browse all + results) */
	.gi-list {
		display: grid;
	}
	.gi-list li[hidden] {
		display: none;
	}
	.gi-list a {
		display: grid;
		gap: 0.25rem;
		padding: 0.85rem 0.25rem;
		border-bottom: 1px solid var(--sc-line);
		color: inherit;
		text-decoration: none;
	}
	.gi-list a:hover strong {
		color: var(--accent);
	}
	.gi-list strong {
		font-size: 1rem;
		color: var(--sc-ivory);
		transition: color 0.15s;
	}
	.gi-list .desc {
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--sc-silver);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.gi-list .meta {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		font-size: 0.75rem;
		color: var(--sc-silver);
	}
	.gi-list .dot {
		width: 0.45rem;
		height: 0.45rem;
	}
	.gi-list .hit {
		font-size: 0.82rem;
		line-height: 1.45;
		color: var(--sc-silver);
	}
	.gi-list .hit :global(mark) {
		background: rgb(195 166 255 / 0.3);
		color: var(--sc-ivory);
		border-radius: 3px;
		padding: 0 2px;
	}
	.gi-results {
		margin-top: 1.5rem;
	}
	.gi-count {
		margin: 0 0 0.25rem;
		font-size: 0.82rem;
		color: var(--sc-silver);
	}
	.gi-empty {
		padding: 2.5rem 0;
		text-align: center;
		color: var(--sc-silver);
	}
	.gi-empty a {
		color: var(--sc-ion);
	}

	/* Tablet and phone */
	@media (max-width: 62rem) {
		.gi-plats {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.gi-topics {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 40rem) {
		.gi-search {
			height: 3.25rem;
		}
		.gi-try {
			flex-wrap: nowrap;
			overflow-x: auto;
			margin-inline: calc(-1 * var(--sl-content-pad-x, 1rem));
			padding-inline: var(--sl-content-pad-x, 1rem);
			scrollbar-width: none;
		}
		.gi-try::-webkit-scrollbar {
			display: none;
		}
		.gi-try button {
			flex: none;
			white-space: nowrap;
		}
