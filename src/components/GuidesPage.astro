---
// The Guides gallery page, in the language of its URL (/guides/, /es/guides/, /pt-br/guides/).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import GuidesIndex from './GuidesIndex.astro';
import { localeOfPath, t } from '../i18n';
const L = t(localeOfPath(Astro.url.pathname)).gallery;
---

<StarlightPage
	frontmatter={{
		title: L.title,
		description: L.description,
		template: 'splash',
		tableOfContents: false,
		pagefind: false,
		prev: false,
		next: false,
	}}
>
	<GuidesIndex />
</StarlightPage>
