---
/**
 * Myth cards: the claim, a verdict, and what the primary source actually says.
 * Every card links its source. No source, no card.
 */
import { myths } from '../lib/widget-data';
const vClass: Record<string, string> = { false: 'is-false', misleading: 'is-mis', partly: 'is-partly' };
---

<div class="mb not-content">
	{
		myths.map((m, i) => (
			<details class={`mb-card ${vClass[m.v]}`} open={i === 0}>
				<summary>
					<span class="mb-claim">{m.claim}</span>
					<span class="mb-verdict">{m.verdict}</span>
					<span class="mb-chev" aria-hidden="true" />
				</summary>
				<div class="mb-body">
					<p>{m.truth}</p>
					<p class="mb-src">
						Source: <a href={m.href}>{m.src}</a>
						{m.link && (
							<>
								{' · '}
								<a href={m.link}>Our guide →</a>
							</>
						)}
					</p>
				</div>
			</details>
		))
	}
</div>

<style>
	.mb {
		display: grid;
		gap: 0.6rem;
		margin-block: 1.25rem 2rem;
	}
	.mb-card {
		--v: var(--sc-ember);
		border: 1px solid var(--sc-line);
		border-radius: 14px;
		background: rgb(255 255 255 / 0.02);
		transition: border-color 0.25s;
	}
	.mb-card.is-mis {
		--v: var(--sc-champagne);
	}
	.mb-card.is-partly {
		--v: var(--sc-cyan);
	}
	.mb-card[open] {
		border-color: color-mix(in srgb, var(--v) 40%, transparent);
	}
	summary {
		list-style: none;
		display: grid;
		grid-template-columns: 1fr auto 1rem;
		align-items: center;
		gap: 0.75rem;
		padding: 0.9rem 1rem;
		cursor: pointer;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
		border-radius: 14px;
	}
	.mb-claim {
		font-size: 0.98rem;
		font-weight: 600;
		color: var(--sc-ivory);
		line-height: 1.35;
	}
	.mb-verdict {
		font-family: var(--sc-font-mono);
		font-size: 0.64rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		color: var(--v);
		border: 1px solid color-mix(in srgb, var(--v) 60%, transparent);
		background: color-mix(in srgb, var(--v) 10%, transparent);
		white-space: nowrap;
	}
	.mb-chev {
		width: 0.55rem;
		height: 0.55rem;
		border-right: 1.5px solid var(--sc-silver);
		border-bottom: 1.5px solid var(--sc-silver);
		rotate: 45deg;
		translate: 0 -2px;
		transition: rotate 0.25s;
	}
	.mb-card[open] .mb-chev {
		rotate: 225deg;
		translate: 0 2px;
	}
	.mb-body {
		padding: 0 1rem 1rem;
		animation: mb-in 0.3s ease both;
	}
	@keyframes mb-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}
	.mb-body p {
		margin: 0 0 0.5rem;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--sc-silver);
	}
	.mb-src {
		font-family: var(--sc-font-mono);
		font-size: 0.72rem !important;
	}
	.mb-src a {
		color: var(--accent);
	}
	@media (max-width: 30rem) {
		summary {
			grid-template-columns: 1fr 1rem;
		}
		.mb-verdict {
			grid-row: 2;
			justify-self: start;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.mb-body {
			animation: none;
		}
	}
</style>
