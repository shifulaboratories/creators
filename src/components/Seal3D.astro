---
/**
 * The Select seal in real 3D: an extruded, beveled badge with a raised chrome
 * check, and platform icons on glass tiles orbiting it (three.js, loaded after
 * the page paints). Drag sideways to spin it. Until WebGL is ready, or if it
 * never is, a flat seal shows in its place.
 */
import mark from '../assets/logo.svg?raw';

const outline = mark.match(/<path d="([^"]+)"/)?.[1] ?? '';
---

<div class="s3d" data-s3d data-outline={outline} role="img" aria-label="The Select Creators seal in 3D, with platform icons orbiting it">
	<span class="s3d-glow" aria-hidden="true"></span>
	<span class="s3d-poster" aria-hidden="true" set:html={mark} />
	<span class="s3d-floor" aria-hidden="true"></span>
</div>

<script>
	// The 3D scene is extra polish, so it waits until the page has loaded and
	// the browser is idle, and it never starts where it would make the page
	// worse: Save-Data on, or WebGL drawn by the CPU (no graphics chip), where
	// every frame would freeze scrolling. The flat seal floats instead.
	const softwareGL = (gl: WebGLRenderingContext | WebGL2RenderingContext) => {
		const ext = gl.getExtension('WEBGL_debug_renderer_info');
		const name = ext ? String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL)) : '';
		return /swiftshader|llvmpipe|softpipe|software|basic render/i.test(name);
	};
	const canRun3D = () => {
		if ((navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData) return false;
		const probe = document.createElement('canvas');
		const gl = (probe.getContext('webgl2') || probe.getContext('webgl')) as WebGLRenderingContext | null;
		if (!gl) return false;
		const ok = !softwareGL(gl);
		gl.getExtension('WEBGL_lose_context')?.loseContext();
		return ok;
	};
	const start = () =>
		document.querySelectorAll<HTMLElement>('[data-s3d]').forEach(async (el) => {
			try {
				if (!canRun3D()) return;
				const { mountSeal } = await import('../scripts/seal-scene');
				await mountSeal(el, el.dataset.outline || '');
			} catch {
				/* keep the flat seal */
			}
		});
	const idle = (fn: () => void) => ('requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2500 }) : setTimeout(fn, 600));
	if (document.readyState === 'complete') idle(start);
	else addEventListener('load', () => idle(start), { once: true });
</script>

<style>
	.s3d {
		position: relative;
		width: 100%;
		max-width: 560px;
		aspect-ratio: 1 / 0.9;
		margin-inline: auto;
		/* contain keeps the canvas from ever pushing the page sideways */
		contain: layout paint;
	}
	.s3d :global(.s3d-canvas) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		touch-action: pan-y;
		cursor: grab;
		opacity: 0;
		transition: opacity 0.6s ease;
	}
	.s3d :global(.s3d-canvas:active) {
		cursor: grabbing;
	}
	.s3d:global(.is-3d) :global(.s3d-canvas) {
		opacity: 1;
	}
	.s3d-poster {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 38%;
		translate: -50% -50%;
		filter: drop-shadow(0 18px 30px rgb(0 0 0 / 0.6));
		transition: opacity 0.4s ease;
	}
	.s3d-poster :global(svg) {
		display: block;
		width: 100%;
		height: auto;
	}
	.s3d:global(.is-3d) .s3d-poster {
		opacity: 0;
		animation: none;
	}
	@media (prefers-reduced-motion: no-preference) {
		.s3d-poster {
			animation: s3d-bob 6s ease-in-out infinite;
		}
	}
	@keyframes s3d-bob {
		0%,
		100% {
			transform: translateY(0) rotate(-3deg);
		}
		50% {
			transform: translateY(-8px) rotate(3deg);
		}
	}
	.s3d-glow {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 62%;
		aspect-ratio: 1;
		translate: -50% -50%;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(255 134 184 / 0.22), rgb(195 166 255 / 0.12) 55%, transparent);
	}
	.s3d-floor {
		position: absolute;
		left: 50%;
		bottom: 11%;
		width: 46%;
		height: 22px;
		translate: -50% 0;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(195 166 255 / 0.3), transparent);
	}
</style>
