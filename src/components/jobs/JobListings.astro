---
/**
 * Open roles at creator-economy companies, from public job-board feeds
 * (scripts/fetch-jobs.mjs, refreshed daily). The page ships the first few as
 * HTML; the filters load the rest from /jobs/listings.json.
 * Nobody pays to be listed and no link earns us anything.
 */
import FeedDeck from '../feed/FeedDeck.astro';
import { jobs, jobSources, jobsUpdated, newSince, roles, kinds, shortDate } from '../../lib/jobs';

const FIRST = 12;
const companies = new Set(jobs.map((j) => j.company)).size;
const roleCount = (id: string) => jobs.filter((j) => j.role === id).length;
const kindCount = (id: string) => jobs.filter((j) => j.kind === id).length;
const remoteCount = jobs.filter((j) => j.remote).length;
const kindOf = Object.fromEntries(kinds.map((k) => [k.id, k]));
const roleLabel = Object.fromEntries(roles.map((r) => [r.id, r.label]));
const newCount = jobs.filter((j) => j.firstSeen >= newSince).length;
const advised = jobSources.some((s) => s.company === 'Fanfix');
// Who's hiring most: one swipeable card per company, tap to filter the list.
const hiring = [...Map.groupBy(jobs, (j) => j.company)]
	.map(([company, list]) => ({ company, kind: list[0].kind, n: list.length, titles: [...new Set(list.map((j) => j.title))].slice(0, 3) }))
	.sort((a, b) => b.n - a.n || a.company.localeCompare(b.company))
	.slice(0, 10);
---

<section class="jl not-content" data-jl data-updated={jobsUpdated} data-new-since={newSince} data-first={FIRST} data-tints={JSON.stringify(Object.fromEntries(kinds.map((k) => [k.id, k.tint])))} id="open-roles">
	<div class="jl-head">
		<h2>Open roles right now</h2>
		<p>
			{
				jobs.length ? (
					<>
						<b>{jobs.length.toLocaleString('en-US')}</b> openings at <b>{companies}</b> creator-economy companies, checked {shortDate(jobsUpdated)}
						{newCount > 0 && <span class="jl-new-n"> · {newCount} new this week</span>}
					</>
				) : (
					'The first listings arrive with the next daily refresh.'
				)
			}
		</p>
	</div>

	{
		hiring.length > 2 && (
			<FeedDeck title="Who's hiring most" kicker="Swipe companies">
				{hiring.map((h) => (
					<a class="fd-card jl-co" href="#jl-filters" data-company={h.company} style={`--accent:${kindOf[h.kind]?.tint}`}>
						<span class="fd-top">
							<span class="fd-avatar" aria-hidden="true">{h.company.slice(0, 1)}</span>
							<span class="fd-who">{h.company}</span>
						</span>
						<span class="fd-big">
							{h.n} open {h.n === 1 ? 'role' : 'roles'}
						</span>
						<span class="jl-co-titles">
							{h.titles.map((t) => <span>{t}</span>)}
						</span>
						<span class="fd-foot">
							<span>{kindOf[h.kind]?.label}</span>
							<span class="fd-go">See roles →</span>
						</span>
					</a>
				))}
			</FeedDeck>
		)
	}

	{
		jobs.length > 0 && (
			<>
				<label class="jl-search" id="jl-filters">
					<span class="sr-only">Search jobs</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<circle cx="11" cy="11" r="7" />
						<path d="m20 20-3.5-3.5" />
					</svg>
					<input type="search" placeholder="Search a title, company or city" autocomplete="off" data-q />
				</label>

				<div class="jl-chips" role="toolbar" aria-label="Filter by role">
					<button type="button" class="jl-chip" aria-pressed="true" data-role="all">
						All roles
					</button>
					{roles.map((r) => (
						<button type="button" class="jl-chip" aria-pressed="false" data-role={r.id} disabled={!roleCount(r.id)}>
							{r.label} <span>{roleCount(r.id)}</span>
						</button>
					))}
				</div>

				<div class="jl-row">
					<label class="jl-select">
						<span class="sr-only">Company type</span>
						<select data-kind>
							<option value="all">Every kind of company</option>
							{kinds.map((k) => kindCount(k.id) > 0 && <option value={k.id}>{k.label} ({kindCount(k.id)})</option>)}
						</select>
					</label>
					<button type="button" class="jl-toggle" aria-pressed="false" data-remote disabled={!remoteCount}>
						<span class="jl-dot" aria-hidden="true" /> Remote only
					</button>
					<button type="button" class="jl-toggle" aria-pressed="false" data-new disabled={!newCount}>
						<span class="jl-dot" aria-hidden="true" /> New this week
					</button>
				</div>

				<p class="jl-count" aria-live="polite">
					<span data-count>{jobs.length.toLocaleString('en-US')}</span> roles
				</p>

				<ul class="jl-list" data-list>
					{jobs.slice(0, FIRST).map((j) => (
						<li>
							<a class="jl-card sc-press" href={j.url} rel="noopener nofollow" target="_blank" style={`--accent:${kindOf[j.kind]?.tint}`}>
								<span class="jl-av" aria-hidden="true">
									{j.company.slice(0, 1)}
								</span>
								<span class="jl-body">
									<strong>{j.title}</strong>
									<span class="jl-meta">
										{j.company}
										{j.location && ` · ${j.location}`}
									</span>
									<span class="jl-tags">
										<span class="jl-tag">{roleLabel[j.role]}</span>
										{j.remote && <span class="jl-tag is-remote">Remote</span>}
										{j.firstSeen >= newSince && <span class="jl-tag is-new">New</span>}
									</span>
									<span class="jl-src">
										Seen since {shortDate(j.firstSeen)} · via {j.source}
									</span>
								</span>
								<svg class="jl-go" viewBox="0 0 24 24" aria-hidden="true">
									<path d="M7 17 17 7M9 7h8v8" />
								</svg>
							</a>
						</li>
					))}
				</ul>
				<button type="button" class="jl-more" data-more hidden={jobs.length <= FIRST}>
					Show more roles
				</button>
				<p class="jl-empty" data-empty hidden>
					Nothing matches that today. Try fewer filters, or check back tomorrow.
				</p>
			</>
		)
	}

	<details class="jl-about">
		<summary>Where these come from</summary>
		<p>
			Every listing comes from the public job-board feed a company publishes on Greenhouse, Lever or Ashby, the same feed that powers its own careers page. We check them once a day and link straight to the company's application page.
			We don't charge to be listed, and we earn nothing when you apply. "Seen since" is the day our check first found the role; companies sometimes keep a role open long after it's filled, so apply soon and ask.
		</p>
		<p>
			For big platforms we only show roles that work with creators: partnerships, content, community and similar.
			{advised && ' William Lee, who runs this site, advises Fanfix; Fanfix roles are listed under the same rules as everyone else.'}
		</p>
		{
			jobSources.length > 0 && (
				<ul class="jl-sources">
					{jobSources.map((s) => (
						<li>
							<a href={s.board} rel="noopener nofollow" target="_blank">
								{s.company}
							</a>{' '}
							<span>
								{s.count} · {s.source}
							</span>
						</li>
					))}
				</ul>
			)
		}
		<p>
			Missing a creator-economy company with a public job board? <a href="https://github.com/shifulaboratories/creators/edit/main/scripts/jobs/sources.mjs">Add it</a> or email support@creators.select.
		</p>
	</details>
</section>

<style is:global>
