</style>

<script>
	type Row = [string, string, string, string, string, number, string, string, string];
	const ROLE: Record<string, string> = {};
	const TINT: Record<string, string> = {};

	function init(root: HTMLElement) {
		if (root.dataset.ready) return;
		root.dataset.ready = '1';
		const list = root.querySelector<HTMLUListElement>('[data-list]');
		if (!list) return;
		root.querySelectorAll<HTMLButtonElement>('[data-role]').forEach((b) => {
			if (b.dataset.role !== 'all') ROLE[b.dataset.role!] = b.firstChild?.textContent?.trim() ?? '';
		});
		const first = Number(root.dataset.first) || 12;
		const updated = root.dataset.updated || '';
		const newSince = root.dataset.newSince || '9999';
		const q = root.querySelector<HTMLInputElement>('[data-q]')!;
		const kindSel = root.querySelector<HTMLSelectElement>('[data-kind]')!;
		const remoteBtn = root.querySelector<HTMLButtonElement>('[data-remote]')!;
		const newBtn = root.querySelector<HTMLButtonElement>('[data-new]')!;
		const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-role]')];
		const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
		const empty = root.querySelector<HTMLElement>('[data-empty]')!;
		const count = root.querySelector<HTMLElement>('[data-count]')!;

		Object.assign(TINT, JSON.parse(root.dataset.tints || '{}'));

		let rows: Row[] | null = null;
		let loading: Promise<void> | null = null;
		let role = 'all';
		let shown = first;

		const load = () =>
			(loading ??= fetch('/jobs/listings.json')
				.then((r) => r.json())
				.then((d) => {
					rows = d.rows;
				})
				.catch(() => {
					loading = null;
				}));

		const date = (iso: string) => {
			const d = new Date(iso + 'T12:00:00Z');
			return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC', ...(iso.slice(0, 4) === updated.slice(0, 4) ? {} : { year: 'numeric' }) });
		};
		const el = (tag: string, cls?: string, text?: string) => {
			const e = document.createElement(tag);
			if (cls) e.className = cls;
			if (text) e.textContent = text;
			return e;
		};
		const card = (r: Row) => {
			const [title, company, kind, rl, loc, remote, url, source, seen] = r;
			const li = el('li');
			const a = el('a', 'jl-card sc-press') as HTMLAnchorElement;
			if (!/^https:\/\//.test(url)) return li;
			a.href = url;
			a.rel = 'noopener nofollow';
			a.target = '_blank';
			a.style.setProperty('--accent', TINT[kind] ?? 'var(--sc-ion)');
			const av = el('span', 'jl-av', company.slice(0, 1));
			av.setAttribute('aria-hidden', 'true');
			const body = el('span', 'jl-body');
			body.append(el('strong', '', title), el('span', 'jl-meta', loc ? `${company} · ${loc}` : company));
			const tags = el('span', 'jl-tags');
			tags.append(el('span', 'jl-tag', ROLE[rl] ?? ''));
			if (remote) tags.append(el('span', 'jl-tag is-remote', 'Remote'));
			if (seen >= newSince) tags.append(el('span', 'jl-tag is-new', 'New'));
			body.append(tags, el('span', 'jl-src', `Seen since ${date(seen)} · via ${source}`));
			const go = list.querySelector('.jl-go')?.cloneNode(true);
			a.append(av, body);
			if (go) a.append(go);
			li.append(a);
			return li;
		};

		const render = () => {
			if (!rows) return;
			const words = q.value.toLowerCase().split(/\s+/).filter(Boolean);
			const kind = kindSel.value;
			const remote = remoteBtn.getAttribute('aria-pressed') === 'true';
			const fresh = newBtn.getAttribute('aria-pressed') === 'true';
			const hits = rows.filter((r) => {
				if (role !== 'all' && r[3] !== role) return false;
				if (kind !== 'all' && r[2] !== kind) return false;
				if (remote && !r[5]) return false;
				if (fresh && r[8] < newSince) return false;
				if (!words.length) return true;
				const hay = `${r[0]} ${r[1]} ${r[4]}`.toLowerCase();
				return words.every((w) => hay.includes(w));
			});
			list.replaceChildren(...hits.slice(0, shown).map(card));
			count.textContent = hits.length.toLocaleString('en-US');
			more.hidden = hits.length <= shown;
			empty.hidden = hits.length > 0;
		};

		const update = (reset = true) => {
			if (reset) shown = first;
			if (rows) render();
			else load().then(render);
		};

		chips.forEach((chip) =>
			chip.addEventListener('click', () => {
				role = chip.dataset.role || 'all';
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
				update();
			}),
		);
		[remoteBtn, newBtn].forEach((b) =>
			b.addEventListener('click', () => {
				b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'));
				update();
			}),
		);
		kindSel.addEventListener('change', () => update());
		q.addEventListener('input', () => update());
		q.addEventListener('focus', () => load(), { once: true });
		// "Who's hiring most" cards: show that company's roles.
		root.querySelectorAll<HTMLAnchorElement>('[data-company]').forEach((a) =>
			a.addEventListener('click', (e) => {
				e.preventDefault();
				q.value = a.dataset.company!;
				role = 'all';
				chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.role === 'all')));
				update();
				root.querySelector('#jl-filters')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
			}),
		);
		more.addEventListener('click', () => {
			shown += 24;
			update(false);
		});
	}

	const boot = () => document.querySelectorAll<HTMLElement>('[data-jl]').forEach(init);
	boot();
	document.addEventListener('astro:page-load', boot);
</script>
