---
/**
 * App-style bottom tab bar for phones. Hides while you scroll down to read,
 * slides back when you scroll up. Hidden on tablets and desktop.
 */
interface Props {
	variant?: 'docs' | 'landing';
}
const { variant = 'docs' } = Astro.props;
const path = Astro.url.pathname;
const tabs = [
	{ href: '/', label: 'Home', icon: 'home', match: (p: string) => p === '/' },
	{ href: '/algorithms/', label: 'Learn', icon: 'learn', match: (p: string) => p.startsWith('/algorithms') || p.startsWith('/grow') },
	{ href: '/platforms/', label: 'Platforms', icon: 'grid', match: (p: string) => p.startsWith('/platforms') },
	{ href: '/goldmines/', label: 'Goldmines', icon: 'gem', match: (p: string) => p.startsWith('/goldmines') },
];
const icons: Record<string, string> = {
	home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
	learn: 'M3 7l9-4 9 4-9 4zM7 9.2V14c0 1.7 2.2 3 5 3s5-1.3 5-3V9.2M21 7v6',
	grid: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z',
	gem: 'M6 3h12l3 6-9 12L3 9zM3 9h18M12 21 8.5 9 12 3l3.5 6z',
	menu: 'M4 7h16M4 12h16M4 17h10',
	search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4',
};
---

<nav class="tabbar" aria-label="Quick navigation" data-tabbar>
	{
		tabs.map((t) => {
			const on = t.match(path);
			return (
				<a href={t.href} class:list={['tab', { on }]} aria-current={on ? 'page' : undefined}>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path d={icons[t.icon]} />
					</svg>
					<span>{t.label}</span>
				</a>
			);
		})
	}
	<a href="/guides/?focus=1" class:list={['tab', { on: path.startsWith('/guides') }]} aria-current={path.startsWith('/guides') ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d={icons.search} />
		</svg>
		<span>Search</span>
	</a>
</nav>

<script>
	const bar = document.querySelector<HTMLElement>('[data-tabbar]');
	if (bar) {
		let last = scrollY;
		let ticking = false;
		addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					const y = scrollY;
					const atBottom = innerHeight + y >= document.documentElement.scrollHeight - 40;
					bar.classList.toggle('is-hidden', y > last + 4 && y > 120 && !atBottom);
					if (y < last - 4 || atBottom) bar.classList.remove('is-hidden');
					last = y;
					ticking = false;
				});
			},
			{ passive: true },
		);
	}
</script>

<style>
	.tabbar {
		position: fixed;
		z-index: 40;
		left: 50%;
		bottom: calc(0.6rem + env(safe-area-inset-bottom));
		translate: -50% 0;
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		width: min(26rem, calc(100% - 1.5rem));
		padding: 0.3rem;
		border-radius: 22px;
		border: 1px solid rgb(255 255 255 / 0.1);
		background: rgb(12 12 12 / 0.88);
		backdrop-filter: blur(18px) saturate(1.4);
		-webkit-backdrop-filter: blur(18px) saturate(1.4);
		box-shadow:
			0 18px 40px -12px rgb(0 0 0 / 0.8),
			inset 0 1px 0 rgb(255 255 255 / 0.06);
		transition:
			transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
			opacity 0.35s;
	}
	.tabbar.is-hidden {
		transform: translateY(calc(100% + 1.5rem));
		opacity: 0;
	}
	@media (min-width: 50rem) {
		.tabbar {
			display: none;
		}
	}
	.tab {
		appearance: none;
		font: inherit;
		display: grid;
		justify-items: center;
		gap: 0.15rem;
		padding: 0.45rem 0 0.35rem;
		border: 0;
		border-radius: 16px;
		background: transparent;
		color: #8f8f8e;
		text-decoration: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition:
			color 0.2s,
			background 0.2s,
			transform 0.15s;
	}
	.tab:active {
		transform: scale(0.92);
	}
	.tab svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tab span {
		font-size: 0.62rem;
		font-weight: 500;
		letter-spacing: 0.02em;
	}
	.tab.on {
		color: var(--sc-ivory, #f5f5f4);
		background: rgb(255 255 255 / 0.07);
	}
	.tab.on svg {
		stroke: var(--sc-ion, #c3a6ff);
	}
	.tab:focus-visible {
		outline: 2px solid var(--sc-ion, #c3a6ff);
		outline-offset: 1px;
	}
	@media (prefers-reduced-motion: reduce) {
		.tabbar {
			transition: none;
		}
	}
</style>
