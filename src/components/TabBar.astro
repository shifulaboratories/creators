---
/**
 * Bottom tab bar for phones: Home, Resources, Search, Menu. Jobs, Directories,
 * News and Contributors are one tap away in Menu. Solid and full width
 * like a native app, hidden while you scroll down to read and back when you
 * scroll up. Menu opens the same menu as the header (SiteNav.astro).
 */
interface Props {
	variant?: 'docs' | 'landing';
}
import { localeOfPath, basePath, localize, t } from '../i18n';
import { groupFor } from '../data/nav';
const locale = localeOfPath(Astro.url.pathname);
const L = t(locale).tabs;
const path = basePath(Astro.url.pathname);
const icons = {
	home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
	guides: 'M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5zM13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13z',
	search: 'M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14zM20 20l-4-4',
	menu: 'M4 7h16M4 12h16M4 17h16',
};
const isHome = path === '/';
const isGuides = groupFor(path) === 'resources';
---

<nav class="tabbar" aria-label={L.nav} data-tabbar>
	<a href={localize(locale, '/')} class:list={['tab', { on: isHome }]} aria-current={isHome ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.home}></path></svg>
		<span>{L.home}</span>
	</a>
	<a href={localize(locale, '/guides/')} class:list={['tab', { on: isGuides }]} aria-current={path.startsWith('/guides') ? 'page' : undefined}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.guides}></path></svg>
		<span>{L.guides}</span>
	</a>
	<a href={localize(locale, '/guides/') + '?focus=1'} class="tab" data-tab-search>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.search}></path></svg>
		<span>{L.search}</span>
	</a>
	<button type="button" class="tab" data-open-menu aria-haspopup="dialog">
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons.menu}></path></svg>
		<span>{L.menu}</span>
	</button>
</nav>

<script>
	const bar = document.querySelector<HTMLElement>('[data-tabbar]');
	if (bar) {
		// On guide pages, Search opens the site search box instead of leaving the page.
		bar.querySelector<HTMLAnchorElement>('[data-tab-search]')!.addEventListener('click', (e) => {
			const open = document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]');
			if (open) {
				// Open it the way Ctrl+K does. Clicking its button from inside this
				// tap lets the modal's outside-click check close it straight away.
				e.preventDefault();
				e.stopPropagation();
				window.dispatchEvent(new KeyboardEvent('keydown', { key: 'k', ctrlKey: true }));
			}
		});
		let last = scrollY;
		let ticking = false;
		addEventListener(
			'scroll',
			() => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(() => {
					const y = scrollY;
					const atBottom = innerHeight + y >= document.documentElement.scrollHeight - 40;
					if (y > last + 6 && y > 160 && !atBottom) bar.classList.add('is-hidden');
					else if (y < last - 6 || atBottom) bar.classList.remove('is-hidden');
					last = y;
					ticking = false;
				});
			},
			{ passive: true },
		);
	}
</script>

<style>
	.tabbar {
		position: fixed;
		z-index: 40;
		inset: auto 0 0 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding: 0.3rem 0.5rem calc(0.3rem + env(safe-area-inset-bottom));
		border-top: 1px solid rgb(255 255 255 / 0.08);
		background: #0b0a0d;
		transition: transform 0.25s ease;
	}
	.tabbar.is-hidden {
		transform: translateY(100%);
	}
	@media (min-width: 50rem) {
		.tabbar {
			display: none;
		}
	}
	.tab {
		appearance: none;
		font: inherit;
		display: grid;
		justify-items: center;
		gap: 0.15rem;
		padding: 0.4rem 0 0.3rem;
		border: 0;
		background: transparent;
		color: #8f8e94;
		text-decoration: none;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
	}
	.tab svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.7;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.tab span {
		font-size: 0.66rem;
		font-weight: 500;
	}
	.tab.on {
		color: var(--sc-ivory, #f5f5f4);
	}
	.tab.on svg {
		stroke: var(--sc-ion, #c3a6ff);
	}
	.tab:focus-visible {
		outline: 2px solid var(--sc-ion, #c3a6ff);
		outline-offset: -2px;
		border-radius: 10px;
	}
	@media (prefers-reduced-motion: reduce) {
		.tabbar {
			transition: none;
		}
	}
</style>

<style is:global>
	/* Keep the last lines of every page clear of the tab bar. */
	@media (max-width: 49.99rem) {
		body {
			padding-bottom: calc(3.6rem + env(safe-area-inset-bottom));
		}
	}
</style>
