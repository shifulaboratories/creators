---
/** "The short version": three numbered points at the top of a guide (see src/data/tldr.ts). */
import { currentLocale, t } from '../i18n';
interface Props {
	points: string[];
}
const { points } = Astro.props;
const label = t(currentLocale(Astro)).page.shortVersion;
---

<section class="tldr not-content" aria-labelledby="tldr-title">
	<p class="tldr-title" id="tldr-title">{label}</p>
	<ol>
		{points.map((p) => <li>{p}</li>)}
	</ol>
</section>

<style>
	.tldr {
		position: relative;
		margin-top: 1.5rem;
		padding: 1.1rem 1.15rem 1.15rem;
		border-radius: 20px;
		border: 1px solid color-mix(in srgb, var(--accent, var(--sc-ion)) 30%, transparent);
		background:
			radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--accent, var(--sc-ion)) 13%, transparent), transparent 60%),
			rgb(255 255 255 / 0.025);
	}
	.tldr-title {
		margin: 0 0 0.75rem;
		width: fit-content;
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: var(--sc-lime);
		color: #0b0b0b;
		font-size: 0.75rem;
		font-weight: 700;
		transform: rotate(-1.5deg);
	}
	ol {
		display: grid;
		gap: 0.7rem;
		margin: 0;
		padding: 0;
		list-style: none;
		counter-reset: tldr;
	}
	li {
		display: grid;
		grid-template-columns: 1.6rem 1fr;
		gap: 0.6rem;
		margin: 0;
		font-size: 1rem;
		line-height: 1.45;
		color: var(--sc-platinum);
		counter-increment: tldr;
	}
	li::before {
		content: counter(tldr);
		display: grid;
		place-items: center;
		width: 1.6rem;
		height: 1.6rem;
		border-radius: 50%;
		background: color-mix(in srgb, var(--accent, var(--sc-ion)) 22%, transparent);
		color: var(--accent, var(--sc-ion));
		font: 700 0.8rem / 1 var(--sc-font-display);
	}
</style>
