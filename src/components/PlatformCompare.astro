---
/**
 * Interactive: put any two platforms side by side, row by row,
 * and get a "moving a winner from A to B" checklist.
 * Every cell is tagged with where it comes from.
 */
type Cell = { t: string; s: 'code' | 'platform' | 'practitioner' | 'none' };
type P = { key: string; name: string; tint: string; href: string; rows: Record<string, Cell> };

const rows = [
	{ key: 'reach', label: 'Where new viewers come from' },
	{ key: 'signals', label: 'Strongest signals it names' },
	{ key: 'hurts', label: 'What limits reach' },
	{ key: 'followers', label: 'Does follower count matter?' },
	{ key: 'status', label: 'Can you check if you’re limited?' },
	{ key: 'open', label: 'How open it is' },
	{ key: 'play', label: 'The play' },
];
const platforms: P[] = [
	{
		key: 'youtube',
		name: 'YouTube',
		tint: 'youtube',
		href: '/platforms/youtube/',
		rows: {
			reach: { t: 'Recommendations on Home and Up Next, which drive more viewing than subscriptions or search.', s: 'platform' },
			signals: { t: 'Clicks, watch time, satisfaction surveys, shares, likes and dislikes.', s: 'platform' },
			hurts: { t: 'Clicks without satisfaction. YouTube added watch time in 2012 because clicks alone rewarded misleading videos.', s: 'platform' },
			followers: { t: 'YouTube says recommendations don’t rely on your social graph.', s: 'platform' },
			status: { t: 'Not covered in the sources we cite.', s: 'none' },
			open: { t: 'Written explainers and engineering blog posts. No public ranking code.', s: 'platform' },
			play: { t: 'Package first, pay off the click in the opening, and earn every minute after.', s: 'practitioner' },
		},
	},
	{
		key: 'tiktok',
		name: 'TikTok',
		tint: 'tiktok',
		href: '/platforms/tiktok/',
		rows: {
			reach: { t: 'The For You feed, ranked per viewer.', s: 'platform' },
			signals: { t: 'How people interact with the video. Finishing a longer video is a strong signal.', s: 'platform' },
			hurts: { t: 'Spam, artificially boosted traffic, duplicated content, and videos still under review.', s: 'platform' },
			followers: { t: 'Not a direct factor, and neither are your past hits.', s: 'platform' },
			status: { t: 'Not covered in the sources we cite.', s: 'none' },
			open: { t: 'One detailed newsroom explainer (2020). No public ranking code.', s: 'platform' },
			play: { t: 'Open on the payoff, cut every dead second, and aim for people finishing and sending it.', s: 'practitioner' },
		},
	},
	{
		key: 'instagram',
		name: 'Instagram',
		tint: 'instagram',
		href: '/platforms/instagram/',
		rows: {
			reach: { t: 'Reels and Explore, which are mostly accounts people don’t follow yet.', s: 'platform' },
			signals: { t: 'Reels: reshares, watching all the way through, likes and audio page visits.', s: 'platform' },
			hurts: { t: 'Low resolution, other apps’ watermarks, muted audio, borders, mostly-text Reels and reposted content.', s: 'platform' },
			followers: { t: 'Feed is mostly accounts you follow. Reels and Explore mostly aren’t.', s: 'platform' },
			status: { t: 'Yes. Account Status in the app shows recommendation eligibility.', s: 'platform' },
			open: { t: 'A detailed ranking explainer from Instagram’s head (2023). No public ranking code.', s: 'platform' },
			play: { t: 'Use Reels to reach new people and Feed for your audience. Upload clean, native files.', s: 'practitioner' },
		},
	},
	{
		key: 'x',
		name: 'X',
		tint: 'x',
		href: '/algorithms/x-open-source/',
		rows: {
			reach: { t: 'For You mixes followed and unfollowed accounts. In 2023, about half of candidates came from each.', s: 'code' },
			signals: { t: 'Predicted actions, weighted. In 2026: share via copy link 20, reply 5, quote 5, share via DM 5, follow 4, like 0.708.', s: 'code' },
			hurts: { t: 'Predicted “not interested,” mute, block and report. Posts older than 48 hours are dropped from For You.', s: 'code' },
			followers: { t: 'Posts from accounts the viewer doesn’t follow get a discount. Authors with few impressions get a boost.', s: 'code' },
			status: { t: 'Yes. The “Under the Hood” tool shows visibility labels on your account and posts.', s: 'code' },
			open: { t: 'Open-source ranking code, released 2023 and again in 2026, with dated updates.', s: 'code' },
			play: { t: 'Write posts people reply to, quote and send. Avoid anything your audience would mute.', s: 'practitioner' },
		},
	},
];
const tagText = { code: 'Code', platform: 'Platform', practitioner: 'Practitioner', none: 'Unknown' };
---

<div class="sc-widget pc" data-pc data-platforms={JSON.stringify(platforms)}>
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">Interactive · Platform vs platform</div>
			<h4 class="sc-widget__title">Pick two platforms</h4>
		</div>
	</div>

	<div class="pc-pickers">
		{
			['a', 'b'].map((side, si) => (
				<div class="sc-chip-row" role="group" aria-label={side === 'a' ? 'First platform' : 'Second platform'} data-side={side}>
					<span class="pc-side">{side === 'a' ? 'From' : 'To'}</span>
					{platforms.map((p, i) => (
						<button type="button" class="sc-chip" data-key={p.key} data-section={p.tint} aria-pressed={i === si ? 'true' : 'false'}>
							{p.name}
						</button>
					))}
				</div>
			))
		}
	</div>

	<div class="pc-table" role="table" aria-label="Platform comparison">
		<div class="pc-row pc-headrow" role="row">
			<span role="columnheader" />
			<span role="columnheader" class="pc-colhead" data-col="a" data-section={platforms[0].tint}>{platforms[0].name}</span>
			<span role="columnheader" class="pc-colhead" data-col="b" data-section={platforms[1].tint}>{platforms[1].name}</span>
		</div>
		{
			rows.map((r) => (
				<div class="pc-row" role="row" data-row={r.key}>
					<span role="rowheader" class="pc-rowhead">{r.label}</span>
					{(['a', 'b'] as const).map((side, si) => {
						const c = platforms[si].rows[r.key];
						return (
							<span role="cell" class="pc-cell" data-col={side} data-section={platforms[si].tint}>
								<span class="pc-name">{platforms[si].name}</span>
								<span class="pc-text">{c.t}</span>
								<span class={`sc-tag is-${c.s === 'none' ? 'illustrative' : c.s}`}>{tagText[c.s]}</span>
							</span>
						);
					})}
				</div>
			))
		}
	</div>

	<div class="pc-port" aria-live="polite">
		<div class="sc-widget__kicker">Moving a winner across</div>
		<p data-port></p>
	</div>
	<p class="sc-widget__note">Each cell is tagged: <span class="sc-tag is-code">Code</span> published source code, <span class="sc-tag is-platform">Platform</span> the platform’s own explainer, <span class="sc-tag is-practitioner">Practitioner</span> our read, consistent with those sources. Sources are listed on each platform guide.</p>
</div>

<script>
	type Cell = { t: string; s: string };
	type P = { key: string; name: string; tint: string; href: string; rows: Record<string, Cell> };
	const tagText: Record<string, string> = { code: 'Code', platform: 'Platform', practitioner: 'Practitioner', none: 'Unknown' };
	document.querySelectorAll<HTMLElement>('[data-pc]').forEach((root) => {
		const platforms: P[] = JSON.parse(root.dataset.platforms!);
		const pick = { a: platforms[0].key, b: platforms[1].key } as Record<string, string>;
		const get = (k: string) => platforms.find((p) => p.key === k)!;
		const render = () => {
			(['a', 'b'] as const).forEach((side) => {
				const p = get(pick[side]);
				root.querySelectorAll<HTMLElement>(`[data-col="${side}"]`).forEach((el) => {
					el.dataset.section = p.tint;
					el.classList.remove('is-swap');
					void el.offsetWidth;
					el.classList.add('is-swap');
					if (el.classList.contains('pc-colhead')) {
						el.textContent = p.name;
						return;
					}
					const row = (el.closest('[data-row]') as HTMLElement).dataset.row!;
					const c = p.rows[row];
					el.querySelector('.pc-name')!.textContent = p.name;
					el.querySelector('.pc-text')!.textContent = c.t;
					const tag = el.querySelector('.sc-tag')!;
					tag.className = `sc-tag is-${c.s === 'none' ? 'illustrative' : c.s}`;
					tag.textContent = tagText[c.s];
				});
				root.querySelectorAll<HTMLButtonElement>(`[data-side="${side}"] [data-key]`).forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.key === pick[side])));
			});
			const a = get(pick.a);
			const b = get(pick.b);
			const port = root.querySelector('[data-port]')!;
			port.innerHTML =
				a.key === b.key
					? `Pick two different platforms to see what to change when you move a post that worked on one to the other.`
					: `Keep the idea that worked on ${a.name}. Rebuild it for what ${b.name} rewards: <b>${b.rows.signals.t}</b> Watch out for what limits reach there: ${b.rows.hurts.t.charAt(0).toLowerCase() + b.rows.hurts.t.slice(1)} <a href="${b.href}">Read the ${b.name} guide →</a>`;
		};
		root.querySelectorAll<HTMLElement>('[data-side]').forEach((g) =>
			g.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-key]');
				if (!btn) return;
				pick[g.dataset.side!] = btn.dataset.key!;
				render();
			}),
		);
		render();
	});
</script>

<style>
	.pc-pickers {
		display: grid;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}
	.pc-side {
		font-family: var(--sc-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sc-silver);
		width: 2.6rem;
		align-self: center;
	}
	.pc-pickers .sc-chip[aria-pressed='true'] {
		background: var(--accent);
		border-color: var(--accent);
	}
	.pc-table {
		display: grid;
		border-top: 1px solid var(--sc-line);
	}
	.pc-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.5rem 1rem;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--sc-line);
	}
	.pc-headrow {
		display: none;
	}
	.pc-rowhead {
		grid-column: 1 / -1;
		font-family: var(--sc-font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--sc-silver);
	}
	.pc-cell {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.35rem;
		padding-left: 0.65rem;
		border-left: 2px solid var(--accent);
		font-size: 0.86rem;
		line-height: 1.45;
		color: var(--sc-ivory);
	}
	.pc-name {
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--accent);
	}
	.pc-cell.is-swap,
	.pc-colhead.is-swap {
		animation: pc-swap 0.4s ease both;
	}
	@keyframes pc-swap {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
	}
	@media (min-width: 48rem) {
		.pc-headrow {
			display: grid;
		}
		.pc-row {
			grid-template-columns: 11rem 1fr 1fr;
			align-items: start;
		}
		.pc-rowhead {
			grid-column: auto;
			padding-top: 0.15rem;
		}
		.pc-name {
			display: none;
		}
		.pc-colhead {
			font-weight: 600;
			color: var(--accent);
			padding-left: 0.65rem;
		}
	}
	.pc-port {
		margin-top: 1.1rem;
		padding: 0.9rem 1rem;
		border-radius: 12px;
		border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
		background: color-mix(in srgb, var(--accent) 6%, transparent);
	}
	.pc-port p {
		margin: 0.4rem 0 0;
		font-size: 0.9rem;
		line-height: 1.55;
	}
	@media (prefers-reduced-motion: reduce) {
		.pc-cell.is-swap,
		.pc-colhead.is-swap {
			animation: none;
		}
	}
</style>
