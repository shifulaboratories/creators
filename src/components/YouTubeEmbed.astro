---
/**
 * One click-to-load YouTube video for guides and case studies.
 * Only the thumbnail ships with the page; the privacy-enhanced player loads on tap.
 */
interface Props {
	id: string;
	title: string;
	caption?: string;
}
const { id, title, caption } = Astro.props;
---

<figure class="yt not-content">
	<button type="button" class="yt-frame" data-yt={id} aria-label={`Play: ${title}`}>
		<img src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
		<span class="yt-play" aria-hidden="true">
			<svg viewBox="0 0 24 24" width="24" height="24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
		</span>
		<span class="yt-title">{title}</span>
	</button>
	<figcaption>
		{caption && <span>{caption} </span>}
		<a href={`https://www.youtube.com/watch?v=${id}`} target="_blank" rel="noopener">Watch on YouTube ↗</a>
	</figcaption>
</figure>

<script>
	document.querySelectorAll<HTMLButtonElement>('.yt-frame[data-yt]').forEach((b) =>
		b.addEventListener(
			'click',
			() => {
				const f = document.createElement('iframe');
				f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
				f.title = b.getAttribute('aria-label')?.replace(/^Play: /, '') ?? 'Video';
				f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
				f.allowFullscreen = true;
				f.className = 'yt-iframe';
				b.replaceWith(f);
			},
			{ once: true },
		),
	);
</script>

<style>
	.yt {
		margin: 1.5rem 0;
	}
	.yt-frame {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		padding: 0;
		border: 1px solid var(--sc-line);
		border-radius: 18px;
		overflow: hidden;
		background: #111;
		cursor: pointer;
	}
	.yt-frame img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.5s;
	}
	.yt-frame::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, transparent 45%, rgb(0 0 0 / 0.75));
	}
	.yt-frame:hover img {
		transform: scale(1.03);
	}
	.yt-play {
		position: absolute;
		inset: 50% auto auto 50%;
		translate: -50% -50%;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		border-radius: 999px;
		background: var(--accent);
		color: #0a0a0a;
		box-shadow: 0 8px 32px -6px var(--accent);
	}
	.yt-title {
		position: absolute;
		left: 1rem;
		right: 1rem;
		bottom: 0.85rem;
		z-index: 1;
		text-align: left;
		font-weight: 600;
		font-size: 0.95rem;
		color: #fff;
	}
	:global(.yt-iframe) {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		border: 0;
		border-radius: 18px;
	}
	.yt figcaption {
		margin-top: 0.5rem;
		font-size: 0.78rem;
		color: var(--sc-silver);
	}
	.yt figcaption a {
		color: var(--accent);
		text-decoration: none;
	}
</style>
