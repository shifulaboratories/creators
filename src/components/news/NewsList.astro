---
// A calm, dated list of platform updates, grouped by month. Used on the News
// hub (all platforms) and each platform's news page.
import { getNews, newsPath, fmtDate, fmtMonthYear, isoDate, KIND_LABEL, NEWS_PLATFORM_INFO } from '../../lib/news';

interface Props {
	platform?: string;
	limit?: number;
	exclude?: string;
	showPlatform?: boolean;
}
const { platform, limit, exclude, showPlatform = !platform } = Astro.props;
let items = (await getNews(platform)).filter((n) => newsPath(n) !== exclude);
if (limit) items = items.slice(0, limit);

const groups: { month: string; items: typeof items }[] = [];
for (const n of items) {
	const month = fmtMonthYear(n.data.announced);
	const g = groups.at(-1);
	if (g && g.month === month) g.items.push(n);
	else groups.push({ month, items: [n] });
}
---

{items.length === 0 ? (
	<p class="nl-empty">No updates logged yet. We check official sources every day and post here within a day of a change.</p>
) : (
	<div class="nl not-content">
		{groups.map((g) => (
			<section class="nl-month">
				<h3 class="nl-month__label">{g.month}</h3>
				<ol class="nl-list">
					{g.items.map((n) => (
						<li>
							<a class="nl-item" href={newsPath(n)} data-platform={n.data.platform}>
								<span class="nl-meta">
									{showPlatform && <span class="nl-plat"><span class="nl-dot" />{NEWS_PLATFORM_INFO[n.data.platform].name}</span>}
									<time datetime={isoDate(n.data.announced)}>{fmtDate(n.data.announced)}</time>
									<span class="nl-tag">{KIND_LABEL[n.data.kind]}</span>
									{n.data.impact === 'high' && <span class="nl-tag is-big">Big one</span>}
									{n.data.confirmed === 'reported' && <span class="nl-tag is-reported">Reported</span>}
								</span>
								<span class="nl-title">{n.data.title}</span>
								<span class="nl-sum">{n.data.summary}</span>
							</a>
						</li>
					))}
				</ol>
			</section>
		))}
	</div>
)}

<style>
	.nl {
		display: grid;
		gap: 1.75rem;
		margin-top: 1rem;
	}
	.nl-month__label {
		margin: 0 0 0.6rem;
		font-family: var(--sc-font-sans);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--sc-steel);
	}
	.nl-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.6rem;
	}
	.nl-item {
		display: grid;
		gap: 0.35rem;
		padding: 1rem 1.1rem;
		border-radius: 16px;
		border: 1px solid var(--sc-line);
		background: var(--sc-fill-subtle);
		color: inherit;
		text-decoration: none;
		transition:
			border-color var(--sc-dur-quick),
			background var(--sc-dur-quick);
	}
	.nl-item:hover,
	.nl-item:focus-visible {
		border-color: var(--sc-line-strong);
		background: var(--sc-fill-muted);
	}
	.nl-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem 0.6rem;
		font-size: 0.8rem;
		color: var(--sc-silver);
	}
	.nl-plat {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		color: var(--sc-platinum);
	}
	.nl-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--plat, var(--sc-silver));
	}
	.nl-tag {
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		border: 1px solid var(--sc-line-strong);
		font-size: 0.72rem;
	}
	.nl-tag.is-big {
		border-color: transparent;
		background: var(--sc-lime);
		color: #101010;
		font-weight: 600;
	}
	.nl-tag.is-reported {
		border-color: rgb(201 162 90 / 0.5);
		color: var(--sc-brass);
	}
	.nl-title {
		font-family: var(--sc-font-display);
		font-size: 1.12rem;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--sc-ivory);
	}
	.nl-sum {
		font-size: 0.92rem;
		line-height: 1.5;
		color: var(--sc-silver);
	}
	.nl-empty {
		color: var(--sc-silver);
	}
	[data-platform='instagram'] { --plat: var(--sc-rose); }
	[data-platform='tiktok'] { --plat: var(--sc-cyan); }
	[data-platform='youtube'] { --plat: var(--sc-ember); }
	[data-platform='facebook'] { --plat: #7ea6ff; }
	[data-platform='linkedin'] { --plat: #6fb6e8; }
	[data-platform='x'] { --plat: var(--sc-silver); }
</style>
