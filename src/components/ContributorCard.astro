---

<article class="cc not-content" id={person.id}>
	<div class="cc-top">
		<div class="cc-seal" aria-hidden="true">
			<span>{person.initials}</span>
		</div>
		<div class="cc-id">
			<h2 class="cc-name">{person.name}</h2>
			<p class="cc-role">{person.role}</p>
		</div>
	</div>
	<div class="cc-bio">
		{person.bio.map((p) => <p>{p}</p>)}
	</div>
	{
		person.links.length > 0 && (
			<ul class="cc-links">
				{person.links.map((l) => (
					<li>
						<a href={l.href} rel="me noopener" target="_blank">
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<path fill="currentColor" d={icons[l.kind]} />
							</svg>
							{l.label}
						</a>
					</li>
				))}
			</ul>
		)
	}
</article>

<style>
	.cc {
		position: relative;
		margin-block: 1.5rem 2rem;
		padding: clamp(1.25rem, 4vw, 2rem);
		border: 1px solid var(--sc-line);
		border-radius: var(--sc-radius-card, var(--sc-radius-lg));
		background:
			radial-gradient(110% 70% at 0% 0%, color-mix(in srgb, var(--sc-champagne) 10%, transparent), transparent 60%),
			radial-gradient(90% 60% at 100% 100%, color-mix(in srgb, var(--sc-ion) 8%, transparent), transparent 60%),
			var(--sc-card-metal);
		box-shadow: var(--sc-shadow-card);
		overflow: hidden;
	}
	.cc-top {
		display: flex;
		align-items: center;
		gap: 1rem;
	}
	.cc-seal {
		flex: none;
		width: 4.5rem;
		height: 4.5rem;
		display: grid;
		place-items: center;
		clip-path: var(--sc-seal-clip);
		background: var(--sc-titanium-diagonal);
		animation: cc-turn 30s linear infinite;
	}
	.cc-seal span {
		font-family: var(--sc-font-display);
		font-weight: 700;
		font-size: 1.35rem;
		letter-spacing: -0.02em;
		color: #0a0a0a;
		animation: cc-turn 30s linear infinite reverse;
	}
	@keyframes cc-turn {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.cc-seal,
		.cc-seal span {
			animation: none;
		}
	}
	.cc-name {
		margin: 0;
		padding: 0;
		border: 0;
		font-family: var(--sc-font-display);
		font-size: clamp(1.5rem, 5vw, 2rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--sc-ivory);
	}
	.cc-role {
		margin: 0.3rem 0 0;
		color: var(--sc-champagne);
		font-weight: 600;
		font-size: var(--sc-text-sm);
	}
	.cc-bio {
		margin-top: 1.25rem;
		display: grid;
		gap: 0.75rem;
	}
	.cc-bio p {
		margin: 0;
		color: var(--sc-platinum);
		line-height: 1.6;
	}
	.cc-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 1.4rem 0 0;
		padding: 0;
		list-style: none;
	}
	.cc-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.5rem 0.9rem;
		min-height: 44px;
		border-radius: var(--sc-radius-pill);
		border: 1px solid var(--sc-line-strong);
		background: rgb(255 255 255 / 0.03);
		color: var(--sc-ivory);
		font-size: var(--sc-text-sm);
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color var(--sc-dur-quick) var(--sc-ease-settle),
			transform var(--sc-dur-quick) var(--sc-ease-settle);
	}
	.cc-links a:hover {
		border-color: var(--sc-line-bright);
		transform: translateY(-1px);
	}
	.cc-links a:focus-visible {
		outline: 2px solid var(--sc-ion);
		outline-offset: 2px;
	}
</style>
