---
/**
 * A contributor profile: seal avatar, name, role, bio and links.
 * Data lives in src/data/people.ts.
 */
import { getPerson, type PersonLink } from '../data/people';

interface Props {
	id: string;
}
const person = getPerson(Astro.props.id);
