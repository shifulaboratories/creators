---
/** Analytics doctor: pick what's going wrong, see which number to check and what to try. */
import './grow.css';
import { symptoms } from '../../lib/grow-data';
const first = symptoms[0];
---

<div class="sc-widget md not-content" data-md data-items={JSON.stringify(symptoms)}>
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">Try it · Analytics doctor</div>
			<h4 class="sc-widget__title">What’s going wrong?</h4>
		</div>
	</div>
	<div class="md-grid">
		<div class="md-pick" role="group" aria-label="Symptom">
			{symptoms.map((s, i) => <button type="button" class="md-opt" data-key={s.key} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>)}
		</div>
		<div class="md-card" aria-live="polite">
			<p class="md-step"><span class="gr-pill">1 · Check</span><span data-f="check">{first.check}</span></p>
			<p class="md-step"><span class="gr-pill gr-tint-champagne">2 · What it means</span><span data-f="means">{first.means}</span></p>
			<p class="md-step"><span class="gr-pill gr-tint-ion">3 · Try</span><span data-f="try">{first.try}</span></p>
			<p class="md-foot">
				<span class="gr-src">Source: <a data-f="src" href={first.href}>{first.src}</a></span>
				<a class="md-more" data-f="link" href={first.link?.href ?? '#'} hidden={!first.link}>{first.link ? `${first.link.label} →` : ''}</a>
			</p>
		</div>
	</div>
</div>

<script>
	type S = { key: string; check: string; means: string; try: string; src: string; href: string; link?: { label: string; href: string } };
	document.querySelectorAll<HTMLElement>('[data-md]').forEach((root) => {
		const items = JSON.parse(root.dataset.items!) as S[];
		const f = (k: string) => root.querySelector<HTMLElement>(`[data-f="${k}"]`)!;
		root.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) =>
			b.addEventListener('click', () => {
				const s = items.find((x) => x.key === b.dataset.key)!;
				root.querySelectorAll('[data-key]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				f('check').textContent = s.check;
				f('means').textContent = s.means;
				f('try').textContent = s.try;
				const src = f('src') as HTMLAnchorElement;
				src.textContent = s.src;
				src.href = s.href;
				const link = f('link') as HTMLAnchorElement;
				link.hidden = !s.link;
				if (s.link) (link.textContent = `${s.link.label} →`), (link.href = s.link.href);
				const card = root.querySelector<HTMLElement>('.md-card')!;
				card.animate?.([{ opacity: 0.4, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
			}),
		);
	});
</script>

<style>
	.md-grid { display: grid; gap: 0.9rem; }
	@media (min-width: 48rem) { .md-grid { grid-template-columns: 14rem 1fr; } }
	.md-pick { display: flex; gap: 0.45rem; overflow-x: auto; scrollbar-width: none; margin-inline: -1rem; padding-inline: 1rem; }
	.md-pick::-webkit-scrollbar { display: none; }
	@media (min-width: 48rem) { .md-pick { flex-direction: column; overflow: visible; margin: 0; padding: 0; } }
	.md-opt {
		appearance: none; font: inherit; font-size: 0.85rem; text-align: left; white-space: nowrap; cursor: pointer;
		padding: 0.6rem 0.85rem; border-radius: 14px; border: 1px solid var(--sc-line-strong);
		background: rgb(255 255 255 / 0.02); color: var(--sc-silver);
	}
	@media (min-width: 48rem) { .md-opt { white-space: normal; } }
	.md-opt[aria-pressed='true'] { color: #0a0a0a; background: var(--accent); border-color: var(--accent); font-weight: 600; }
	.md-opt:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
	.md-card { display: grid; gap: 0.8rem; padding: 1rem; border-radius: 18px; border: 1px solid var(--sc-line); background: rgb(0 0 0 / 0.25); }
	.md-step { margin: 0; display: grid; gap: 0.35rem; color: var(--sc-platinum); font-size: 0.92rem; line-height: 1.5; }
	.md-step .gr-pill { justify-self: start; }
	.md-foot { margin: 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; align-items: center; }
	.md-more { font-size: 0.8rem; font-weight: 600; color: var(--accent); }
</style>
