---
/**
 * Retention-curve explainer: pick a shape, see the line redraw, and read what
 * YouTube says it means. Shapes are illustrative; definitions are YouTube's.
 */
import './grow.css';
import { curves } from '../../lib/grow-data';

const W = 320;
const H = 160;
const toPath = (pts: [number, number][]) => {
	// smooth curve through points (Catmull-Rom to Bezier)
	const p = pts.map(([x, y]) => [(x / 100) * W, H - (y / 100) * H]);
	let d = `M${p[0][0].toFixed(1)},${p[0][1].toFixed(1)}`;
	for (let i = 0; i < p.length - 1; i++) {
		const p0 = p[i - 1] ?? p[i];
		const p1 = p[i];
		const p2 = p[i + 1];
		const p3 = p[i + 2] ?? p2;
		const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
		const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
		d += ` C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
	}
	return d;
};
const data = curves.map((c) => ({ ...c, d: toPath(c.points) }));
const first = data[0];
---

<div class="sc-widget rc not-content" data-rc data-curves={JSON.stringify(data.map(({ key, d, means, quote, fix }) => ({ key, d, means, quote, fix })))}>
	<div class="sc-widget__head">
		<div>
			<div class="sc-widget__kicker">Try it · Read the curve</div>
			<h4 class="sc-widget__title">Five shapes your retention graph makes</h4>
		</div>
		<span class="sc-tag is-illustrative">Illustrative curves</span>
	</div>

	<div class="sc-chip-row" role="group" aria-label="Curve shape">
		{data.map((c, i) => <button type="button" class="sc-chip" data-key={c.key} aria-pressed={i === 0 ? 'true' : 'false'}>{c.label}</button>)}
	</div>

	<figure class="rc-chart">
		<svg viewBox={`-28 -10 ${W + 40} ${H + 34}`} role="img" aria-label="Audience retention over the length of a video">
			<defs>
				<linearGradient id="rc-fill" x1="0" x2="0" y1="0" y2="1">
					<stop offset="0" stop-color="var(--accent)" stop-opacity="0.35" />
					<stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
				</linearGradient>
			</defs>
			{[0, 50, 100].map((v) => (
				<g>
					<line x1="0" x2={W} y1={H - (v / 100) * H} y2={H - (v / 100) * H} class="rc-grid" />
					<text x="-6" y={H - (v / 100) * H + 4} class="rc-axis" text-anchor="end">{v}%</text>
				</g>
			))}
			<rect x="0" y="0" width={(30 / 300) * W} height={H} class="rc-intro" />
			<text x="4" y="12" class="rc-axis">first 30s</text>
			<path class="rc-area" d={`${first.d} L${W},${H} L0,${H} Z`} fill="url(#rc-fill)" />
			<path class="rc-line" d={first.d} />
			<text x="0" y={H + 18} class="rc-axis">Start</text>
			<text x={W} y={H + 18} class="rc-axis" text-anchor="end">End of video</text>
		</svg>
	</figure>

	<div class="rc-read" aria-live="polite">
		<p class="rc-means">{first.means}</p>
		<p class="rc-quote">{first.quote}</p>
		<p class="rc-fix"><b>Try:</b> <span>{first.fix}</span></p>
	</div>
	<p class="gr-src">Definitions: <a href="https://support.google.com/youtube/answer/9314415">YouTube Help, “Measure key moments for audience retention”</a>. YouTube shows key moments on videos over 60 seconds with at least 100 views.</p>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-rc]').forEach((root) => {
		const curves = JSON.parse(root.dataset.curves!) as { key: string; d: string; means: string; quote: string; fix: string }[];
		const line = root.querySelector<SVGPathElement>('.rc-line')!;
		const area = root.querySelector<SVGPathElement>('.rc-area')!;
		const means = root.querySelector('.rc-means')!;
		const quote = root.querySelector('.rc-quote')!;
		const fix = root.querySelector('.rc-fix span')!;
		const draw = () => {
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			const len = line.getTotalLength();
			line.style.transition = 'none';
			line.style.strokeDasharray = `${len}`;
			line.style.strokeDashoffset = `${len}`;
			line.getBoundingClientRect();
			line.style.transition = 'stroke-dashoffset 0.9s cubic-bezier(0.2, 0.8, 0.2, 1)';
			line.style.strokeDashoffset = '0';
		};
		root.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) =>
			b.addEventListener('click', () => {
				const c = curves.find((x) => x.key === b.dataset.key)!;
				root.querySelectorAll('[data-key]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
				line.setAttribute('d', c.d);
				area.setAttribute('d', `${c.d} L320,160 L0,160 Z`);
				means.textContent = c.means;
				quote.textContent = c.quote;
				fix.textContent = c.fix;
				draw();
			}),
		);
		const io = new IntersectionObserver((es) => {
			if (es[0].isIntersecting) (draw(), io.disconnect());
		});
		io.observe(root);
	});
</script>

<style>
	.rc-chart { margin: 1rem 0 0.5rem; }
	.rc-chart svg { width: 100%; height: auto; display: block; overflow: visible; }
	.rc-grid { stroke: rgb(255 255 255 / 0.08); stroke-width: 1; }
	.rc-axis { fill: var(--sc-steel); font-size: 10px; font-family: var(--sc-font-sans); }
	.rc-intro { fill: color-mix(in srgb, var(--sc-champagne) 12%, transparent); }
	.rc-line { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linecap: round; filter: drop-shadow(0 0 8px color-mix(in srgb, var(--accent) 60%, transparent)); }
	.rc-area { transition: d 0.5s; }
	.rc-read { display: grid; gap: 0.4rem; margin-top: 0.5rem; }
	.rc-read p { margin: 0; }
	.rc-means { color: var(--sc-ivory); font-size: 0.98rem; line-height: 1.5; }
	.rc-quote { color: var(--sc-silver); font-size: 0.85rem; line-height: 1.5; border-left: 2px solid var(--accent); padding-left: 0.7rem; }
	.rc-fix { color: var(--sc-platinum); font-size: 0.9rem; line-height: 1.5; }
	.rc-fix b { color: var(--accent); }
	.gr-src { margin: 0.9rem 0 0; }
</style>
